# darshini test suite — M1 + M2 + M3 + M4 + M5 + M6.
# Stdlib auto-included via cyrius.cyml.
#
# M1 coverage (carried forward from v0.2.0):
#   * lower_byte, str_lt_ci, sort_entries
#   * classify_path, check_dir_readable
#
# M2 coverage (new at v0.3.0):
#   * format_perms — every file-type char, all rwx triples,
#     setuid/setgid/sticky upper+lower variants
#   * format_size_decimal — 0, single-digit, multi-digit
#   * format_size_human — bucket boundaries (1023/1024,
#     1MB-1/1MB, etc.) + sub-1K decimal pass-through
#   * format_mtime — known epoch values → known UTC strings
#
# M3 coverage (new at v0.4.0):
#   * pick_cols — synthetic vecs sized 1, 5, 100, 1000 against
#     several term widths; degenerate widths (0, too-narrow);
#     uniform vs jagged name lengths
#   * _columns_total_width — exact byte width for known layouts
#
# M4 coverage (new at v0.5.0):
#   * color_for_mode — every file type → its ADR-0001 SGR code
#
# M5 coverage (new at v0.6.0):
#   * icon_for_entry — each lookup-precedence rule
#     (filename / prefix / type / extension / fallback)
#   * pick_cols with icon_width > 0 — uniform shift in effective
#     per-cell width
#
# M6 coverage (new at v0.7.0):
#   * _tree_prefix_buf — depth-stack patterns to expected bytes
#   * _tree_connector_buf — is_last 0/1 to expected bytes
#   * _parse_pos_int — argv value parsing for --level
#
# M7 coverage (new at v0.8.0):
#   * _be_u32 / _be_u16 — big-endian decode
#   * _git_parse_index — header validation + entry walk
#   * _git_match_one — exact / *suffix / dir-only patterns
#   * _git_listing_rel — repo-root vs listing-dir prefix strip
#
# M8 coverage (new at v0.9.0):
#   * _mime_for_inode — file type → inode/* mime
#   * _mime_for_filename — exact match (not prefix) per ADR 0003
#   * _mime_for_ext — extension lookup
#   * _mime_for_magic_bytes — synthetic buffers, each magic signature
#   * mime_for_entry — full precedence chain, fallthrough
#
# v1.4.0 coverage:
#   * _sanitize_into — darshana's TTY_SANITIZE_UTF8 rule through
#     darshini's wrapper (C0 / DEL / encoded + raw C1 / malformed
#     UTF-8 neutralized; well-formed UTF-8 untouched)
#   * _name_display_len, _display_widths, _columns_total_width_w,
#     _pick_cols_w — the layout measures what is actually written
#   * term_width <-> tty_isatty pipe-awareness contract

include "src/walk.cyr"
include "src/cli.cyr"
include "src/width_table.cyr"
include "src/width.cyr"
include "src/icons.cyr"
include "src/mime.cyr"
include "src/ignore.cyr"
include "src/gitcfg.cyr"
include "src/git.cyr"
include "src/tz.cyr"
include "src/color.cyr"
include "src/render.cyr"
include "src/columns.cyr"
include "src/long.cyr"
include "src/tree.cyr"
# v1.4.1: the argv helpers live in src/cli.cyr, included above. Through
# v1.4.0 this file carried a COPY of _parse_pos_int (main.cyr can't be
# included: it ends in a top-level main() call), so the real parser's
# missing overflow check went untested.

# Big-endian writers + a zeroed buffer, for hand-built .git/index images.
fn put_be32(buf, off, v): i64 {
    store8(buf + off + 0, (v >> 24) & 255);
    store8(buf + off + 1, (v >> 16) & 255);
    store8(buf + off + 2, (v >> 8) & 255);
    store8(buf + off + 3, v & 255);
    return 0;
}

fn put_be16(buf, off, v): i64 {
    store8(buf + off + 0, (v >> 8) & 255);
    store8(buf + off + 1, v & 255);
    return 0;
}

fn zbuf(n): i64 {
    var b = alloc(n);
    memset(b, 0, n);
    return b;
}

# "DIRC" + version + entry count. Returns the header length (12).
fn idx_header(buf, version, count): i64 {
    store8(buf + 0, 68); store8(buf + 1, 73); store8(buf + 2, 82); store8(buf + 3, 67);
    put_be32(buf, 4, version);
    put_be32(buf, 8, count);
    return 12;
}

# A v2/v3 entry at `pos` (buffer pre-zeroed): stat data with only mtime
# and size set, a zero oid of `oid_len` bytes, flags (+ the v3 extended
# word when `ext` is 1), the name, NUL padding to a multiple of 8.
# Returns the position after it.
fn idx_entry(buf, pos, oid_len, mtime, size, name, ext): i64 {
    put_be32(buf, pos + 8, mtime);
    put_be32(buf, pos + 36, size);
    var nlen = strlen(name);
    var flen = nlen;
    if (flen > 0xFFF) { flen = 0xFFF; }
    var flags = flen;
    var hdr = 42 + oid_len;
    if (ext == 1) { flags = flags | 0x4000; hdr = hdr + 2; }
    put_be16(buf, pos + 40 + oid_len, flags);
    memcpy(buf + pos + hdr, name, nlen);
    var total = hdr + nlen + 1;
    var rem = total % 8;
    if (rem != 0) { total = total + (8 - rem); }
    return pos + total;
}

# A v4 entry: stat data + oid + flags, then a one-byte varint `strip`
# and the NUL-terminated `suffix` (no padding).
fn idx_entry_v4(buf, pos, mtime, size, strip, suffix, full_len): i64 {
    put_be32(buf, pos + 8, mtime);
    put_be32(buf, pos + 36, size);
    put_be16(buf, pos + 60, full_len);
    store8(buf + pos + 62, strip);
    var sl = strlen(suffix);
    memcpy(buf + pos + 63, suffix, sl);
    store8(buf + pos + 63 + sl, 0);
    return pos + 63 + sl + 1;
}

# A GitCtx as git_open builds one (tracked map + shared dir cell), over
# the given parallel vecs, ignore patterns and listing prefix.
# v1.5.0: the 80-byte GitCtx, with `root_ignore` (gitignore text, or 0)
# installed as the worktree root's .gitignore and no worktree on disk.
fn mk_ctx(paths, mtimes, sizes, root_ignore, listing): i64 {
    var m = map_new_str();
    var i = 0;
    while (i < vec_len(paths)) {
        map_set(m, vec_get(paths, i), i + 1);
        i = i + 1;
    }
    var cell = alloc(8);
    store64(cell, 0);
    var c = alloc(80);
    store64(c + 0, paths);
    store64(c + 8, mtimes);
    store64(c + 16, sizes);
    store64(c + 24, vec_new());
    store64(c + 32, make_str(listing));
    store64(c + 40, m);
    store64(c + 48, cell);
    store64(c + 56, 0);
    store64(c + 64, _git_ign_cell_new());
    store64(c + 72, 0);
    if (root_ignore != 0) { ctx_dir_ignore(c, "", root_ignore); }
    return c;
}

# Install `text` as directory `dir`'s .gitignore in a test context.
fn ctx_dir_ignore(c, dir, text): i64 {
    var dl = strlen(dir);
    var l = _ig_list_new(dir, dl);
    _ig_parse(text, strlen(text), load64(l));
    map_set(load64(load64(c + 64) + 8), str_from_buf(dir, dl), l);
    return 0;
}

# Install `text` as a base list (info/exclude-like) in a test context.
fn ctx_base_ignore(c, text): i64 {
    var l = _ig_list_new("", 0);
    _ig_parse(text, strlen(text), load64(l));
    vec_push(load64(c + 24), l);
    return 0;
}

# The verdict of one pattern line for path `rel` (is_dir flag): the list
# result 1 / 2 / 0 from a list holding just that line, based at `base`.
fn ig1(line, rel, is_dir, base): i64 {
    var l = _ig_list_new(base, strlen(base));
    _ig_parse(line, strlen(line), load64(l));
    var rl = strlen(rel);
    var boff = _git_last_slash(rel, rl) + 1;
    return _ig_list_match(l, rel, rl, boff, is_dir);
}


# v1.4.2: an independent reference for sort_entries — a plain insertion
# sort over str_lt_ci — and a small LCG to feed it names.
var _t_lcg = 12345;
fn t_rand(n): i64 {
    _t_lcg = (_t_lcg * 1103515245 + 12345) & 0x7FFFFFFF;
    return (_t_lcg >> 8) % n;
}

fn ref_sort(v): i64 {
    var n = vec_len(v);
    var i = 1;
    while (i < n) {
        var cur = vec_get(v, i);
        var j = i;
        var moving = 1;
        while (moving == 1) {
            if (j == 0) { moving = 0; }
            else {
                if (str_lt_ci(cur, vec_get(v, j - 1)) == 1) {
                    vec_set(v, j, vec_get(v, j - 1));
                    j = j - 1;
                } else { moving = 0; }
            }
        }
        vec_set(v, j, cur);
        i = i + 1;
    }
    return 0;
}

fn make_str(c): i64 {
    return str_clone(str_from(c));
}

fn vec_of3(a, b, c): i64 {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    return v;
}

# Compare exactly N bytes of buf against the cstr `expected`.
# Returns 1 on match, 0 otherwise. memeq from lib/string.cyr.
fn buf_eq_cstr(buf, n, expected): i64 {
    if (n != strlen(expected)) { return 0; }
    return memeq(buf, expected, n);
}

fn main(): i64 {
    alloc_init();

    test_group("lower_byte");
    assert_eq(lower_byte(65), 97, "A -> a");
    assert_eq(lower_byte(90), 122, "Z -> z");
    assert_eq(lower_byte(97), 97, "a -> a");
    assert_eq(lower_byte(48), 48, "0 unchanged");
    assert_eq(lower_byte(64), 64, "@ unchanged (just below A)");
    assert_eq(lower_byte(91), 91, "[ unchanged (just above Z)");

    test_group("str_lt_ci");
    var a = make_str("apple");
    var b = make_str("banana");
    var a_upper = make_str("APPLE");
    var apricot = make_str("apricot");
    var app = make_str("app");
    assert_eq(str_lt_ci(a, b), 1, "apple < banana");
    assert_eq(str_lt_ci(b, a), 0, "banana not < apple");
    assert_eq(str_lt_ci(a, a), 0, "apple not < apple");
    # v1.4.1: equal under case folding -> raw bytes decide, uppercase first.
    assert_eq(str_lt_ci(a, a_upper), 0, "apple not < APPLE (raw tiebreak)");
    assert_eq(str_lt_ci(a_upper, a), 1, "APPLE < apple (raw tiebreak)");
    assert_eq(str_lt_ci(make_str("Readme"), make_str("readme")), 1, "Readme < readme");
    assert_eq(str_lt_ci(make_str("README"), make_str("Readme")), 1, "README < Readme");
    assert_eq(str_lt_ci(a, apricot), 1, "apple < apricot");
    assert_eq(str_lt_ci(app, a), 1, "app < apple (prefix shorter)");
    assert_eq(str_lt_ci(a, app), 0, "apple not < app (prefix shorter)");

    test_group("sort_entries");
    var sorted_in = vec_of3(make_str("alpha"), make_str("beta"), make_str("gamma"));
    sort_entries(sorted_in);
    assert_eq(str_eq(vec_get(sorted_in, 0), make_str("alpha")), 1, "sorted[0] = alpha");
    assert_eq(str_eq(vec_get(sorted_in, 1), make_str("beta")), 1, "sorted[1] = beta");
    assert_eq(str_eq(vec_get(sorted_in, 2), make_str("gamma")), 1, "sorted[2] = gamma");

    var rev = vec_of3(make_str("gamma"), make_str("beta"), make_str("alpha"));
    sort_entries(rev);
    assert_eq(str_eq(vec_get(rev, 0), make_str("alpha")), 1, "reverse->[0] = alpha");
    assert_eq(str_eq(vec_get(rev, 1), make_str("beta")), 1, "reverse->[1] = beta");
    assert_eq(str_eq(vec_get(rev, 2), make_str("gamma")), 1, "reverse->[2] = gamma");

    var mixed = vec_of3(make_str("Charlie"), make_str("alpha"), make_str("Beta"));
    sort_entries(mixed);
    assert_eq(str_eq(vec_get(mixed, 0), make_str("alpha")), 1, "mixed->[0] = alpha");
    assert_eq(str_eq(vec_get(mixed, 1), make_str("Beta")), 1, "mixed->[1] = Beta (preserved case)");
    assert_eq(str_eq(vec_get(mixed, 2), make_str("Charlie")), 1, "mixed->[2] = Charlie");

    var empty = vec_new();
    sort_entries(empty);
    assert_eq(vec_len(empty), 0, "empty vec stays empty");

    var single = vec_new();
    vec_push(single, make_str("only"));
    sort_entries(single);
    assert_eq(str_eq(vec_get(single, 0), make_str("only")), 1, "single-element vec");

    # v1.4.1: case-only collisions sort the same whatever order getdents
    # returned them in (they were stable-sorted as equal through v1.4.0).
    var perm1 = vec_of3(make_str("README"), make_str("readme"), make_str("Readme"));
    var perm2 = vec_of3(make_str("readme"), make_str("Readme"), make_str("README"));
    sort_entries(perm1);
    sort_entries(perm2);
    var same_order = 1;
    var po = 0;
    while (po < 3) {
        if (str_eq(vec_get(perm1, po), vec_get(perm2, po)) == 0) { same_order = 0; }
        po = po + 1;
    }
    assert_eq(same_order, 1, "case-only collisions: order independent of input");
    assert_eq(str_eq(vec_get(perm1, 0), make_str("README")), 1, "collision order: README first");
    assert_eq(str_eq(vec_get(perm1, 2), make_str("readme")), 1, "collision order: readme last");

    # Above the 16-entry insertion cutoff (added at v1.4.1 for the merge
    # sort; still the stdlib introsort's cutoff since v1.4.2): 40 names in
    # reverse order exercise the partitioning path.
    var big = vec_new();
    var mg_i = 39;
    while (mg_i >= 0) {
        var mg_nb = alloc(4);
        store8(mg_nb, 101);                        # 'e'
        store8(mg_nb + 1, 48 + mg_i / 10);
        store8(mg_nb + 2, 48 + mg_i % 10);
        store8(mg_nb + 3, 0);
        vec_push(big, str_from(mg_nb));
        mg_i = mg_i - 1;
    }
    sort_entries(big);
    var big_ok = 1;
    var mg_k = 1;
    while (mg_k < 40) {
        if (str_lt_ci(vec_get(big, mg_k - 1), vec_get(big, mg_k)) == 0) { big_ok = 0; }
        mg_k = mg_k + 1;
    }
    # v1.4.2: sort_entries is the stdlib introsort; check it against the
    # insertion-sort reference on random name sets — 1..6 bytes from a
    # tiny alphabet with both cases, so case-only collisions, shared
    # prefixes and prefix-of-another names are common. Names are unique
    # within a set, as in a directory.
    var rnd_ok = 1;
    var rnd_round = 0;
    var alpha = "aAbB_.0";
    while (rnd_round < 30) {
        var want_n = 1 + t_rand(300);
        var names = map_new_str();
        var rv = vec_new();
        var tries = 0;
        while (vec_len(rv) < want_n) {
            if (tries > want_n * 20) { want_n = vec_len(rv); }
            else {
                var rn_len = 1 + t_rand(6);
                var rn_buf = alloc(rn_len + 1);
                var q = 0;
                while (q < rn_len) { store8(rn_buf + q, load8(alpha + t_rand(7))); q = q + 1; }
                store8(rn_buf + rn_len, 0);
                var ns = str_from(rn_buf);
                if (map_has(names, ns) == 0) { map_set(names, ns, 1); vec_push(rv, ns); }
            }
            tries = tries + 1;
        }
        var rcopy = vec_new();
        var rq = 0;
        while (rq < vec_len(rv)) { vec_push(rcopy, vec_get(rv, rq)); rq = rq + 1; }
        sort_entries(rv);
        ref_sort(rcopy);
        rq = 0;
        while (rq < vec_len(rv)) {
            if (str_eq(vec_get(rv, rq), vec_get(rcopy, rq)) == 0) { rnd_ok = 0; }
            rq = rq + 1;
        }
        rnd_round = rnd_round + 1;
    }
    assert_eq(rnd_ok, 1, "stdlib sort == insertion-sort reference on 30 random sets");
    assert_eq(vec_len(big), 40, "merge path: 40 entries kept");
    assert_eq(big_ok, 1, "merge path: 40 reversed entries come out ascending");
    assert_eq(str_eq(vec_get(big, 0), make_str("e00")), 1, "merge path: first = e00");
    assert_eq(str_eq(vec_get(big, 39), make_str("e39")), 1, "merge path: last = e39");

    test_group("classify_path");
    assert_eq(classify_path("README.md"), 0, "README.md is non-dir");
    assert_eq(classify_path("src"), 1, "src/ is dir");
    # agnos reports a flat -1, not -errno (docs/architecture/002); assert
    # each target's real contract so the suite is green on all three.
    #ifdef CYRIUS_TARGET_AGNOS
    assert_eq(classify_path("./absolutely-nope-no-such-path-xyzzy"), 0 - 1, "missing path -> -1 (agnos)");
    #else
    assert_eq(classify_path("./absolutely-nope-no-such-path-xyzzy"), 0 - ENOENT, "missing path -> -ENOENT");
    #endif

    test_group("check_dir_readable");
    assert_eq(check_dir_readable("src"), 0, "src/ readable -> 0");
    #ifdef CYRIUS_TARGET_AGNOS
    assert_eq(check_dir_readable("./absolutely-nope-no-such-path-xyzzy"), 0 - 1, "missing -> -1 (agnos)");
    #else
    assert_eq(check_dir_readable("./absolutely-nope-no-such-path-xyzzy"), 0 - ENOENT, "missing -> -ENOENT");
    #endif

    # ============================================================
    # M2 — long-format column formatters
    # ============================================================

    test_group("format_perms");
    var pb = alloc(10);
    # Regular file, rw-r--r-- (0o100644 = 0x81A4)
    format_perms(0x81A4, pb);
    assert_eq(buf_eq_cstr(pb, 10, "-rw-r--r--"), 1, "regular 0644 -> -rw-r--r--");
    # Directory, rwxr-xr-x (0o040755 = 0x41ED)
    format_perms(0x41ED, pb);
    assert_eq(buf_eq_cstr(pb, 10, "drwxr-xr-x"), 1, "dir 0755 -> drwxr-xr-x");
    # Symlink, lrwxrwxrwx (0o120777 = 0xA1FF) — symlinks always 0777 on linux
    format_perms(0xA1FF, pb);
    assert_eq(buf_eq_cstr(pb, 10, "lrwxrwxrwx"), 1, "symlink -> lrwxrwxrwx");
    # FIFO, prw-r--r-- (0o010644 = 0x11A4)
    format_perms(0x11A4, pb);
    assert_eq(buf_eq_cstr(pb, 10, "prw-r--r--"), 1, "fifo");
    # Socket
    format_perms(0xC1A4, pb);
    assert_eq(buf_eq_cstr(pb, 10, "srw-r--r--"), 1, "socket");
    # Block dev
    format_perms(0x61A4, pb);
    assert_eq(buf_eq_cstr(pb, 10, "brw-r--r--"), 1, "block dev");
    # Char dev
    format_perms(0x21A4, pb);
    assert_eq(buf_eq_cstr(pb, 10, "crw-r--r--"), 1, "char dev");
    # All-empty perms (rare but valid)
    format_perms(0x8000, pb);
    assert_eq(buf_eq_cstr(pb, 10, "----------"), 1, "regular 0000");
    # All bits set + executable (0o100755 = 0x81ED)
    format_perms(0x81ED, pb);
    assert_eq(buf_eq_cstr(pb, 10, "-rwxr-xr-x"), 1, "regular 0755");
    # setuid + x  (0o104755 = 0x89ED) -> rws (lowercase)
    format_perms(0x89ED, pb);
    assert_eq(buf_eq_cstr(pb, 10, "-rwsr-xr-x"), 1, "setuid + x -> s");
    # setuid no x (0o104644 = 0x89A4) -> rwS (uppercase)
    format_perms(0x89A4, pb);
    assert_eq(buf_eq_cstr(pb, 10, "-rwSr--r--"), 1, "setuid no x -> S");
    # setgid + x (0o102755 = 0x85ED) -> rws on group
    format_perms(0x85ED, pb);
    assert_eq(buf_eq_cstr(pb, 10, "-rwxr-sr-x"), 1, "setgid + x -> s");
    # sticky + x on other (0o041777 = 0x43FF) -> rwt (e.g. /tmp)
    format_perms(0x43FF, pb);
    assert_eq(buf_eq_cstr(pb, 10, "drwxrwxrwt"), 1, "sticky + x -> t (/tmp shape)");
    # sticky no x on other (0o041776 = 0x43FE) -> rwT
    format_perms(0x43FE, pb);
    assert_eq(buf_eq_cstr(pb, 10, "drwxrwxrwT"), 1, "sticky no x -> T");

    test_group("format_size_decimal");
    var sb = alloc(32);
    assert_eq(format_size_decimal(0, sb), 1, "0 -> 1 byte");
    assert_eq(buf_eq_cstr(sb, 1, "0"), 1, "0 -> '0'");
    assert_eq(format_size_decimal(7, sb), 1, "7 -> 1 byte");
    assert_eq(buf_eq_cstr(sb, 1, "7"), 1, "7 -> '7'");
    assert_eq(format_size_decimal(42, sb), 2, "42 -> 2 bytes");
    assert_eq(buf_eq_cstr(sb, 2, "42"), 1, "42 -> '42'");
    assert_eq(format_size_decimal(1024, sb), 4, "1024 -> 4 bytes");
    assert_eq(buf_eq_cstr(sb, 4, "1024"), 1, "1024 -> '1024'");
    assert_eq(format_size_decimal(12345678, sb), 8, "12345678 -> 8 bytes");
    assert_eq(buf_eq_cstr(sb, 8, "12345678"), 1, "12345678 -> '12345678'");

    test_group("format_size_human");
    # < 1024 → decimal pass-through
    assert_eq(format_size_human(0, sb), 1, "0 human -> 1 byte");
    assert_eq(buf_eq_cstr(sb, 1, "0"), 1, "0 -> '0'");
    assert_eq(format_size_human(1023, sb), 4, "1023 -> 4 bytes");
    assert_eq(buf_eq_cstr(sb, 4, "1023"), 1, "1023 -> '1023'");
    # 1024 → 1.0K
    assert_eq(format_size_human(1024, sb), 4, "1024 -> 4 bytes");
    assert_eq(buf_eq_cstr(sb, 4, "1.0K"), 1, "1024 -> '1.0K'");
    # 1843 → 1.7K (1843/1024 ≈ 1.8 — int truncation gives 1.7)
    assert_eq(format_size_human(1843, sb), 4, "1843 -> '1.7K' shape");
    assert_eq(buf_eq_cstr(sb, 4, "1.7K"), 1, "1843 -> '1.7K'");
    # 1048575 (1MB-1) → 1023.9K (7 chars: 4 digits + . + 1 digit + K)
    assert_eq(format_size_human(1048575, sb), 7, "1MB-1 -> 7 bytes");
    assert_eq(buf_eq_cstr(sb, 7, "1023.9K"), 1, "1MB-1 -> '1023.9K'");
    # 1048576 → 1.0M
    assert_eq(format_size_human(1048576, sb), 4, "1MB -> 4 bytes");
    assert_eq(buf_eq_cstr(sb, 4, "1.0M"), 1, "1MB -> '1.0M'");
    # 1073741824 → 1.0G
    assert_eq(format_size_human(1073741824, sb), 4, "1GB -> 4 bytes");
    assert_eq(buf_eq_cstr(sb, 4, "1.0G"), 1, "1GB -> '1.0G'");
    # 1099511627776 → 1.0T
    assert_eq(format_size_human(1099511627776, sb), 4, "1TB -> 4 bytes");
    assert_eq(buf_eq_cstr(sb, 4, "1.0T"), 1, "1TB -> '1.0T'");
    # v1.4.1: P and E (a 1 PiB file read '1024.0T'), and no overflow in
    # the tenths digit (922337203685477581 rendered '838860.)T').
    assert_eq(format_size_human(1125899906842624, sb), 4, "1PB -> 4 bytes");
    assert_eq(buf_eq_cstr(sb, 4, "1.0P"), 1, "1PB -> '1.0P'");
    assert_eq(format_size_human(1152921504606846976, sb), 4, "1EB -> 4 bytes");
    assert_eq(buf_eq_cstr(sb, 4, "1.0E"), 1, "1EB -> '1.0E'");
    assert_eq(format_size_human(922337203685477581, sb), 6, "~0.8 EiB -> 6 bytes");
    assert_eq(buf_eq_cstr(sb, 6, "819.2P"), 1, "922337203685477581 -> '819.2P' (was '838860.)T')");
    assert_eq(format_size_human(9223372036854775807, sb), 4, "i64 max -> 4 bytes");
    assert_eq(buf_eq_cstr(sb, 4, "7.9E"), 1, "i64 max -> '7.9E'");
    assert_eq(format_size_human(1099511627775, sb), 7, "1TB-1 -> 7 bytes");
    assert_eq(buf_eq_cstr(sb, 7, "1023.9G"), 1, "1TB-1 -> '1023.9G' (truncates)");

    test_group("format_mtime");
    var mb = alloc(16);
    # Epoch 0 — Unix birth
    format_mtime(0, mb);
    assert_eq(buf_eq_cstr(mb, 16, "1970-01-01 00:00"), 1, "epoch 0 -> 1970-01-01 00:00");
    # Epoch 1234567890 — '09 02 13 23:31:30 UTC (drop seconds)
    format_mtime(1234567890, mb);
    assert_eq(buf_eq_cstr(mb, 16, "2009-02-13 23:31"), 1, "1234567890 -> 2009-02-13 23:31");
    # Epoch 1700000000 — 2023-11-14 22:13:20 UTC
    format_mtime(1700000000, mb);
    assert_eq(buf_eq_cstr(mb, 16, "2023-11-14 22:13"), 1, "1700000000 -> 2023-11-14 22:13");
    # Leap-year boundary: 2000-02-29 00:00:00 UTC = 951782400
    format_mtime(951782400, mb);
    assert_eq(buf_eq_cstr(mb, 16, "2000-02-29 00:00"), 1, "leap day 2000 -> 2000-02-29 00:00");
    # Pre-1970 epochs. v1.3.2 showed the placeholder for every one
    # (chrono's epoch_to_date emitted bytes below '0' for them, 0xD4 into
    # the terminal); v1.6.0's civil_from_days renders the date, as ls does.
    format_mtime(0 - 1, mb);
    assert_eq(buf_eq_cstr(mb, 16, "1969-12-31 23:59"), 1, "epoch -1 -> 1969-12-31 23:59 (v1.6.0)");
    format_mtime(0 - 3600, mb);
    assert_eq(buf_eq_cstr(mb, 16, "1969-12-31 23:00"), 1, "-3600 -> 1969-12-31 23:00");
    format_mtime(0 - 315619200, mb);
    assert_eq(buf_eq_cstr(mb, 16, "1960-01-01 00:00"), 1, "1960-01-01 renders (was the placeholder)");
    format_mtime(0 - 2208988800, mb);
    assert_eq(buf_eq_cstr(mb, 16, "1900-01-01 00:00"), 1, "1900-01-01 (not a leap year)");
    format_mtime(0 - 62167219200, mb);
    assert_eq(buf_eq_cstr(mb, 16, "0000-01-01 00:00"), 1, "0000-01-01 00:00, the lower bound");
    format_mtime(0 - 62167219201, mb);
    assert_eq(buf_eq_cstr(mb, 16, "????-??-?? ??:??"), 1, "before year 0 -> placeholder");
    format_mtime(0 - 9000000000000000000, mb);
    assert_eq(buf_eq_cstr(mb, 16, "????-??-?? ??:??"), 1, "-9e18 -> placeholder");
    # The boundary itself must still format normally.
    format_mtime(0, mb);
    assert_eq(buf_eq_cstr(mb, 16, "1970-01-01 00:00"), 1, "epoch 0 still formats (boundary)");
    # v1.4.1: past year 9999 _chrono_w4 emitted arbitrary bytes (ESC 7 /
    # ESC 8 at year 235,7xx) and epoch_to_date looped once per year.
    format_mtime(253402300799, mb);
    assert_eq(buf_eq_cstr(mb, 16, "9999-12-31 23:59"), 1, "9999-12-31 23:59:59 still formats");
    format_mtime(253402300800, mb);
    assert_eq(buf_eq_cstr(mb, 16, "????-??-?? ??:??"), 1, "year 10000 -> placeholder (was ':000')");
    format_mtime(7376000000000, mb);
    assert_eq(buf_eq_cstr(mb, 16, "????-??-?? ??:??"), 1, "year ~235,700 -> placeholder (was ESC 7)");
    format_mtime(9000000000000000000, mb);
    assert_eq(buf_eq_cstr(mb, 16, "????-??-?? ??:??"), 1, "9e18 -> placeholder, immediately (was a hang)");

    # ============================================================
    # M3 — multi-column auto-layout
    # ============================================================

    test_group("pick_cols");
    # Degenerate inputs: empty vec / single entry / zero width.
    var empty_v = vec_new();
    assert_eq(pick_cols(empty_v, 80, 0), 1, "empty vec -> 1 col");

    var one_v = vec_new();
    vec_push(one_v, make_str("solo"));
    assert_eq(pick_cols(one_v, 80, 0), 1, "1 entry -> 1 col");
    assert_eq(pick_cols(one_v, 0, 0), 1, "tw=0 -> 1 col");
    assert_eq(pick_cols(one_v, 0 - 5, 0), 1, "tw<0 -> 1 col");

    # Five 5-char entries: "aaaaa".."eeeee". Per col needs 5+2=7 chars
    # (sep). 5 cols => 5*5 + 4*2 = 33 chars. Fits in 40 → 5 cols.
    var five = vec_new();
    vec_push(five, make_str("aaaaa"));
    vec_push(five, make_str("bbbbb"));
    vec_push(five, make_str("ccccc"));
    vec_push(five, make_str("ddddd"));
    vec_push(five, make_str("eeeee"));
    assert_eq(pick_cols(five, 40, 0), 5, "5x5 uniform fits 5 cols at tw=40");
    # 33 is the minimum for 5 cols; at 32, 5 cols don't fit and
    # 4 cols would be a phantom layout (5 entries × 2 rows = only
    # 3 effective cols). Falls back to 3.
    assert_eq(pick_cols(five, 32, 0), 3, "5x5 at tw=32 -> 3 cols (4-col phantom rejected)");
    # tw=10 — only one 5-char col fits at a time (5 chars; 2-col
    # would need 5+2+5=12 > 10).
    assert_eq(pick_cols(five, 10, 0), 1, "5x5 at tw=10 -> 1 col");
    # tw=12 — 2 cols just fit (5+2+5=12).
    assert_eq(pick_cols(five, 12, 0), 2, "5x5 at tw=12 -> 2 cols");

    # Jagged widths: one really long entry forces narrow layouts
    # even when the others are short.
    var jag = vec_new();
    vec_push(jag, make_str("a"));
    vec_push(jag, make_str("b"));
    vec_push(jag, make_str("this-is-a-very-long-entry-name"));   # 30
    vec_push(jag, make_str("c"));
    vec_push(jag, make_str("d"));
    # tw=40 — 3 cols, 2 rows: col0=[a,b]max=1, col1=[long,c]max=30,
    # col2=[d]max=1. Total = 1+2+30+2+1 = 36 ≤ 40 → 3 cols.
    # 4-col attempt is rejected (phantom — 5 entries / 2 rows = 3 eff).
    assert_eq(pick_cols(jag, 40, 0), 3, "jagged at tw=40 -> 3 cols");
    # tw=30 — even 1 col with 30-char widest needs 30 chars; fits 1 col.
    assert_eq(pick_cols(jag, 30, 0), 1, "jagged at tw=30 -> 1 col (widest entry alone)");

    test_group("_columns_total_width");
    # five at 5 cols, 1 row: total = 5*5 + 4*2 = 33
    assert_eq(_columns_total_width(five, 5, 5, 1, 0), 33, "five@5x1 -> 33");
    # five at 3 cols, 2 rows: col0={a,b}max=5, col1={c,d}max=5, col2={e}max=5.
    # total = 5+2+5+2+5 = 19
    assert_eq(_columns_total_width(five, 5, 3, 2, 0), 19, "five@3x2 -> 19");
    # five at 1 col, 5 rows: total = 5 (no separator on single col)
    assert_eq(_columns_total_width(five, 5, 1, 5, 0), 5, "five@1x5 -> 5");

    # 1k synthetic vec of 8-char names ("name0000", "name0001", ...).
    # Hand-computed for tw=80: 1 col=8, 2=18, 3=28, ..., 8=78, 9=88.
    # → 8 cols fits, 9 doesn't.
    var kilo = vec_new();
    var ki = 0;
    while (ki < 1000) {
        var nb = alloc(9);
        store8(nb, 110); store8(nb + 1, 97); store8(nb + 2, 109);   # 'nam'
        store8(nb + 3, 101);                                          # 'e'
        store8(nb + 4, 48 + ki / 1000);                               # always '0' here
        store8(nb + 5, 48 + (ki / 100) % 10);
        store8(nb + 6, 48 + (ki / 10) % 10);
        store8(nb + 7, 48 + ki % 10);
        store8(nb + 8, 0);
        vec_push(kilo, str_clone(str_from(nb)));
        ki = ki + 1;
    }
    assert_eq(pick_cols(kilo, 80, 0), 8, "1k uniform 8-char at tw=80 -> 8 cols");
    assert_eq(pick_cols(kilo, 88, 0), 9, "1k uniform 8-char at tw=88 -> 9 cols");
    assert_eq(pick_cols(kilo, 200, 0), 20, "1k uniform 8-char at tw=200 -> 20 cols");
    assert_eq(pick_cols(kilo, 7, 0), 1, "1k uniform 8-char at tw=7 -> 1 col (name itself > tw)");

    # 100-entry vec, also uniform 8-char. Same fit math holds —
    # the # of entries shouldn't change col count for uniform widths.
    var hundred = vec_new();
    var hi = 0;
    while (hi < 100) {
        var nb2 = alloc(9);
        store8(nb2, 110); store8(nb2 + 1, 97); store8(nb2 + 2, 109);
        store8(nb2 + 3, 101);
        store8(nb2 + 4, 48 + hi / 1000);
        store8(nb2 + 5, 48 + (hi / 100) % 10);
        store8(nb2 + 6, 48 + (hi / 10) % 10);
        store8(nb2 + 7, 48 + hi % 10);
        store8(nb2 + 8, 0);
        vec_push(hundred, str_clone(str_from(nb2)));
        hi = hi + 1;
    }
    assert_eq(pick_cols(hundred, 80, 0), 8, "100 uniform 8-char at tw=80 -> 8 cols");
    assert_eq(pick_cols(hundred, 40, 0), 4, "100 uniform 8-char at tw=40 -> 4 cols");

    # ============================================================
    # M4 — color picker (mode bits -> ADR-0001 SGR code)
    # ============================================================

    # ============================================================
    # v1.3.2 — control-character sanitization (P(-1) security sweep)
    # ============================================================

    test_group("path arguments as one listing (v1.6.0)");
    var av = vec_new();
    vec_push(av, str_from("README.md"));
    vec_push(av, str_from("src"));
    vec_push(av, str_from("src/main.cyr"));
    vec_push(av, str_from("no/such/path"));
    var ad = compute_decor_args(av, 1, 1, 0, 1, 1);
    assert_eq(vec_get(load64(ad), 1), TTY_FG_BLUE, "a directory argument is blue");
    assert_eq(vec_get(load64(ad), 0), 0, "a plain file argument is uncolored");
    assert_eq(streq(vec_get(load64(ad + 8), 0), icon_for_entry(str_from("README.md"), 0x81A4)), 1,
      "icons come from the basename (README glyph)");
    assert_eq(streq(vec_get(load64(ad + 24), 2), "application/x-cyrius"), 1,
      "mime from src/main.cyr's basename");
    assert_eq(vec_get(load64(ad + 32), 1), 47, "-F: '/' for the directory");
    assert_eq(vec_get(load64(ad + 40), 3), 0, "an unstat-able argument has no stat buffer");
    assert_eq(load64(ad + 16), 0, "no --git: no git column");

    test_group("civil dates (v1.6.0)");
    # Hinnant's algorithms replace chrono's epoch_to_date (whose private
    # DateTime layout v1.3.3 pinned — nothing reads it any more).
    var ymd = alloc(24);
    civil_from_days(0, ymd);
    assert_eq(load64(ymd) * 10000 + load64(ymd + 8) * 100 + load64(ymd + 16), 19700101, "day 0 = 1970-01-01");
    civil_from_days(0 - 1, ymd);
    assert_eq(load64(ymd) * 10000 + load64(ymd + 8) * 100 + load64(ymd + 16), 19691231, "day -1 = 1969-12-31");
    civil_from_days(11016, ymd);
    assert_eq(load64(ymd) * 10000 + load64(ymd + 8) * 100 + load64(ymd + 16), 20000229, "day 11016 = 2000-02-29");
    civil_from_days(0 - 719528, ymd);
    assert_eq(load64(ymd) * 10000 + load64(ymd + 8) * 100 + load64(ymd + 16), 101, "day -719528 = 0000-01-01");
    assert_eq(days_from_civil(1970, 1, 1), 0, "1970-01-01 = day 0");
    assert_eq(days_from_civil(2000, 3, 1), 11017, "2000-03-01 = day 11017");
    assert_eq(days_from_civil(1900, 3, 1), 0 - 25508, "1900-03-01 (1900 not leap)");
    assert_eq(days_from_civil(9999, 12, 31), 2932896, "9999-12-31");
    var rt_ok = 1;
    var rtd = 0 - 800000;
    while (rtd < 3000000) {
        civil_from_days(rtd, ymd);
        if (days_from_civil(load64(ymd), load64(ymd + 8), load64(ymd + 16)) != rtd) { rt_ok = 0; }
        rtd = rtd + 997;
    }
    assert_eq(rt_ok, 1, "civil_from_days / days_from_civil round-trip, years -220..10183");
    assert_eq(_tz_fdiv(0 - 1, 86400), 0 - 1, "floor division of a negative");
    assert_eq(_tz_fdiv(86400, 86400), 1, "floor division, exact");

    test_group("POSIX TZ rules (v1.6.0)");
    var ra = _tz_parse_rule("EST5EDT,M3.2.0,M11.1.0", 22);
    assert_eq(ra != 0, 1, "EST5EDT,M3.2.0,M11.1.0 parses");
    assert_eq(load64(ra), 0 - 18000, "std offset is EAST (-5h)");
    assert_eq(load64(ra + 16), 0 - 14400, "dst offset defaults to std + 1h");
    assert_eq(_tz_rule_offset(ra, 1720000000), 0 - 14400, "2024-07-03: EDT");
    assert_eq(_tz_rule_offset(ra, 1700000000), 0 - 18000, "2023-11-14: EST");
    # 2024: DST from 2024-03-10 07:00 UTC to 2024-11-03 06:00 UTC.
    assert_eq(_tz_rule_offset(ra, 1710054000 - 1), 0 - 18000, "one second before the 2024 start");
    assert_eq(_tz_rule_offset(ra, 1710054000), 0 - 14400, "at the 2024 start");
    assert_eq(_tz_rule_offset(ra, 1730613600 - 1), 0 - 14400, "one second before the 2024 end");
    assert_eq(_tz_rule_offset(ra, 1730613600), 0 - 18000, "at the 2024 end");
    assert_eq(_tz_rule_offset(ra, 0 - 1500000000), 0 - 18000,
      "1922: no DST before 1970 under a northern rule (glibc's compute_change)");
    var rs = _tz_parse_rule("AEST-10AEDT,M10.1.0,M4.1.0/3", 28);
    assert_eq(_tz_rule_offset(rs, 1704067200), 39600, "Sydney rule, January: AEDT +11");
    assert_eq(_tz_rule_offset(rs, 1720000000), 36000, "Sydney rule, July: AEST +10");
    var rq = _tz_parse_rule("<+0330>-3:30", 12);
    assert_eq(_tz_rule_offset(rq, 1700000000), 12600, "<+0330>-3:30 = +3:30, no DST");
    var rp = _tz_parse_rule("EST5EDT4,0/0,J365/25", 20);
    assert_eq(_tz_rule_offset(rp, 1700000000), 0 - 14400, "permanent DST (TZif v3 hours > 24)");
    assert_eq(_tz_parse_rule("EST", 3), 0, "no offset -> not a rule");
    assert_eq(_tz_parse_rule("ES5", 3), 0, "a 2-letter name -> not a rule");
    assert_eq(_tz_parse_rule("EST5EDT,M13.1.0,M11.1.0", 23), 0, "month 13 -> not a rule");
    assert_eq(_tz_parse_rule("EST5EDT,M3.2.0", 14), 0, "a start without an end -> not a rule");

    #ifndef CYRIUS_TARGET_AGNOS
    test_group("TZif zones (v1.6.0)");
    if (_tz_load_file("/usr/share/zoneinfo/America/New_York") == 1) {
        assert_eq(tz_offset(1720000000), 0 - 14400, "New York, July 2024: EDT");
        assert_eq(tz_offset(1700000000), 0 - 18000, "New York, November 2023: EST");
        assert_eq(tz_offset(0 - 2717668236), 0 - 17762, "New York, 1883: LMT -4:56:02");
        assert_eq(tz_offset(4102444800), 0 - 18000, "New York, 2100 (footer rule): EST");
        assert_eq(tz_offset(4118083200), 0 - 14400, "New York, July 2100 (footer rule): EDT");
    }
    if (_tz_load_file("/usr/share/zoneinfo/Asia/Kathmandu") == 1) {
        assert_eq(tz_offset(1700000000), 20700, "Kathmandu: +5:45");
    }
    assert_eq(_tz_load_file("/usr/share/zoneinfo/no/such/zone"), 0, "a missing zone file does not load");
    assert_eq(_tz_tzif("TZif2", 5), 0, "a truncated TZif image is refused");
    _tz_on = 0;
    #endif

    test_group("git_status_for_root");
    # v1.3.3: the `-T` root line. Its repo-relative path is the ctx
    # listing prefix itself, not prefix + display-name, so through
    # v1.3.2 it was looked up as "src/src" and always rendered '?'.
    # _git_dir_has_tracked's empty-rel case is what makes the repo-root
    # form work; it returned 0 unconditionally before.
    var _root_paths = vec_new();
    vec_push(_root_paths, make_str("src/a.txt"));
    vec_push(_root_paths, make_str("top.txt"));
    var _root_ctx = alloc(56);
    store64(_root_ctx + 0, _root_paths);
    store64(_root_ctx + 8, vec_new());
    store64(_root_ctx + 16, vec_new());
    store64(_root_ctx + 24, vec_new());
    store64(_root_ctx + 32, make_str(""));
    store64(_root_ctx + 40, 0);
    store64(_root_ctx + 48, 0);                 # no dir cell: the scan path
    # Empty rel = "the listing IS the repo root" -> tracked, because
    # any indexed path at all lives under it.
    assert_eq(_git_dir_has_tracked(_root_ctx, make_str("")), 1, "empty rel + tracked paths -> 1");
    assert_eq(_git_dir_has_tracked(_root_ctx, make_str("src")), 1, "'src' has tracked children");
    assert_eq(_git_dir_has_tracked(_root_ctx, make_str("nope")), 0, "unrelated dir -> 0");
    # An empty index must NOT report the root as tracked.
    var _empty_ctx = alloc(56);
    store64(_empty_ctx + 0, vec_new());
    store64(_empty_ctx + 8, vec_new());
    store64(_empty_ctx + 16, vec_new());
    store64(_empty_ctx + 24, vec_new());
    store64(_empty_ctx + 32, make_str(""));
    store64(_empty_ctx + 40, 0);
    store64(_empty_ctx + 48, 0);
    assert_eq(_git_dir_has_tracked(_empty_ctx, make_str("")), 0, "empty rel + empty index -> 0");

    # v1.4.0: the name sanitizer is darshana's `tty_sanitize_buf` in
    # TTY_SANITIZE_UTF8 mode (replacing v1.3.2's own `_is_ctrl_byte`
    # scrubber, which passed raw C1 and malformed UTF-8 through). These
    # pin the rule darshini depends on, through darshini's own wrappers.
    test_group("_sanitize_into (darshana UTF-8 rule)");
    var zb = alloc(64);
    var zn = 0;
    zn = _sanitize_into(zb, "plain.txt", 9);
    assert_eq(buf_eq_cstr(zb, zn, "plain.txt"), 1, "clean ASCII name unchanged");
    zn = _sanitize_into(zb, "a\x1b[2Jb", 6);
    assert_eq(buf_eq_cstr(zb, zn, "a?[2Jb"), 1, "ESC (CSI introducer) -> ?");
    zn = _sanitize_into(zb, "b\x1b]0;t\x07", 7);
    assert_eq(buf_eq_cstr(zb, zn, "b?]0;t?"), 1, "OSC title: ESC and BEL -> ?");
    zn = _sanitize_into(zb, "c\xc2\x9b31m", 6);
    assert_eq(buf_eq_cstr(zb, zn, "c?31m"), 1, "encoded C1 CSI (C2 9B) -> ONE ?");
    zn = _sanitize_into(zb, "d\x9b31m", 5);
    assert_eq(buf_eq_cstr(zb, zn, "d?31m"), 1, "raw 8-bit CSI 0x9B -> ? (v1.3.x passed it raw)");
    zn = _sanitize_into(zb, "e\x85x", 3);
    assert_eq(buf_eq_cstr(zb, zn, "e?x"), 1, "raw C1 NEL 0x85 -> ?");
    zn = _sanitize_into(zb, "tab\there", 8);
    assert_eq(buf_eq_cstr(zb, zn, "tab?here"), 1, "TAB -> ? (nothing kept)");
    zn = _sanitize_into(zb, "nl\nx", 4);
    assert_eq(buf_eq_cstr(zb, zn, "nl?x"), 1, "LF -> ?");
    zn = _sanitize_into(zb, "cr\rx", 4);
    assert_eq(buf_eq_cstr(zb, zn, "cr?x"), 1, "CR -> ? (line-overwrite vector)");
    zn = _sanitize_into(zb, "del\x7fx", 5);
    assert_eq(buf_eq_cstr(zb, zn, "del?x"), 1, "DEL -> ?");
    var nulname = alloc(4);
    store8(nulname, 120); store8(nulname + 1, 0); store8(nulname + 2, 121);
    zn = _sanitize_into(zb, nulname, 3);
    assert_eq(buf_eq_cstr(zb, zn, "x?y"), 1, "NUL -> ? (length-carried input)");
    zn = _sanitize_into(zb, "bad\xff\xfe", 5);
    assert_eq(buf_eq_cstr(zb, zn, "bad??"), 1, "invalid bytes FF FE -> one ? each");
    zn = _sanitize_into(zb, "trunc\xe4\xb8", 7);
    assert_eq(buf_eq_cstr(zb, zn, "trunc??"), 1, "sequence cut off by the end -> ? per byte");
    zn = _sanitize_into(zb, "caf\xe9", 4);
    assert_eq(buf_eq_cstr(zb, zn, "caf?"), 1, "Latin-1 e-acute (not UTF-8) -> ?");
    # Well-formed UTF-8 MUST pass byte-for-byte: sanitizing it would
    # corrupt accented / CJK / emoji names. These also guard the
    # load8-is-unsigned assumption the rule rests on — if load8 ever
    # sign-extended, every lead byte would read as < 0x20 and become ?.
    zn = _sanitize_into(zb, "caf\xc3\xa9", 5);
    assert_eq(buf_eq_cstr(zb, zn, "caf\xc3\xa9"), 1, "UTF-8 e-acute unchanged");
    zn = _sanitize_into(zb, "\xe4\xb8\xad\xe6\x96\x87", 6);
    assert_eq(buf_eq_cstr(zb, zn, "\xe4\xb8\xad\xe6\x96\x87"), 1, "CJK unchanged");
    zn = _sanitize_into(zb, "\xf0\x9f\x98\x80", 4);
    assert_eq(buf_eq_cstr(zb, zn, "\xf0\x9f\x98\x80"), 1, "4-byte emoji unchanged");
    zn = _sanitize_into(zb, "\xc2\xa0x", 3);
    assert_eq(buf_eq_cstr(zb, zn, "\xc2\xa0x"), 1, "U+00A0 (C2 A0, first non-C1) unchanged");
    assert_eq(_sanitize_into(zb, "x", 0), 0, "empty input -> 0 bytes");

    test_group("_name_display_len");
    var c1name = make_str("c\xc2\x9b31m");
    var escname = make_str("a\x1b[2Jb");
    set_sanitize_names(0);
    assert_eq(_name_display_len(c1name), 6, "sanitize off (pipe) -> str_len, raw bytes go out");
    set_sanitize_names(1);
    assert_eq(_name_display_len(c1name), 5, "sanitize on: encoded C1 is 2 bytes in, 1 out");
    assert_eq(_name_display_len(escname), 6, "sanitize on: ESC is 1 byte in, 1 out");
    assert_eq(_name_display_len(make_str("caf\xc3\xa9")), 5, "sanitize on: clean UTF-8 -> str_len");
    # > 4096 bytes takes the heap fallback instead of the stack scratch.
    var bigd = alloc(5001);
    var bi = 0;
    while (bi < 4998) { store8(bigd + bi, 97); bi = bi + 1; }
    store8(bigd + 4998, 0xc2); store8(bigd + 4999, 0x9b); store8(bigd + 5000, 0);
    assert_eq(_name_display_len(str_from(bigd)), 4999, "5000-byte dirty name (heap path) -> 4999");
    set_sanitize_names(0);

    test_group("column widths under sanitization");
    # entries: "ab" C2 9B "cd" (6 bytes, 5 written) and "x".
    var dirty = vec_new();
    vec_push(dirty, make_str("ab\xc2\x9bcd"));
    vec_push(dirty, make_str("x"));
    var clean2 = vec_new();
    vec_push(clean2, make_str("abcd"));
    vec_push(clean2, make_str("x"));
    # v1.6.0: any multibyte name gets a cells vec, sanitized or not; raw
    # C2 9B decodes to U+009B, one cell.
    var dw_off = _display_widths(dirty);
    assert_eq(dw_off != 0, 1, "sanitize off, a multibyte name -> cells vec");
    assert_eq(vec_get(dw_off, 0), 5, "sanitize off: ab U+009B cd = 5 cells");
    assert_eq(_display_widths(clean2), 0, "sanitize off, all ASCII -> no widths vec");
    set_sanitize_names(1);
    assert_eq(_display_widths(clean2), 0, "sanitize on, all clean -> no widths vec");
    var dw = _display_widths(dirty);
    assert_eq(dw != 0, 1, "sanitize on, a C1 name -> widths vec");
    assert_eq(vec_get(dw, 0), 5, "widths[0] = written length 5");
    assert_eq(vec_get(dw, 1), 1, "widths[1] = 1");
    assert_eq(_columns_total_width_w(dirty, dw, 2, 2, 1, 0), 8, "2x1 with widths: 5 + 2 + 1");
    assert_eq(_columns_total_width(dirty, 2, 2, 1, 0), 9, "2x1 by str_len: 6 + 2 + 1");
    assert_eq(_pick_cols_w(dirty, dw, 8, 0), 2, "tw=8: written widths fit 2 cols");
    assert_eq(pick_cols(dirty, 8, 0), 1, "tw=8: str_len widths would not");
    set_sanitize_names(0);

    test_group("terminal cells (v1.6.0)");
    # wcwidth(3) rules from the generated Unicode 16 table: East Asian Wide
    # / Fullwidth 2, combining / format 0, the rest 1; a byte outside any
    # well-formed sequence is one cell (the sanitizer's ? for it).
    assert_eq(utf8_cells("plain.txt", 9), 9, "ASCII: one cell per byte");
    assert_eq(utf8_cells("caf\xc3\xa9", 5), 4, "e-acute: 2 bytes, 1 cell");
    assert_eq(utf8_cells("\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e", 9), 6, "CJK: 3 bytes, 2 cells each");
    assert_eq(utf8_cells("e\xcc\x81", 3), 1, "e + combining acute: 1 cell");
    assert_eq(utf8_cells("\xf0\x9f\x8e\x89", 4), 2, "emoji U+1F389: 2 cells");
    assert_eq(utf8_cells("\xef\xbc\xa1", 3), 2, "fullwidth A U+FF21: 2 cells");
    assert_eq(utf8_cells("\xed\x95\x9c", 3), 2, "Hangul syllable U+D55C: 2 cells");
    assert_eq(utf8_cells("\xe1\x85\xa1", 3), 0, "Hangul medial jamo U+1161: 0");
    assert_eq(utf8_cells("\xe2\x80\x8d", 3), 0, "zero width joiner U+200D: 0");
    assert_eq(utf8_cells("\xc2\xad", 2), 1, "soft hyphen U+00AD: drawn, 1");
    assert_eq(utf8_cells("\xf4\x8f\xbf\xbf", 4), 1, "U+10FFFF: 1");
    assert_eq(utf8_cells("\xe6\x97", 2), 2, "truncated sequence: 1 cell per byte");
    assert_eq(utf8_cells("\xc0\xaf", 2), 2, "overlong: 1 cell per byte");
    assert_eq(utf8_cells("\xed\xa0\x80", 3), 3, "encoded surrogate: 1 cell per byte");
    assert_eq(_wc_width(0x2FF), 1, "below the table: 1");
    assert_eq(_wc_width(0x300), 0, "first table range (combining grave): 0");
    assert_eq(_wc_width(0x4E00), 2, "CJK unified ideograph: 2");
    # The grid: the CJK name is 12 bytes but 9 cells (3 x 2 + ".md").
    var cjk = vec_new();
    vec_push(cjk, make_str("\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e.md"));
    vec_push(cjk, make_str("ab"));
    vec_push(cjk, make_str("caf\xc3\xa9"));
    var cw = _display_widths(cjk);
    assert_eq(vec_get(cw, 0), 9, "grid width of the CJK name = 9 cells");
    assert_eq(vec_get(cw, 1), 2, "ASCII name = 2");
    assert_eq(vec_get(cw, 2), 4, "cafe-acute = 4");
    assert_eq(_columns_total_width_w(cjk, cw, 3, 3, 1, 0), 19, "3x1 in cells: 9 + 2 + 2 + 2 + 4");
    assert_eq(_pick_cols_w(cjk, cw, 19, 0), 3, "tw=19: fits 3 columns by cells");
    assert_eq(pick_cols(cjk, 19, 0), 2, "tw=19: by bytes only 2 columns (3 would need 23)");
    set_sanitize_names(1);
    var c1 = vec_new();
    vec_push(c1, make_str("ab\xc2\x9b\xe6\x97\xa5"));
    assert_eq(vec_get(_display_widths(c1), 0), 5, "TTY: encoded C1 -> ? (1) + ab (2) + CJK (2)");
    set_sanitize_names(0);

    test_group("term_width pipe-awareness contract");
    # term_width() > 0 exactly when stdout is a terminal (Linux): the
    # single signal that gates color, icons and multi-column. darshana's
    # tty_isatty is the same TIOCGWINSZ probe, so they must agree — on a
    # pipe (the usual `cyrius test` case) both say "not a terminal".
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos: 0 by decision — winsize#60 cannot tell fd 1 from the console.
    assert_eq(term_width(), 0, "agnos: term_width() is 0 (no per-fd terminal test)");
    #else
    var tw_is_tty = 0;
    if (term_width() > 0) { tw_is_tty = 1; }
    assert_eq(tw_is_tty, tty_isatty(STDOUT_FD), "term_width() > 0 iff tty_isatty(stdout)");
    #endif

    test_group("color_for_mode");
    # Directory (any perms) -> BLUE
    assert_eq(color_for_mode(0x41ED), TTY_FG_BLUE, "dir 0755 -> BLUE");
    assert_eq(color_for_mode(0x41C0), TTY_FG_BLUE, "dir 0700 -> BLUE");
    # Symlink -> CYAN (broken detection needs a follow-stat: compute_decor)
    assert_eq(color_for_mode(0xA1FF), TTY_FG_CYAN, "symlink -> CYAN (live; broken is compute_decor)");
    # FIFO -> YELLOW
    assert_eq(color_for_mode(0x11A4), TTY_FG_YELLOW, "fifo -> YELLOW");
    # Socket -> BRIGHT_MAGENTA
    assert_eq(color_for_mode(0xC1A4), TTY_FG_BRIGHT_MAGENTA, "socket -> BRIGHT_MAGENTA");
    # Block device -> BRIGHT_YELLOW
    assert_eq(color_for_mode(0x61A4), TTY_FG_BRIGHT_YELLOW, "blkdev -> BRIGHT_YELLOW");
    # Char device -> BRIGHT_YELLOW
    assert_eq(color_for_mode(0x21A4), TTY_FG_BRIGHT_YELLOW, "chrdev -> BRIGHT_YELLOW");
    # Regular non-executable -> 0 (no color)
    assert_eq(color_for_mode(0x81A4), 0, "regular 0644 -> 0 (no color)");
    assert_eq(color_for_mode(0x8000), 0, "regular 0000 -> 0 (no color)");
    # Regular file with any exec bit -> GREEN
    assert_eq(color_for_mode(0x81ED), TTY_FG_GREEN, "regular 0755 -> GREEN");
    assert_eq(color_for_mode(0x81C0 | S_IXUSR), TTY_FG_GREEN, "regular x-by-user -> GREEN");
    assert_eq(color_for_mode(0x81C0 | S_IXGRP), TTY_FG_GREEN, "regular x-by-group -> GREEN");
    assert_eq(color_for_mode(0x81C0 | S_IXOTH), TTY_FG_GREEN, "regular x-by-other -> GREEN");
    # Setuid bit alone (no exec) on a regular file -> still 0
    # (setuid without x is unusual; we don't promote color on it,
    # we only render the 'S' in the perm string).
    assert_eq(color_for_mode(0x89A4), 0, "regular setuid no-x -> 0 (no color)");

    # ============================================================
    # M5 — icon picker (lookup precedence per ADR 0002)
    # ============================================================

    test_group("icon_display_width");
    assert_eq(icon_display_width(), 2, "fixed 2 cells per icon");

    test_group("icon_for_entry");
    # The picker returns cstr pointers — we don't assert exact
    # glyph bytes (would couple tests to the codepoints), but we
    # do assert which RULE fired by checking that two siblings
    # with the same rule produce equal cstrs, and that a non-
    # match-vs-match flips the pointer.

    # Mode literals reused below.
    var mode_dir  = 0x41ED;        # 0o040755 directory
    var mode_reg  = 0x81A4;        # 0o100644 regular file
    var mode_lnk  = 0xA1FF;        # 0o120777 symlink
    var mode_fifo = 0x11A4;        # 0o010644 fifo

    # Rule 1: exact-filename match — Makefile lookup beats the
    # generic-regular-file fallback.
    var icon_make = icon_for_entry(make_str("Makefile"), mode_reg);
    var icon_dock = icon_for_entry(make_str("Dockerfile"), mode_reg);
    var icon_lic  = icon_for_entry(make_str("LICENSE"), mode_reg);
    var icon_ver  = icon_for_entry(make_str("VERSION"), mode_reg);
    assert_neq(icon_make, 0, "Makefile resolves to a glyph");
    assert_neq(icon_dock, 0, "Dockerfile resolves to a glyph");
    assert_neq(icon_lic,  0, "LICENSE resolves to a glyph");
    assert_neq(icon_ver,  0, "VERSION resolves to a glyph");
    # Sibling filenames hit different glyphs (Makefile != Dockerfile).
    assert_eq(streq(icon_make, icon_dock), 0, "Makefile glyph != Dockerfile glyph");

    # Rule 2: filename prefix.
    var icon_readme_md = icon_for_entry(make_str("README.md"), mode_reg);
    var icon_readme    = icon_for_entry(make_str("README"), mode_reg);
    assert_eq(streq(icon_readme, icon_readme_md), 1, "README & README.md → same prefix-rule glyph");
    var icon_chlog = icon_for_entry(make_str("CHANGELOG.md"), mode_reg);
    assert_eq(streq(icon_readme, icon_chlog), 0, "README != CHANGELOG glyph");

    # Rule 3: file-type override. A directory named "foo.md"
    # gets the folder glyph (not the markdown glyph). LICENSE
    # gets its filename glyph even though it's a regular file
    # (rule 1 fires before rule 3 — but no exact match for
    # `Makefile`-typed directory; let's pick a different one to
    # be precise).
    var icon_dir_named_md = icon_for_entry(make_str("foo.md"), mode_dir);
    var icon_reg_md       = icon_for_entry(make_str("foo.md"), mode_reg);
    assert_eq(streq(icon_dir_named_md, icon_reg_md), 0, "dir 'foo.md' != reg 'foo.md' (type beats ext)");
    var icon_dir_other = icon_for_entry(make_str("alpha"), mode_dir);
    assert_eq(streq(icon_dir_named_md, icon_dir_other), 1, "all dirs share folder glyph");
    # Symlink type override.
    var icon_lnk = icon_for_entry(make_str("ptr"), mode_lnk);
    assert_neq(icon_lnk, 0, "symlink gets link glyph");
    assert_eq(streq(icon_lnk, icon_dir_other), 0, "symlink glyph != dir glyph");
    var icon_fifo = icon_for_entry(make_str("pipe"), mode_fifo);
    assert_neq(icon_fifo, 0, "fifo gets fifo glyph");

    # Rule 4: extension. .cyr vs .md vs .py — each picks its own.
    var icon_cyr = icon_for_entry(make_str("main.cyr"), mode_reg);
    var icon_md  = icon_for_entry(make_str("README2.md"), mode_reg);  # avoids the README prefix rule
    var icon_py  = icon_for_entry(make_str("script.py"), mode_reg);
    assert_neq(icon_cyr, 0, ".cyr resolves");
    assert_eq(streq(icon_cyr, icon_md), 0, ".cyr glyph != .md glyph");
    assert_eq(streq(icon_md,  icon_py), 0, ".md glyph != .py glyph");
    # Case-insensitive ext: MAIN.CYR matches .cyr.
    var icon_cyr_upper = icon_for_entry(make_str("MAIN.CYR"), mode_reg);
    assert_eq(streq(icon_cyr, icon_cyr_upper), 1, "ext lookup is case-insensitive");

    # Rule 5: generic file fallback. No matching rule → generic
    # glyph (non-zero). Two unmatched-ext entries get the same
    # generic glyph.
    var icon_unk1 = icon_for_entry(make_str("foo.xyzzy"), mode_reg);
    var icon_unk2 = icon_for_entry(make_str("bar.qqq"), mode_reg);
    assert_neq(icon_unk1, 0, "unknown ext gets generic glyph");
    assert_eq(streq(icon_unk1, icon_unk2), 1, "two unknown exts share generic glyph");
    # An extension-less name with no special handling also → generic.
    var icon_noext = icon_for_entry(make_str("randomfile"), mode_reg);
    assert_eq(streq(icon_noext, icon_unk1), 1, "no-ext also generic");

    # M5 column-math interaction: icon_width shifts pick_cols
    # uniformly. 5x5 uniform at tw=40 fits 5 cols without icons
    # (33 chars); with icon_width=2 each cell needs +2, total
    # = 5*5 + 4*2 + 5*2 = 43 > 40, so falls to 3 cols.
    test_group("pick_cols + icon_width");
    assert_eq(pick_cols(five, 40, 0), 5, "5x5 tw=40 no-icons -> 5 cols");
    assert_eq(pick_cols(five, 40, 2), 3, "5x5 tw=40 icon_width=2 -> 3 cols");
    assert_eq(pick_cols(five, 60, 2), 5, "5x5 tw=60 icon_width=2 -> still 5 cols");
    # _columns_total_width with icon_width=2 adds cols*2.
    assert_eq(_columns_total_width(five, 5, 5, 1, 2), 43, "five@5x1 icon_width=2 -> 33 + 10 = 43");
    assert_eq(_columns_total_width(five, 5, 3, 2, 2), 25, "five@3x2 icon_width=2 -> 19 + 6 = 25");

    # ============================================================
    # M6 — tree mode (prefix + connector byte shapes)
    # ============================================================

    test_group("_tree_connector_buf");
    var cbuf = alloc(10);
    # is_last == 0 → "├── " = e2 94 9c e2 94 80 e2 94 80 20
    assert_eq(_tree_connector_buf(0, cbuf), 10, "non-last -> 10 bytes");
    assert_eq(load8(cbuf + 0), 0xe2, "non-last[0] = 0xe2");
    assert_eq(load8(cbuf + 1), 0x94, "non-last[1] = 0x94");
    assert_eq(load8(cbuf + 2), 0x9c, "non-last[2] = 0x9c (├)");
    assert_eq(load8(cbuf + 3), 0xe2, "non-last[3] = 0xe2");
    assert_eq(load8(cbuf + 4), 0x94, "non-last[4] = 0x94");
    assert_eq(load8(cbuf + 5), 0x80, "non-last[5] = 0x80 (─)");
    assert_eq(load8(cbuf + 6), 0xe2, "non-last[6] = 0xe2");
    assert_eq(load8(cbuf + 7), 0x94, "non-last[7] = 0x94");
    assert_eq(load8(cbuf + 8), 0x80, "non-last[8] = 0x80 (─)");
    assert_eq(load8(cbuf + 9), 0x20, "non-last[9] = ' '");
    # is_last == 1 → "└── " = e2 94 94 e2 94 80 e2 94 80 20
    assert_eq(_tree_connector_buf(1, cbuf), 10, "last -> 10 bytes");
    assert_eq(load8(cbuf + 0), 0xe2, "last[0] = 0xe2");
    assert_eq(load8(cbuf + 1), 0x94, "last[1] = 0x94");
    assert_eq(load8(cbuf + 2), 0x94, "last[2] = 0x94 (└)");
    assert_eq(load8(cbuf + 9), 0x20, "last[9] = ' '");

    test_group("_tree_prefix_buf");
    var pbuf = alloc(64);
    # Empty depth_stack → 0 bytes (root level).
    var empty_stk = vec_new();
    assert_eq(_tree_prefix_buf(empty_stk, pbuf), 0, "empty stack -> 0 bytes");
    # One slot, "more siblings" (1) → "│   " = 6 bytes (e2 94 82 20 20 20)
    var stk1 = vec_new();
    vec_push(stk1, 1);
    assert_eq(_tree_prefix_buf(stk1, pbuf), 6, "[1] -> 6 bytes (│   )");
    assert_eq(load8(pbuf + 0), 0xe2, "[1] bytes[0] = 0xe2");
    assert_eq(load8(pbuf + 1), 0x94, "[1] bytes[1] = 0x94");
    assert_eq(load8(pbuf + 2), 0x82, "[1] bytes[2] = 0x82 (│)");
    assert_eq(load8(pbuf + 3), 0x20, "[1] bytes[3] = ' '");
    assert_eq(load8(pbuf + 4), 0x20, "[1] bytes[4] = ' '");
    assert_eq(load8(pbuf + 5), 0x20, "[1] bytes[5] = ' '");
    # One slot, "no more siblings" (0) → "    " = 4 spaces
    var stk0 = vec_new();
    vec_push(stk0, 0);
    assert_eq(_tree_prefix_buf(stk0, pbuf), 4, "[0] -> 4 bytes");
    assert_eq(load8(pbuf + 0), 0x20, "[0] bytes[0] = ' '");
    assert_eq(load8(pbuf + 1), 0x20, "[0] bytes[1] = ' '");
    assert_eq(load8(pbuf + 2), 0x20, "[0] bytes[2] = ' '");
    assert_eq(load8(pbuf + 3), 0x20, "[0] bytes[3] = ' '");
    # Mixed [1, 0, 1] → "│   " + "    " + "│   " = 6+4+6 = 16 bytes
    var stk_mix = vec_new();
    vec_push(stk_mix, 1);
    vec_push(stk_mix, 0);
    vec_push(stk_mix, 1);
    assert_eq(_tree_prefix_buf(stk_mix, pbuf), 16, "[1,0,1] -> 16 bytes");
    # First slot: │
    assert_eq(load8(pbuf + 2), 0x82, "[1,0,1] first vert at +2");
    # Second slot starts at offset 6, all spaces.
    assert_eq(load8(pbuf + 6), 0x20, "[1,0,1] second slot[0] = ' '");
    assert_eq(load8(pbuf + 9), 0x20, "[1,0,1] second slot[3] = ' '");
    # Third slot starts at offset 10, vertical bar.
    assert_eq(load8(pbuf + 12), 0x82, "[1,0,1] third vert at +12");

    test_group("_parse_pos_int");
    assert_eq(_parse_pos_int("1"), 1, "'1' -> 1");
    assert_eq(_parse_pos_int("42"), 42, "'42' -> 42");
    assert_eq(_parse_pos_int("999"), 999, "'999' -> 999");
    assert_eq(_parse_pos_int(""), 0 - 1, "'' -> -1");
    assert_eq(_parse_pos_int("0"), 0, "'0' -> 0 (caller rejects 0)");
    assert_eq(_parse_pos_int("abc"), 0 - 1, "'abc' -> -1");
    assert_eq(_parse_pos_int("12a"), 0 - 1, "'12a' -> -1 (mid-string non-digit)");
    assert_eq(_parse_pos_int("-5"), 0 - 1, "'-5' -> -1 (sign rejected)");
    # v1.4.1: the bound the comment always promised.
    assert_eq(_parse_pos_int("2147483647"), 2147483647, "2^31-1 accepted");
    assert_eq(_parse_pos_int("2147483648"), 0 - 1, "2^31 -> -1");
    assert_eq(_parse_pos_int("18446744073709551617"), 0 - 1, "2^64+1 -> -1 (wrapped to 1 before)");
    assert_eq(_parse_pos_int("99999999999999999999999"), 0 - 1, "huge -> -1");

    test_group("_long_flag_code");
    assert_eq(_long_flag_code("--"), LF_END_OPTS, "'--' -> end of options (v1.4.1)");
    assert_eq(_long_flag_code("--tree"), LF_TREE, "--tree");
    assert_eq(_long_flag_code("--git"), LF_GIT, "--git");
    assert_eq(_long_flag_code("--mime"), LF_MIME, "--mime");
    assert_eq(_long_flag_code("--level"), LF_LEVEL, "--level");
    assert_eq(_long_flag_code("--no-color"), LF_NO_COLOR, "--no-color");
    assert_eq(_long_flag_code("--no-icons"), LF_NO_ICONS, "--no-icons");
    assert_eq(_long_flag_code("--help"), LF_HELP, "--help");
    assert_eq(_long_flag_code("--version"), LF_VERSION, "--version");
    assert_eq(_long_flag_code("---"), LF_UNKNOWN, "'---' unknown");
    assert_eq(_long_flag_code("--gitx"), LF_UNKNOWN, "no prefix match");
    assert_eq(_long_flag_code("--level=2"), LF_UNKNOWN, "--level=N form not accepted");
    assert_eq(_long_flag_code("--local-time"), LF_LOCAL_TIME, "--local-time (v1.6.0)");

    # ============================================================
    # M7 — git status (helpers + classifier)
    # ============================================================

    test_group("_be_u32 / _be_u16");
    var be_buf = alloc(8);
    store8(be_buf + 0, 0x12);
    store8(be_buf + 1, 0x34);
    store8(be_buf + 2, 0x56);
    store8(be_buf + 3, 0x78);
    assert_eq(_be_u32(be_buf, 0), 0x12345678, "be32 multi-byte");
    assert_eq(_be_u16(be_buf, 0), 0x1234, "be16 multi-byte");
    store8(be_buf + 0, 0x00);
    store8(be_buf + 1, 0x00);
    store8(be_buf + 2, 0x00);
    store8(be_buf + 3, 0x02);
    assert_eq(_be_u32(be_buf, 0), 2, "be32 = 2 (DIRC version 2 shape)");
    store8(be_buf + 0, 0x00);
    store8(be_buf + 1, 0x00);
    store8(be_buf + 2, 0x00);
    store8(be_buf + 3, 0x75);
    assert_eq(_be_u32(be_buf, 0), 0x75, "be32 = 0x75 (117 entries shape)");

    test_group("_git_parse_index");
    # Malformed: too short
    var paths_a = vec_new();
    var mtimes_a = vec_new();
    var sizes_a = vec_new();
    assert_eq(_git_parse_index(be_buf, 4, paths_a, mtimes_a, sizes_a), 0 - 1, "len<12 -> -1");
    # Malformed: bad signature
    var bad_hdr = alloc(12);
    store8(bad_hdr + 0, 88); store8(bad_hdr + 1, 88);   # "XX..." not DIRC
    store8(bad_hdr + 2, 88); store8(bad_hdr + 3, 88);
    store8(bad_hdr + 4, 0); store8(bad_hdr + 5, 0);
    store8(bad_hdr + 6, 0); store8(bad_hdr + 7, 2);
    store8(bad_hdr + 8, 0); store8(bad_hdr + 9, 0);
    store8(bad_hdr + 10, 0); store8(bad_hdr + 11, 0);
    assert_eq(_git_parse_index(bad_hdr, 12, paths_a, mtimes_a, sizes_a), 0 - 1, "bad signature -> -1");
    # Versions: 2..4 accepted since v1.4.1 (v3 was rejected, and the
    # rejection ignored, so the column showed every file '?').
    var vh = zbuf(12);
    idx_header(vh, 3, 0);
    assert_eq(_git_parse_index(vh, 12, paths_a, mtimes_a, sizes_a), 0, "v3 empty -> 0 (v1.4.1)");
    idx_header(vh, 4, 0);
    assert_eq(_git_parse_index(vh, 12, paths_a, mtimes_a, sizes_a), 0, "v4 empty -> 0 (v1.4.1)");
    idx_header(vh, 5, 0);
    assert_eq(_git_parse_index(vh, 12, paths_a, mtimes_a, sizes_a), 0 - 1, "v5 -> -1");
    idx_header(vh, 1, 0);
    assert_eq(_git_parse_index(vh, 12, paths_a, mtimes_a, sizes_a), 0 - 1, "v1 -> -1");
    # Valid v2 with 0 entries
    var v2_empty = alloc(12);
    store8(v2_empty + 0, 68); store8(v2_empty + 1, 73);
    store8(v2_empty + 2, 82); store8(v2_empty + 3, 67);
    store8(v2_empty + 4, 0); store8(v2_empty + 5, 0);
    store8(v2_empty + 6, 0); store8(v2_empty + 7, 2);
    store8(v2_empty + 8, 0); store8(v2_empty + 9, 0);
    store8(v2_empty + 10, 0); store8(v2_empty + 11, 0);
    var paths_b = vec_new();
    var mtimes_b = vec_new();
    var sizes_b = vec_new();
    assert_eq(_git_parse_index(v2_empty, 12, paths_b, mtimes_b, sizes_b), 0, "v2 empty -> 0");
    assert_eq(vec_len(paths_b), 0, "v2 empty -> 0 paths pushed");

    test_group("_git_parse_index v2/v3/v4/sha256 (v1.4.1)");
    # v2: two entries, real framing.
    var ib = zbuf(512);
    var ip = idx_header(ib, 2, 2);
    ip = idx_entry(ib, ip, 20, 1700000000, 5, "a.txt", 0);
    ip = idx_entry(ib, ip, 20, 1700000001, 7, "src/b.txt", 0);
    var pv = vec_new(); var mv = vec_new(); var sv = vec_new();
    assert_eq(_git_parse_index(ib, ip, pv, mv, sv), 0, "v2 two entries -> 0");
    assert_eq(vec_len(pv), 2, "v2: 2 paths");
    assert_eq(str_eq(vec_get(pv, 1), make_str("src/b.txt")), 1, "v2: second path");
    assert_eq(vec_get(mv, 1), 1700000001, "v2: second mtime");
    assert_eq(vec_get(sv, 0), 5, "v2: first size");
    # A name that is not NUL-terminated where git puts the NUL is a
    # misframed entry -> -1.
    var mf_buf = zbuf(512);
    var mf_pos = idx_header(mf_buf, 2, 1);
    mf_pos = idx_entry(mf_buf, mf_pos, 20, 1, 1, "abc", 0);
    put_be16(mf_buf, 12 + 60, 2);                  # claims 2 bytes: "ab" then 'c', not NUL
    var pz = vec_new(); var mz = vec_new(); var sz = vec_new();
    assert_eq(_git_parse_index(mf_buf, mf_pos, pz, mz, sz), 0 - 1, "name length that misses the NUL -> -1");
    # v3: the second entry carries the extended flag word (+2 bytes).
    var ib3 = zbuf(512);
    var ip3 = idx_header(ib3, 3, 2);
    ip3 = idx_entry(ib3, ip3, 20, 10, 1, "plain", 0);
    ip3 = idx_entry(ib3, ip3, 20, 11, 2, "ext/flagged.txt", 1);
    var p3 = vec_new(); var m3 = vec_new(); var s3 = vec_new();
    assert_eq(_git_parse_index(ib3, ip3, p3, m3, s3), 0, "v3 with an extended entry -> 0");
    assert_eq(str_eq(vec_get(p3, 1), make_str("ext/flagged.txt")), 1, "v3: extended entry's name");
    assert_eq(vec_get(s3, 1), 2, "v3: extended entry's size");
    # v4: "src/a.c", then "src/b.c" stored as strip 3 + "b.c".
    var ib4 = zbuf(512);
    var ip4 = idx_header(ib4, 4, 2);
    ip4 = idx_entry_v4(ib4, ip4, 20, 1, 0, "src/a.c", 7);
    ip4 = idx_entry_v4(ib4, ip4, 21, 2, 3, "b.c", 7);
    var p4 = vec_new(); var m4 = vec_new(); var s4 = vec_new();
    assert_eq(_git_parse_index(ib4, ip4, p4, m4, s4), 0, "v4 prefix-compressed -> 0");
    assert_eq(str_eq(vec_get(p4, 0), make_str("src/a.c")), 1, "v4: first path");
    assert_eq(str_eq(vec_get(p4, 1), make_str("src/b.c")), 1, "v4: second path rebuilt from the prefix");
    assert_eq(vec_get(m4, 1), 21, "v4: second mtime");
    # v4: stripping more than the previous path holds -> -1.
    var ib4b = zbuf(256);
    var ip4b = idx_header(ib4b, 4, 1);
    ip4b = idx_entry_v4(ib4b, ip4b, 1, 1, 5, "x", 1);
    var pq = vec_new(); var mq = vec_new(); var sq = vec_new();
    assert_eq(_git_parse_index(ib4b, ip4b, pq, mq, sq), 0 - 1, "v4 strip > previous length -> -1");
    # 0xFFF long name: the length comes from the NUL scan. v1.4.0 started
    # that count at 0xFFF and failed the whole parse.
    var ln = alloc(4200);
    memset(ln, 97, 4100);
    store8(ln + 4100, 0);
    var ibl = zbuf(4400);
    var ipl = idx_header(ibl, 2, 2);
    ipl = idx_entry(ibl, ipl, 20, 1, 1, ln, 0);
    ipl = idx_entry(ibl, ipl, 20, 2, 2, "z.txt", 0);
    var pl = vec_new(); var ml = vec_new(); var ls_v = vec_new();
    assert_eq(_git_parse_index(ibl, ipl, pl, ml, ls_v), 0, "4100-byte name -> 0");
    assert_eq(str_len(vec_get(pl, 0)), 4100, "long name: full length recovered");
    assert_eq(str_eq(vec_get(pl, 1), make_str("z.txt")), 1, "long name: the entry after it still parses");
    # SHA-256: 32-byte ids shift the flags word by 12 bytes.
    var ibs = zbuf(512);
    var ips = idx_header(ibs, 2, 1);
    ips = idx_entry(ibs, ips, 32, 3, 4, "sha.txt", 0);
    var ps = vec_new(); var ms = vec_new(); var ss = vec_new();
    assert_eq(_git_parse_index_oid(ibs, ips, 32, ps, ms, ss), 0, "sha256 index, oid_len 32 -> 0");
    assert_eq(str_eq(vec_get(ps, 0), make_str("sha.txt")), 1, "sha256: name");
    var ps1 = vec_new(); var ms1 = vec_new(); var ss1 = vec_new();
    assert_eq(_git_parse_index_oid(ibs, ips, 20, ps1, ms1, ss1), 0 - 1, "sha256 index read as sha1 -> -1");

    test_group("_git_oid_len");
    var cfg1 = "[core]\n\trepositoryformatversion = 1\n[extensions]\n\tobjectFormat = sha256\n";
    assert_eq(_git_oid_len(cfg1, strlen(cfg1)), 32, "objectFormat = sha256 -> 32");
    var cfg2 = "[core]\n\tbare = false\n";
    assert_eq(_git_oid_len(cfg2, strlen(cfg2)), 20, "no objectformat -> 20");
    var cfg3 = "[extensions]\n\tobjectformat = sha1\n# sha256\n";
    assert_eq(_git_oid_len(cfg3, strlen(cfg3)), 20, "sha1, sha256 only on a later line -> 20");

    test_group("git status outcomes (v1.4.1)");
    var gp = vec_new(); var gm = vec_new(); var gs = vec_new();
    vec_push(gp, make_str("a.txt"));      vec_push(gm, 100); vec_push(gs, 10);
    vec_push(gp, make_str("src/b.txt"));  vec_push(gm, 200); vec_push(gs, 20);
    vec_push(gp, make_str("big.bin"));    vec_push(gm, 300); vec_push(gs, 1073741824);
    var gpat = "*.log\n";
    var gctx = mk_ctx(gp, gm, gs, gpat, "");
    assert_eq(git_status_for(gctx, make_str("a.txt"), 0, 100, 10), 46, "tracked + matching stat -> '.'");
    assert_eq(git_status_for(gctx, make_str("a.txt"), 0, 101, 10), 77, "mtime differs -> 'M'");
    assert_eq(git_status_for(gctx, make_str("a.txt"), 0, 100, 11), 77, "size differs -> 'M'");
    assert_eq(git_status_for(gctx, make_str("new.txt"), 0, 1, 1), 63, "untracked -> '?'");
    assert_eq(git_status_for(gctx, make_str("app.log"), 0, 1, 1), 33, "ignored -> '!'");
    assert_eq(git_status_for(gctx, make_str("src"), 1, 1, 1), 46, "dir with tracked files -> '.'");
    # u32 compare, as git: 5 GiB is stored as 5 GiB mod 2^32 = 1 GiB.
    assert_eq(git_status_for(gctx, make_str("big.bin"), 0, 300, 5368709120), 46, "5 GiB file clean -> '.'");
    assert_eq(git_status_for(gctx, make_str("a.txt"), 0, 100 + 4294967296, 10), 46, "mtime compared mod 2^32");
    # The listing path itself (-l <file>, -ld <dir>, the -T root).
    var fctx = mk_ctx(gp, gm, gs, gpat, "src/b.txt");
    assert_eq(git_status_for_root(fctx, make_str("b.txt"), 0, 200, 20), 46, "-l --git src/b.txt -> '.'");
    assert_eq(git_status_for_root(fctx, make_str("b.txt"), 0, 201, 20), 77, "-l --git src/b.txt modified -> 'M'");
    var dctx = mk_ctx(gp, gm, gs, gpat, "src");
    assert_eq(git_status_for_root(dctx, make_str("src"), 1, 1, 1), 46, "-ld --git src -> '.'");
    var lctx = mk_ctx(gp, gm, gs, gpat, "app.log");
    assert_eq(git_status_for_root(lctx, make_str("app.log"), 0, 1, 1), 33, "-l --git app.log -> '!'");
    var uctx = mk_ctx(gp, gm, gs, gpat, "nope.txt");
    assert_eq(git_status_for_root(uctx, make_str("nope.txt"), 0, 1, 1), 63, "-l --git untracked -> '?'");
    # Directory lookup through the shared prefix set agrees with the scan.
    assert_eq(_git_dir_has_tracked(gctx, make_str("src")), 1, "prefix set: src has tracked files");
    assert_eq(_git_dir_has_tracked(gctx, make_str("sr")), 0, "prefix set: 'sr' is not a prefix dir");
    assert_eq(_git_dir_has_tracked(gctx, make_str("a.txt")), 0, "prefix set: a file is not a dir");
    assert_eq(load64(load64(gctx + 48)) != 0, 1, "prefix set built on first lookup");

    test_group("wildmatch (git t3070 table)");
    # v1.5.0: src/ignore.cyr ports git's wildmatch. These are git's own
    # wildmatch test vectors: text, pattern, then the expected result WITH
    # WM_PATHNAME (how every '/'-containing gitignore pattern is matched)
    # and WITHOUT it — asserted only for slash-free patterns, the only
    # kind git matches that way ('-' = not asserted).
    var wm_rows = vec_new();
    vec_push(wm_rows, "foo\tfoo\t11\n");
    vec_push(wm_rows, "bar\tfoo\t00\n");
    vec_push(wm_rows, "foo\t???\t11\n");
    vec_push(wm_rows, "foo\t??\t00\n");
    vec_push(wm_rows, "foo\t*\t11\n");
    vec_push(wm_rows, "foo\tf*\t11\n");
    vec_push(wm_rows, "foo\t*f\t00\n");
    vec_push(wm_rows, "foo\t*foo*\t11\n");
    vec_push(wm_rows, "foobar\t*ob*a*r*\t11\n");
    vec_push(wm_rows, "aaaaaaabababab\t*ab\t11\n");
    vec_push(wm_rows, "foo*\tfoo\\*\t11\n");
    vec_push(wm_rows, "foobar\tfoo\\*bar\t00\n");
    vec_push(wm_rows, "f\\oo\tf\\\\oo\t11\n");
    vec_push(wm_rows, "ball\t*[al]?\t11\n");
    vec_push(wm_rows, "ten\t[ten]\t00\n");
    vec_push(wm_rows, "ten\t**[!te]\t11\n");
    vec_push(wm_rows, "ten\t**[!ten]\t00\n");
    vec_push(wm_rows, "ten\tt[a-g]n\t11\n");
    vec_push(wm_rows, "ten\tt[!a-g]n\t00\n");
    vec_push(wm_rows, "ton\tt[!a-g]n\t11\n");
    vec_push(wm_rows, "ton\tt[^a-g]n\t11\n");
    vec_push(wm_rows, "a]b\ta[]]b\t11\n");
    vec_push(wm_rows, "a-b\ta[]-]b\t11\n");
    vec_push(wm_rows, "a]b\ta[]-]b\t11\n");
    vec_push(wm_rows, "aab\ta[]-]b\t00\n");
    vec_push(wm_rows, "aab\ta[]a-]b\t11\n");
    vec_push(wm_rows, "]\t]\t11\n");
    vec_push(wm_rows, "foo/baz/bar\tfoo*bar\t01\n");
    vec_push(wm_rows, "foo/baz/bar\tfoo**bar\t01\n");
