    vec_push(wm_rows, "XXX/adobe/courier/bold/o/normal//12/120/75/75/X/70/iso8859/1\tXXX/*/*/*/*/*/*/12/*/*/*/m/*/*/*\t0-\n");
    vec_push(wm_rows, "abcd/abcdefg/abcdefghijk/abcdefghijklmnop.txt\t**/*a*b*g*n*t\t1-\n");
    vec_push(wm_rows, "abcd/abcdefg/abcdefghijk/abcdefghijklmnop.txtz\t**/*a*b*g*n*t\t0-\n");
    vec_push(wm_rows, "foo\t*/*/*\t0-\n");
    vec_push(wm_rows, "foo/bar\t*/*/*\t0-\n");
    vec_push(wm_rows, "foo/bba/arr\t*/*/*\t1-\n");
    vec_push(wm_rows, "foo/bb/aa/rr\t*/*/*\t0-\n");
    vec_push(wm_rows, "foo/bb/aa/rr\t**/**/**\t1-\n");
    vec_push(wm_rows, "abcXdefXghi\t*X*i\t11\n");
    vec_push(wm_rows, "ab/cXd/efXg/hi\t*X*i\t01\n");
    vec_push(wm_rows, "ab/cXd/efXg/hi\t*/*X*/*/*i\t1-\n");
    vec_push(wm_rows, "ab/cXd/efXg/hi\t**/*X*/**/*i\t1-\n");
    var wm_bad = 0;
    var wi = 0;
    while (wi < vec_len(wm_rows)) {
        var row = vec_get(wm_rows, wi);
        var rn = strlen(row);
        var t1 = 0;
        while (load8(row + t1) != 9) { t1 = t1 + 1; }
        var t2 = t1 + 1;
        while (load8(row + t2) != 9) { t2 = t2 + 1; }
        var eg = load8(row + t2 + 1) - 48;
        var ep = load8(row + t2 + 2);
        if (wildmatch(row + t1 + 1, t2 - t1 - 1, row, t1, 1) != eg) {
            wm_bad = wm_bad + 1;
            d_write(STDERR_FD, "  wildmatch WM_PATHNAME mismatch: ", 34); d_write(STDERR_FD, row, rn);
        }
        if (ep != 45) {
            if (wildmatch(row + t1 + 1, t2 - t1 - 1, row, t1, 0) != ep - 48) {
                wm_bad = wm_bad + 1;
                d_write(STDERR_FD, "  wildmatch basename mismatch: ", 31); d_write(STDERR_FD, row, rn);
            }
        }
        wi = wi + 1;
    }
    assert_eq(vec_len(wm_rows), 137, "t3070 table: 137 rows");
    assert_eq(wm_bad, 0, "t3070 table: every row matches git");

    test_group("gitignore patterns (git semantics, v1.5.0)");
    # Basename patterns match at any depth; '/' anchors to the file's dir.
    assert_eq(ig1("*.log", "a/b/x.log", 0, ""), 1, "*.log matches at depth");
    assert_eq(ig1("/TODO", "TODO", 0, ""), 1, "/TODO matches the root TODO");
    assert_eq(ig1("/TODO", "src/TODO", 0, ""), 0, "/TODO does not match src/TODO (was stripped to TODO)");
    assert_eq(ig1("doc/build", "doc/build", 0, ""), 1, "path pattern from the root");
    assert_eq(ig1("doc/build", "x/doc/build", 0, ""), 0, "path pattern is anchored");
    assert_eq(ig1("build", "x/doc/build", 1, ""), 1, "basename pattern at depth");
    # Classes, '?', mid-pattern '*', '**'.
    assert_eq(ig1("*.py[cod]", "m/x.pyc", 0, ""), 1, "*.py[cod] (GitHub's Python template)");
    assert_eq(ig1("*.py[cod]", "m/x.py", 0, ""), 0, "*.py[cod] not .py");
    assert_eq(ig1("foo?.txt", "foo1.txt", 0, ""), 1, "?");
    assert_eq(ig1("a*b", "aXXb", 0, ""), 1, "mid-pattern *");
    assert_eq(ig1("**/gen", "a/b/gen", 1, ""), 1, "**/gen at depth");
    assert_eq(ig1("doc/**/x.md", "doc/x.md", 0, ""), 1, "a/**/b with zero dirs");
    assert_eq(ig1("doc/**/x.md", "doc/a/b/x.md", 0, ""), 1, "a/**/b with two dirs");
    assert_eq(ig1("logs/**", "logs/a/b", 0, ""), 1, "trailing /**");
    assert_eq(ig1("logs/**", "logs", 1, ""), 0, "trailing /** does not match the dir itself");
    # Directory-only.
    assert_eq(ig1("build/", "build", 1, ""), 1, "build/ matches a dir");
    assert_eq(ig1("build/", "build", 0, ""), 0, "build/ does not match a file");
    # Negation and last-match-wins within one list.
    assert_eq(ig1("*.log\n!keep.log\n", "keep.log", 0, ""), 2, "!keep.log re-includes (was '!')");
    assert_eq(ig1("!keep.log\n*.log\n", "keep.log", 0, ""), 1, "a later *.log wins");
    # Escapes, comments, whitespace.
    assert_eq(ig1("\\#hash", "#hash", 0, ""), 1, "backslash-# is a literal #");
    assert_eq(ig1("#hash", "#hash", 0, ""), 0, "#... is a comment");
    assert_eq(ig1("\\!x", "!x", 0, ""), 1, "backslash-! is a literal !");
    assert_eq(ig1("trail   ", "trail", 0, ""), 1, "trailing spaces trimmed");
    assert_eq(ig1("sp\\ ", "sp ", 0, ""), 1, "an escaped trailing space is kept");
    assert_eq(ig1(" lead", "lead", 0, ""), 0, "leading spaces are kept (no trim)");
    assert_eq(ig1(" lead", " lead", 0, ""), 1, "... so ' lead' matches ' lead'");
    assert_eq(ig1("tab\t", "tab", 0, ""), 0, "a trailing TAB is kept, as in git");
    # A nested list's patterns are relative to its directory.
    assert_eq(ig1("/x.txt", "sub/x.txt", 0, "sub"), 1, "anchored to the list's dir");
    assert_eq(ig1("/x.txt", "x.txt", 0, "sub"), 0, "not outside the list's dir");
    assert_eq(ig1("a/b", "sub/a/b", 0, "sub"), 1, "path pattern under the list's dir");

    test_group("_git_normalize_abs");
    # v1.3.2 (P(-1)): bare `darshini --git` in a repo subdirectory
    # supplies "." as the path, so the listing arrived as "/r/src/."
    # and every tracked file rendered '?' (untracked).
    assert_eq(buf_eq_cstr(_git_normalize_abs("/r/src/."), 6, "/r/src"), 1, "trailing /. dropped");
    assert_eq(buf_eq_cstr(_git_normalize_abs("/r/src/"), 6, "/r/src"), 1, "trailing / stripped");
    assert_eq(buf_eq_cstr(_git_normalize_abs("/r//src"), 6, "/r/src"), 1, "// collapsed");
    assert_eq(buf_eq_cstr(_git_normalize_abs("/r/./src"), 6, "/r/src"), 1, "interior /./ dropped");
    assert_eq(buf_eq_cstr(_git_normalize_abs("/r/src"), 6, "/r/src"), 1, "already-clean path unchanged");
    assert_eq(buf_eq_cstr(_git_normalize_abs("/"), 1, "/"), 1, "root stays root");
    assert_eq(buf_eq_cstr(_git_normalize_abs("/."), 1, "/"), 1, "/. -> root");
    assert_eq(buf_eq_cstr(_git_normalize_abs("///"), 1, "/"), 1, "/// -> root");
    # `..` is deliberately NOT resolved — the repo-root walk-up probes
    # with stat(2), so the kernel resolves it symlink-aware. Resolving
    # it lexically would bind /a/link/.. to the wrong repo.
    assert_eq(buf_eq_cstr(_git_normalize_abs("/r/src/.."), 9, "/r/src/.."), 1, ".. left for the kernel");

    test_group("_ig_parse (line endings, BOM)");
    # v1.3.2 fixed CRLF; v1.5.0's parser is git's: one '\r' before each
    # '\n' is dropped, the last line too, and a UTF-8 BOM is skipped.
    var crlf_pats = vec_new();
    var crlf_src = "*.swp\r\nbuild/\r\n";
    _ig_parse(crlf_src, strlen(crlf_src), crlf_pats);
    assert_eq(vec_len(crlf_pats), 2, "CRLF: two patterns parsed");
    assert_eq(_ig_rec_len(vec_get(crlf_pats, 0)), 5, "CRLF: no trailing CR in *.swp");
    assert_eq(_ig_rec_flags(vec_get(crlf_pats, 1)) & IG_MUSTBEDIR, IG_MUSTBEDIR, "CRLF: build/ is dir-only");
    var lastcr = vec_new();
    _ig_parse("a\nb\r", 4, lastcr);
    assert_eq(_ig_rec_len(vec_get(lastcr, 1)), 1, "a final line without LF still loses its CR");
    var bom = vec_new();
    var bom_src = alloc(8);
    store8(bom_src, 0xEF); store8(bom_src + 1, 0xBB); store8(bom_src + 2, 0xBF);
    store8(bom_src + 3, 120); store8(bom_src + 4, 10);
    _ig_parse(bom_src, 5, bom);
    assert_eq(vec_len(bom), 1, "BOM: one pattern");
    assert_eq(_ig_rec_len(vec_get(bom, 0)), 1, "BOM skipped, not part of the pattern");
    var flg = vec_new();
    _ig_parse("!/a/b/\n", 7, flg);
    var fr = vec_get(flg, 0);
    assert_eq(_ig_rec_flags(fr), IG_NEGATIVE | IG_MUSTBEDIR, "!/a/b/: negative, dir-only, has a slash");
    assert_eq(_ig_rec_len(fr), 4, "!/a/b/ stored as /a/b");

    test_group("gitignore precedence and inheritance (v1.5.0)");
    var pr_p = vec_new(); var pr_m = vec_new(); var pr_s = vec_new();
    vec_push(pr_p, make_str("build/keep.txt")); vec_push(pr_m, 1); vec_push(pr_s, 1);
    var ictx = mk_ctx(pr_p, pr_m, pr_s, "build/\n*.log\n!keep.log\n", "");
    ctx_dir_ignore(ictx, "sub", "!a.log\nlocal.txt\n");
    ctx_dir_ignore(ictx, "build", "!out.o\n");
    ctx_base_ignore(ictx, "*.tmp\n!root.log\n");
    assert_eq(git_status_for_sub(ictx, make_str("a.log"), make_str("a.log"), 0, 1, 1), 33, "root *.log");
    assert_eq(git_status_for_sub(ictx, make_str("keep.log"), make_str("keep.log"), 0, 1, 1), 63,
      "!keep.log re-includes");
    assert_eq(git_status_for_sub(ictx, make_str("sub/a.log"), make_str("a.log"), 0, 1, 1), 63,
      "a deeper !a.log beats the root's *.log");
    assert_eq(git_status_for_sub(ictx, make_str("sub/local.txt"), make_str("local.txt"), 0, 1, 1), 33,
      "a nested .gitignore applies below its dir");
    assert_eq(git_status_for_sub(ictx, make_str("local.txt"), make_str("local.txt"), 0, 1, 1), 63,
      "... and not above it");
    assert_eq(git_status_for_sub(ictx, make_str("build"), make_str("build"), 1, 1, 1), 46,
      "a dir holding a tracked file stays '.'");
    assert_eq(git_status_for_sub(ictx, make_str("build/out.o"), make_str("out.o"), 0, 1, 1), 33,
      "inside an excluded dir: ignored, and build/.gitignore's !out.o cannot re-include");
    assert_eq(git_status_for_sub(ictx, make_str("build/keep.log"), make_str("keep.log"), 0, 1, 1), 33,
      "inside an excluded dir the root !keep.log cannot re-include either");
    assert_eq(git_status_for_sub(ictx, make_str("build/keep.txt"), make_str("keep.txt"), 0, 1, 1), 46,
      "tracked beats ignored");
    assert_eq(git_status_for_sub(ictx, make_str("x.tmp"), make_str("x.tmp"), 0, 1, 1), 33, "a base list applies");
    assert_eq(git_status_for_sub(ictx, make_str("root.log"), make_str("root.log"), 0, 1, 1), 33,
      "the .gitignore outranks a base list's negation");
    assert_eq(git_status_for_sub(ictx, make_str(".git"), make_str(".git"), 1, 1, 1), 32, ".git: no status");
    assert_eq(git_status_for_sub(ictx, make_str(".git/HEAD"), make_str("HEAD"), 0, 1, 1), 32,
      "inside .git: no status");
    assert_eq(git_status_for_sub(ictx, make_str("v/.git/x"), make_str("x"), 0, 1, 1), 32, "a nested .git too");
    assert_eq(git_status_for_sub(ictx, make_str(".github"), make_str(".github"), 1, 1, 1), 63,
      ".github is not .git");
    var bctx = mk_ctx(pr_p, pr_m, pr_s, "build/\n", "build");
    assert_eq(git_status_for_root(bctx, make_str("build"), 1, 1, 1), 46, "listing root build/: tracked inside");
    var octx = mk_ctx(vec_new(), vec_new(), vec_new(), "out/\n", "out");
    assert_eq(git_status_for_root(octx, make_str("out"), 1, 1, 1), 33,
      "an excluded listing root is '!' (v1.3.3 exempted dirs)");
    assert_eq(git_status_for(octx, make_str("x"), 0, 1, 1), 33, "... and its contents inherit it");
    var rctx = mk_ctx(vec_new(), vec_new(), vec_new(), "*\n", "");
    assert_eq(git_status_for_root(rctx, make_str("."), 1, 1, 1), 63, "the worktree root itself is never ignored");

    #ifndef CYRIUS_TARGET_AGNOS
    test_group("ownership and safe.directory (v1.5.0)");
    assert_eq(_git_owned("."), 1, "the checkout is the user's");
    if (sys_geteuid() != 0) {
        assert_eq(_git_owned("/usr"), 0, "/usr is root's, not the user's");
    }
    assert_eq(_git_owned("/no/such/dir"), 0, "a missing path is not owned");
    var own_sv = vec_new();
    vec_push(own_sv, "/srv/repo");
    assert_eq(_git_safe_match(own_sv, "/srv/repo"), 1, "exact path");
    assert_eq(_git_safe_match(own_sv, "/srv/repo/"), 1, "trailing slash ignored");
    assert_eq(_git_safe_match(own_sv, "/srv/repo2"), 0, "not a prefix match");
    var sv2 = vec_new();
    vec_push(sv2, "/srv/*");
    assert_eq(_git_safe_match(sv2, "/srv/a/b"), 1, "<path>/* covers repositories below");
    assert_eq(_git_safe_match(sv2, "/srv"), 1, "<path>/* covers <path> itself");
    assert_eq(_git_safe_match(sv2, "/srvx/a"), 0, "<path>/* is a directory prefix, not a string prefix");
    var sv3 = vec_new();
    vec_push(sv3, "*");
    vec_push(sv3, "");
    assert_eq(_git_safe_match(sv3, "/any"), 0, "an empty value resets an earlier *");
    vec_push(sv3, "*");
    assert_eq(_git_safe_match(sv3, "/any"), 1, "... and a later * sets it again");
    #endif

    test_group("gitcfg");
    var gv = vec_new();
    var gc1 = "[core]\n\texcludesFile = ~/.gi  # c\n[Core]\n  ExcludesFile=\"/a b\" ; x\n";
    gitcfg_values(gc1, strlen(gc1), "core", "excludesfile", gv);
    assert_eq(vec_len(gv), 2, "two values, case-insensitive section and key");
    assert_eq(streq(vec_get(gv, 0), "~/.gi"), 1, "trailing comment and spaces dropped");
    assert_eq(streq(vec_get(gv, 1), "/a b"), 1, "quoted value keeps its space");
    var gv2 = vec_new();
    var gc2 = "[core \"x\"]\nexcludesfile = no\n[core.y]\nexcludesfile = no\n[safe]\ndirectory = *\ndirectory =\n";
    gitcfg_values(gc2, strlen(gc2), "core", "excludesfile", gv2);
    assert_eq(vec_len(gv2), 0, "subsections never match");
    var gv3 = vec_new();
    gitcfg_values(gc2, strlen(gc2), "safe", "directory", gv3);
    assert_eq(vec_len(gv3), 2, "multi-valued key, in order");
    assert_eq(strlen(vec_get(gv3, 1)), 0, "an empty value is kept (it resets safe.directory)");
    var gv4 = vec_new();
    var gc4 = "[core] excludesfile = a\\\n  b\n[x]\nk\n";
    gitcfg_values(gc4, strlen(gc4), "core", "excludesfile", gv4);
    assert_eq(streq(vec_get(gv4, 0), "a  b"), 1, "key on the header line; backslash-newline continues");
    var gv5 = vec_new();
    gitcfg_values(gc4, strlen(gc4), "x", "k", gv5);
    assert_eq(streq(vec_get(gv5, 0), "true"), 1, "a bare key is boolean true");

    test_group("_git_listing_rel");
    # Equal abs paths → empty rel
    var rel1 = _git_listing_rel("/home/macro/Repos/darshini", "/home/macro/Repos/darshini");
    assert_eq(str_len(rel1), 0, "equal paths -> ''");
    # Listing is subdir of repo → strip prefix + leading slash
    var rel2 = _git_listing_rel("/home/macro/Repos/darshini", "/home/macro/Repos/darshini/src");
    assert_eq(str_eq(rel2, make_str("src")), 1, "subdir 'src' -> 'src'");
    var rel3 = _git_listing_rel("/home/macro/Repos/darshini", "/home/macro/Repos/darshini/docs/adr");
    assert_eq(str_eq(rel3, make_str("docs/adr")), 1, "nested subdir -> 'docs/adr'");
    # Non-matching prefix → empty rel
    var rel4 = _git_listing_rel("/home/macro/Repos/darshini", "/tmp/elsewhere");
    assert_eq(str_len(rel4), 0, "non-matching prefix -> ''");

    # ============================================================
    # M8 — mime detection
    # ============================================================

    test_group("d_basename");
    assert_eq(str_eq(d_basename("a/b/c.txt"), make_str("c.txt")), 1, "a/b/c.txt -> c.txt");
    assert_eq(str_eq(d_basename("docs/"), make_str("docs")), 1, "trailing / ignored");
    assert_eq(str_eq(d_basename("plain"), make_str("plain")), 1, "no slash -> itself");
    assert_eq(str_eq(d_basename("/"), make_str("/")), 1, "/ stays /");
    assert_eq(str_eq(d_basename("./-x"), make_str("-x")), 1, "./-x -> -x");

    test_group("classify_indicator");
    assert_eq(classify_indicator(0x41ED), 47, "dir -> '/'");
    assert_eq(classify_indicator(0xA1FF), 64, "symlink -> '@'");
    assert_eq(classify_indicator(0x11A4), 124, "fifo -> '|'");
    assert_eq(classify_indicator(0xC1ED), 61, "socket -> '='");
    assert_eq(classify_indicator(0x81ED), 42, "exec regular -> '*'");
    assert_eq(classify_indicator(0x8148), 42, "group/other exec only -> '*'");
    assert_eq(classify_indicator(0x81A4), 0, "plain regular -> none");
    assert_eq(classify_indicator(0x61B0), 0, "block device -> none");

    test_group("_mime_for_inode");
    var mime_dir  = _mime_for_inode(0x41ED);          # dir 0755
    var mime_lnk  = _mime_for_inode(0xA1FF);          # symlink
    var mime_reg  = _mime_for_inode(0x81A4);          # regular file
    var mime_fifo = _mime_for_inode(0x11A4);          # fifo
    var mime_sock = _mime_for_inode(0xC1A4);          # socket
    var mime_blk  = _mime_for_inode(0x61A4);          # block dev
    var mime_chr  = _mime_for_inode(0x21A4);          # char dev
    assert_eq(streq(mime_dir, "inode/directory"), 1, "dir -> inode/directory");
    assert_eq(streq(mime_lnk, "inode/symlink"), 1, "symlink -> inode/symlink");
    assert_eq(mime_reg, 0, "regular -> 0 (fall through)");
    assert_eq(streq(mime_fifo, "inode/fifo"), 1, "fifo");
    assert_eq(streq(mime_sock, "inode/socket"), 1, "socket");
    assert_eq(streq(mime_blk, "inode/blockdevice"), 1, "blkdev");
    assert_eq(streq(mime_chr, "inode/chardevice"), 1, "chrdev");

    test_group("_mime_for_filename");
    # Exact matches fire
    assert_eq(streq(_mime_for_filename(make_str("Makefile")), "text/x-makefile"), 1, "Makefile exact");
    assert_eq(streq(_mime_for_filename(make_str("Dockerfile")), "text/x-dockerfile"), 1, "Dockerfile exact");
    assert_eq(streq(_mime_for_filename(make_str("LICENSE")), "text/plain"), 1, "LICENSE exact");
    # NON-prefix per ADR 0003 — README.md must fall through (return 0)
    assert_eq(_mime_for_filename(make_str("CHANGELOG.md")), 0, "CHANGELOG.md does NOT match prefix");
    assert_eq(_mime_for_filename(make_str("README.txt")), 0, "README.txt does NOT match prefix");
    assert_eq(_mime_for_filename(make_str("Makefile.in")), 0, "Makefile.in does NOT match (longer)");

    test_group("_mime_for_ext");
    assert_eq(streq(_mime_for_ext("md"), "text/markdown"), 1, "md -> text/markdown");
    assert_eq(streq(_mime_for_ext("cyr"), "application/x-cyrius"), 1, "cyr -> application/x-cyrius");
    assert_eq(streq(_mime_for_ext("py"), "text/x-python"), 1, "py -> text/x-python");
    assert_eq(streq(_mime_for_ext("json"), "application/json"), 1, "json");
    assert_eq(streq(_mime_for_ext("png"), "image/png"), 1, "png");
    assert_eq(streq(_mime_for_ext("pdf"), "application/pdf"), 1, "pdf");
    assert_eq(_mime_for_ext("xyzunknown"), 0, "unknown ext -> 0");
    assert_eq(_mime_for_ext(0), 0, "null ext -> 0");

    test_group("_mime_for_magic_bytes");
    var mbuf = alloc(16);
    # ELF: 7f 45 4c 46
    store8(mbuf + 0, 0x7f); store8(mbuf + 1, 0x45);
    store8(mbuf + 2, 0x4c); store8(mbuf + 3, 0x46);
    assert_eq(streq(_mime_for_magic_bytes(mbuf, 4), "application/x-executable"), 1, "ELF magic");
    # PNG: 89 50 4e 47
    store8(mbuf + 0, 0x89); store8(mbuf + 1, 0x50);
    store8(mbuf + 2, 0x4e); store8(mbuf + 3, 0x47);
    assert_eq(streq(_mime_for_magic_bytes(mbuf, 4), "image/png"), 1, "PNG magic");
    # JPEG: ff d8 ff
    store8(mbuf + 0, 0xff); store8(mbuf + 1, 0xd8);
    store8(mbuf + 2, 0xff);
    assert_eq(streq(_mime_for_magic_bytes(mbuf, 3), "image/jpeg"), 1, "JPEG magic");
    # PDF: 25 50 44 46 2d
    store8(mbuf + 0, 0x25); store8(mbuf + 1, 0x50);
    store8(mbuf + 2, 0x44); store8(mbuf + 3, 0x46);
    store8(mbuf + 4, 0x2d);
    assert_eq(streq(_mime_for_magic_bytes(mbuf, 5), "application/pdf"), 1, "PDF magic");
    # Shebang: 23 21
    store8(mbuf + 0, 0x23); store8(mbuf + 1, 0x21);
    assert_eq(streq(_mime_for_magic_bytes(mbuf, 2), "application/x-shellscript"), 1, "shebang magic");
    # gzip: 1f 8b
    store8(mbuf + 0, 0x1f); store8(mbuf + 1, 0x8b);
    assert_eq(streq(_mime_for_magic_bytes(mbuf, 2), "application/gzip"), 1, "gzip magic");
    # Insufficient length → 0
    assert_eq(_mime_for_magic_bytes(mbuf, 1), 0, "len<2 magic -> 0");
    assert_eq(_mime_for_magic_bytes(mbuf, 0), 0, "len=0 magic -> 0");
    # Bytes that match nothing
    store8(mbuf + 0, 0xab); store8(mbuf + 1, 0xcd);
    store8(mbuf + 2, 0xef); store8(mbuf + 3, 0x00);
    assert_eq(_mime_for_magic_bytes(mbuf, 4), 0, "random bytes -> 0");

    test_group("mime_for_entry (full chain)");
    # Directory mode → inode/directory regardless of name.
    var dir_mode = 0x41ED;
    assert_eq(streq(mime_for_entry("/tmp", make_str("foo.md"), dir_mode), "inode/directory"), 1,
      "dir mode beats ext");
    # Regular file with known extension → extension lookup.
    var reg_mode = 0x81A4;
    assert_eq(streq(mime_for_entry("/nonexistent", make_str("README.md"), reg_mode), "text/markdown"), 1,
      "README.md ext lookup");
    assert_eq(streq(mime_for_entry("/nonexistent", make_str("main.cyr"), reg_mode), "application/x-cyrius"), 1,
      "main.cyr ext lookup");
    # Exact filename match wins over (missing) ext lookup.
    assert_eq(streq(mime_for_entry("/nonexistent", make_str("Makefile"), reg_mode), "text/x-makefile"), 1,
      "Makefile exact-filename");
    # Executable bit on regular file with no known extension → x-executable.
    var exec_mode = 0x81ED;       # 0755 regular
    assert_eq(streq(mime_for_entry("/nonexistent", make_str("randomtool"), exec_mode), "application/x-executable"), 1,
      "executable bit set + no ext -> x-executable");
    # Regular non-executable + unknown ext + path doesn't exist (magic open fails) → octet-stream
    assert_eq(streq(mime_for_entry("/nonexistent", make_str("foo.xyzunknown"), reg_mode), "application/octet-stream"), 1,
      "unknown ext + magic-open-fails -> octet-stream");
    # v1.4.1: in mime/default.cyml since M8, missing from the baked table.
    assert_eq(streq(mime_for_entry("/nonexistent", make_str("sheet.xlsx"), reg_mode),
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"), 1, "xlsx ext lookup");
    # A real magic hit through the hardened probe (non-blocking, fstat-checked):
    # the build output is an ELF with no extension and (in the test) no exec bit.
    assert_eq(_mime_probe_magic("build/darshini") != 0, 1, "probe reads a real file");
    assert_eq(_mime_probe_magic("/dev/null"), 0, "probe refuses a character device");
    assert_eq(_mime_probe_magic("."), 0, "probe refuses a directory");

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
