# darshini — filesystem walking.
#
# Stats a user-supplied path, discriminates dir / non-dir / error,
# and (for directories) reads entries via lib/fs.cyr's dir_list
# wrapper around getdents64. Returns explicit negative-errno on
# stat failure so the caller can render the right message
# (ENOENT vs EACCES vs other).
#
# Pure walk — no sorting, no rendering. Composes with render.cyr
# and long.cyr.

# POSIX mode bits. Cyrius stdlib doesn't define these (yet) — we
# carry them locally rather than guess at the right shared home.
# When stdlib grows a stat.cyr these can be folded out.
enum ModeBit {
    S_IFMT  = 0xF000;
    S_IFREG = 0x8000;
    S_IFDIR = 0x4000;
    S_IFLNK = 0xA000;
    S_IFIFO = 0x1000;
    S_IFSOCK = 0xC000;
    S_IFBLK = 0x6000;
    S_IFCHR = 0x2000;
    S_ISUID = 0x0800;
    S_ISGID = 0x0400;
    S_ISVTX = 0x0200;
    S_IRUSR = 0x0100;
    S_IWUSR = 0x0080;
    S_IXUSR = 0x0040;
    S_IRGRP = 0x0020;
    S_IWGRP = 0x0010;
    S_IXGRP = 0x0008;
    S_IROTH = 0x0004;
    S_IWOTH = 0x0002;
    S_IXOTH = 0x0001;
}

# x86_64 lstat(2) — syscall 6 — does NOT follow symlinks (unlike
# SYS_STAT which the stdlib wraps as sys_stat). For `ls -l` we
# want lstat semantics so a symlink shows as `l...` with its own
# size rather than the target's. Bare number until stdlib exposes
# a portable sys_lstat wrapper.
var SYS_LSTAT_X86 = 6;

# errno values the caller discriminates on (main.cyr's per-path
# error messages). On Linux these come from the stdlib syscalls
# enum. agnos's frozen syscall floor reports a flat -1 on failure
# (NOT -errno) and doesn't define them, so provide them here for the
# agnos build. The values match Linux, but since an agnos stat
# failure returns -1 these equality checks never match there — every
# failure flows to the generic "cannot stat" branch, which is the
# correct graceful degradation.
#ifdef CYRIUS_TARGET_AGNOS
var ENOENT = 2;
var EACCES = 13;
#endif

# ----------------------------------------------------------------
# Portable stat/open (agnos support).
# ----------------------------------------------------------------
# Linux and agnos disagree on the low-level FS syscall ABI:
#   - Linux:  sys_stat(path, statbuf)          — NUL-terminated path
#             sys_open(path, flags, mode)
#   - agnos:  sys_stat(path, pathlen, statbuf) — explicit length, no NUL
#             sys_open(name, namelen, flags)
# The stat struct-field offsets (STAT_MODE/SIZE/MTIME) are already
# per-target constants in the stdlib, so callers read fields uniformly;
# only the *call shape* differs. These wrappers hide it so the rest of
# darshini stays a single Linux-shaped code path. On Linux each is a
# transparent forward; on agnos each supplies the explicit length.
fn d_stat(cpath, buf): i64 {
#ifdef CYRIUS_TARGET_AGNOS
    return sys_stat(cpath, strlen(cpath), buf);
#else
    return sys_stat(cpath, buf);
#endif
}

# Open `cpath` read-only. Linux passes (path, O_RDONLY, mode); agnos
# passes (name, namelen, flags). O_RDONLY is 0 on both.
fn d_open_ro(cpath): i64 {
#ifdef CYRIUS_TARGET_AGNOS
    return sys_open(cpath, strlen(cpath), O_RDONLY);
#else
    return sys_open(cpath, O_RDONLY, 0);
#endif
}

# lstat `cpath` into `buf`. Linux has a dedicated lstat (syscall 6,
# no-symlink-follow). agnos's frozen floor has no lstat (and #6 is
# close!), so fall back to its single stat — symlinks resolve to their
# target's metadata there, an accepted degradation until agnos grows an
# lstat. Returns 0 / negative on failure, same as d_stat.
fn d_lstat(cpath, buf): i64 {
#ifdef CYRIUS_TARGET_AGNOS
    return sys_stat(cpath, strlen(cpath), buf);
#else
    return syscall(SYS_LSTAT_X86, cpath, buf);
#endif
}

# Stat a null-terminated path and classify the result:
#   1                — path exists, is a directory
#   0                — path exists, is not a directory (regular,
#                      symlink, fifo, socket, blockdev, chardev)
#   negative errno   — stat failed (0 - ENOENT, 0 - EACCES, etc.)
#
# Buf is stack-local — sized in **bytes** (Cyrius 6.0.1 `var
# buf[N]` is N bytes, not N i64 slots — the language guide is
# wrong; see feedback memory). STAT_BUFSZ matches the x86_64
# struct stat size in syscalls_x86_64_linux.cyr (144 bytes). M1
# is Linux x86_64 only; the aarch64 layout differs and gets
# handled in a follow-up via the Stat enum, which already
# abstracts the st_mode offset arch-cleanly.
fn classify_path(cpath): i64 {
    var buf[144];
    var rc = d_stat(cpath, &buf);
    if (rc < 0) { return rc; }
    var mode = load32(&buf + STAT_MODE);
    var fmt = mode & S_IFMT;
    if (fmt == S_IFDIR) { return 1; }
    return 0;
}

# Probe whether a directory can be opened for reading. Returns 0
# on success, negative errno on failure (typically -EACCES). The
# fd is closed immediately — this is a discriminator, not a
# resource handle. Pairs with classify_path: classify confirms
# the path exists + is a dir, then this confirms readability
# before list_dir runs. dir_list itself swallows open failures
# (silently returns an empty vec), so without this check
# permission-denied is indistinguishable from empty-dir.
fn check_dir_readable(cpath): i64 {
    var fd = d_open_ro(cpath);
    if (fd < 0) { return fd; }
    sys_close(fd);
    return 0;
}

#ifdef CYRIUS_TARGET_AGNOS
# Enumerate a directory on agnos and return a vec<Str> of entry names.
# The stdlib dir_list (lib/fs.cyr) is Linux/macOS/Windows only — it
# issues getdents64 (#217) and parses the Linux dirent layout, neither
# of which exists on agnos. agnos getdents is #29, returning packed
# `AgnosDirent` records: reclen@0 (u16, record stride), type@2,
# namelen@3 (authoritative — names are NOT NUL-terminated), ino@4,
# name@8. Directory fds are opened with AO_DIRECTORY. `.`/`..` are
# filtered here (agnos returns them like Linux does), matching the
# stdlib dir_list contract so main.cyr / tree.cyr stay target-agnostic.
fn _d_dir_list_agnos(path): i64 {
    var entries = vec_new();
    var fd = sys_open(str_data(path), str_len(path), AO_DIRECTORY);
    if (fd < 0) { return entries; }
    var buf = alloc(4096);
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents(fd, buf, 4096);
        if (n <= 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var reclen = load16(buf + pos + DIRENT_RECLEN);
                if (reclen < 1) { pos = n; }   # malformed reclen — stop, don't spin
                else {
                    var namelen = load8(buf + pos + DIRENT_NAMELEN);
                    var name = buf + pos + DIRENT_NAME;
                    # Skip "." and ".." (namelen-authoritative, no NUL).
                    var skip = 0;
                    if (namelen == 1) { if (load8(name) == 46) { skip = 1; } }
                    if (namelen == 2) { if (load8(name) == 46) { if (load8(name + 1) == 46) { skip = 1; } } }
                    if (skip == 0) {
                        var nb = alloc(namelen + 1);
                        memcpy(nb, name, namelen);
                        store8(nb + namelen, 0);
                        vec_push(entries, str_clone(str_from(nb)));
                    }
                    pos = pos + reclen;
                }
            }
        }
    }
    sys_close(fd);
    return entries;
}
#endif

# Read a directory's entries and return a vec<Str>. On Linux this wraps
# lib/fs.cyr's dir_list (getdents64); on agnos it routes to the native
# getdents(#29) enumerator above. Kept thin so the M3 column-layout
# pass can grow the return shape without breaking M1 callers. `.` and
# `..` are filtered by the underlying enumerator.
fn list_dir(path: Str): i64 {
#ifdef CYRIUS_TARGET_AGNOS
    return _d_dir_list_agnos(path);
#else
    return dir_list(path);
#endif
}

# Classify-indicator (POSIX `-F`) for a stat mode. Returns the
# trailing-byte indicator or 0 (no indicator). Suffix
# semantics:
#   /  S_IFDIR
#   *  S_IFREG with any execute bit
#   @  S_IFLNK
#   |  S_IFIFO
#   =  S_IFSOCK
# Block / char devices have no POSIX indicator; we return 0.
fn classify_indicator(mode): i64 {
    var fmt = mode & S_IFMT;
    if (fmt == S_IFDIR)  { return 47; }    # '/'
    if (fmt == S_IFLNK)  { return 64; }    # '@'
    if (fmt == S_IFIFO)  { return 124; }   # '|'
    if (fmt == S_IFSOCK) { return 61; }    # '='
    if (fmt == S_IFREG) {
        var x_bits = S_IXUSR | S_IXGRP | S_IXOTH;
        if ((mode & x_bits) != 0) { return 42; }   # '*'
    }
    return 0;
}

# Fixed display-width budget per entry when `-F` is on (1 char
# trailing indicator; 0 cost when entry's mode has no
# indicator but the column reserves the slot for alignment).
fn classify_display_width(): i64 {
    return 1;
}

# lstat a path into a caller-provided 144-byte buffer (heap or
# stack). Returns 0 on success, negative errno on failure. Used
# by long.cyr's per-entry stat collection; lstat (not stat) so
# symlinks render as `l...` with their own length rather than
# their target's metadata.
fn lstat_path(cpath, buf): i64 {
    return d_lstat(cpath, buf);
}
