# darshini — render helpers.
#
# Display-side primitives: case-insensitive ordering, in-place
# sort over a vec<Str> (stdlib introsort since v1.4.2), one-per-line
# emit, and the M2 long-format
# column formatters (permissions / size / mtime). Pure functions
# — no filesystem, no I/O dispatch (those live in walk.cyr /
# long.cyr / main.cyr).
#
# At M1 the output was plain text, one entry per line. M2 adds
# the formatters for the `-l` long format; M3 will add multi-
# column auto-layout; M4 routes the bytes through darshana for
# color. The case-insensitive comparator stays the canonical
# ordering function across all those modes.

# Return ASCII lower-case for a byte, pass-through for everything
# else. Locale-free by design — the v1.0 contract is byte-stable
# alphabetical order regardless of $LANG.
fn lower_byte(b): i64 {
    if (b >= 65) {
        if (b <= 90) { return b + 32; }
    }
    return b;
}

# Three-way compare over Str, case-insensitive on ASCII letters:
# -1 when a sorts before b, 1 when after, 0 only when identical. The
# listing order — the v1.0 byte-stable, locale-free contract.
#
# Names equal under case folding ("README" / "readme") are ordered by
# their raw bytes, uppercase first (v1.4.1). That makes this a STRICT
# total order on distinct names, which is what lets sort_entries use
# the stdlib's unstable introsort (v1.4.2): no two entries of one
# directory ever compare equal, so the order cannot depend on how the
# sort breaks ties. Through v1.4.0 case-only collisions compared equal
# and kept getdents order.
fn _str_cmp_ci(a: Str, b: Str): i64 {
    var ad = str_data(a);
    var al = str_len(a);
    var bd = str_data(b);
    var bl = str_len(b);
    var minlen = al;
    if (bl < minlen) { minlen = bl; }
    var i = 0;
    while (i < minlen) {
        var x = lower_byte(load8(ad + i));
        var y = lower_byte(load8(bd + i));
        if (x != y) {
            if (x < y) { return 0 - 1; }
            return 1;
        }
        i = i + 1;
    }
    if (al < bl) { return 0 - 1; }
    if (al > bl) { return 1; }
    # Same length, equal ignoring case: the first differing raw byte.
    i = 0;
    while (i < al) {
        var rx = load8(ad + i);
        var ry = load8(bd + i);
        if (rx != ry) {
            if (rx < ry) { return 0 - 1; }
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# Strict less-than over the same order: 1 if a < b, else 0.
fn str_lt_ci(a: Str, b: Str): i64 {
    if (_str_cmp_ci(a, b) < 0) { return 1; }
    return 0;
}

# Sort a vec<Str> in place by `_str_cmp_ci`. Caller contract unchanged
# since v1.0: takes a vec<Str>, sorts in place, returns 0.
#
# v1.4.2: the stdlib's `vec_sort_by` (cycc 6.5.4) — introsort with an
# insertion-sort cutoff and an O(n) already-sorted pre-scan, O(n log n)
# worst case, and NO allocation. darshini's own hybrid merge sort
# (v1.1.0, insertion leaves since v1.1.2) needed an n-slot scratch vec
# per call that the bump allocator never reclaimed — one per directory
# under `-T`. The stdlib sort is unstable, which was the blocker; the
# total order above removes it. Verified byte-identical against the
# v1.4.1 merge sort across the A/B matrix.
fn sort_entries(entries): i64 {
    vec_sort_by(entries, &_str_cmp_ci);
    return 0;
}

# Emit one Str per line to stdout. Equivalent to a ls(1) -1 column.
#
# Decoration vecs (`colors` / `icons` / `gitchrs` / `classifies`):
# non-zero means "decorate"; passing 0 disables that decoration. The
# `-F` indicator cell is not padded here (nothing follows the name).
fn print_entries(entries, colors, icons, gitchrs, classifies): i64 {
    var i = 0;
    var n = vec_len(entries);
    var icon_pad = 0;
    if (icons != 0)      { icon_pad = icon_display_width(); }
    var git_pad = 0;
    if (gitchrs != 0)    { git_pad = git_display_width(); }
    var cls_pad = 0;
    while (i < n) {
        var s = vec_get(entries, i);
        var c = 0;
        if (colors != 0)     { c = vec_get(colors, i); }
        var ic = 0;
        if (icons != 0)      { ic = vec_get(icons, i); }
        var gc = 0;
        if (gitchrs != 0)    { gc = vec_get(gitchrs, i); }
        var cl = 0;
        if (classifies != 0) { cl = vec_get(classifies, i); }
        emit_decorated(s, c, ic, icon_pad, gc, git_pad, cl, cls_pad);
        d_write(STDOUT_FD, "\n", 1);
        i = i + 1;
    }
    return 0;
}

# ================================================================
# M2 long-format formatters.
# ================================================================
# Each writes ASCII bytes to a caller-provided buffer and returns
# the number of bytes written. Variable-width outputs (sizes) use
# the return value for alignment; fixed-width outputs (perms,
# mtime) ignore it but the contract is the same.

# Render the 10-char permission string into buf, ls -l shape:
# `drwxr-xr-x`. Always writes exactly 10 bytes. Returns 10.
# Setuid (s/S), setgid (s/S), and sticky (t/T) bits land in the
# usual ls positions — uppercase when the underlying execute bit
# is clear (suid-without-x is unusual but valid; ls renders it
# distinctly).
fn format_perms(mode, buf): i64 {
    var fmt = mode & S_IFMT;
    var type_ch = 45;          # '-'
    if (fmt == S_IFDIR)  { type_ch = 100; }   # 'd'
    if (fmt == S_IFLNK)  { type_ch = 108; }   # 'l'
    if (fmt == S_IFIFO)  { type_ch = 112; }   # 'p'
    if (fmt == S_IFSOCK) { type_ch = 115; }   # 's'
    if (fmt == S_IFBLK)  { type_ch = 98;  }   # 'b'
    if (fmt == S_IFCHR)  { type_ch = 99;  }   # 'c'
    store8(buf, type_ch);
    # User triple.
    var u_r = 45;  if ((mode & S_IRUSR) != 0) { u_r = 114; }  # 'r'
    var u_w = 45;  if ((mode & S_IWUSR) != 0) { u_w = 119; }  # 'w'
    var u_x = 45;
    if ((mode & S_IXUSR) != 0) { u_x = 120; }                 # 'x'
    if ((mode & S_ISUID) != 0) {
        u_x = 83;                                              # 'S' (no exec)
        if ((mode & S_IXUSR) != 0) { u_x = 115; }              # 's'
    }
    store8(buf + 1, u_r);
    store8(buf + 2, u_w);
    store8(buf + 3, u_x);
    # Group triple.
    var g_r = 45;  if ((mode & S_IRGRP) != 0) { g_r = 114; }
    var g_w = 45;  if ((mode & S_IWGRP) != 0) { g_w = 119; }
    var g_x = 45;
    if ((mode & S_IXGRP) != 0) { g_x = 120; }
    if ((mode & S_ISGID) != 0) {
        g_x = 83;
        if ((mode & S_IXGRP) != 0) { g_x = 115; }
    }
    store8(buf + 4, g_r);
    store8(buf + 5, g_w);
    store8(buf + 6, g_x);
    # Other triple.
    var o_r = 45;  if ((mode & S_IROTH) != 0) { o_r = 114; }
    var o_w = 45;  if ((mode & S_IWOTH) != 0) { o_w = 119; }
    var o_x = 45;
    if ((mode & S_IXOTH) != 0) { o_x = 120; }
    if ((mode & S_ISVTX) != 0) {
        o_x = 84;                                              # 'T' (no exec)
        if ((mode & S_IXOTH) != 0) { o_x = 116; }              # 't'
    }
    store8(buf + 7, o_r);
    store8(buf + 8, o_w);
    store8(buf + 9, o_x);
    return 10;
}

# Render `size` as a plain decimal byte count. Writes the digits
# left-to-right starting at buf; returns the count. Handles 0
# explicitly. Negative sizes shouldn't occur on stat output but
# are clamped to 0 for safety.
fn format_size_decimal(size, buf): i64 {
    if (size < 0) { size = 0; }
    if (size == 0) {
        store8(buf, 48);
        return 1;
    }
    var tmp[24];
    var ti = 0;
    var n = size;
    while (n > 0) {
        store8(&tmp + ti, 48 + n % 10);
        n = n / 10;
        ti = ti + 1;
    }
    var i = 0;
    while (i < ti) {
        store8(buf + i, load8(&tmp + ti - 1 - i));
        i = i + 1;
    }
    return ti;
}

# Render `size` as a human-readable string in IEC-style 1024-based
# buckets: < 1K stays decimal; otherwise X.YK / X.YM / X.YG / X.YT /
# X.YP / X.YE. Returns bytes written. One decimal place when size >=
# 1024, TRUNCATED (1048575 is `1023.9K`) — `ls -h` rounds up and would
# print `1.0M`; the truncating form is the v1.0 contract. Sub-1K is
# integer with no suffix (so a `1` byte file shows as `1`, like ls).
#
# v1.4.1: the tenths digit was `(size * 10 / scale) % 10`, and `size *
# 10` overflows i64 above ~9.2e17 — a 922337203685477581-byte sparse
# file rendered `838860.)T`. It is now taken from the remainder (below),
# which cannot overflow. P and E were added at the same time; through v1.4.0
# a 1 PiB file read `1024.0T`.
fn format_size_human(size, buf): i64 {
    if (size < 0) { size = 0; }
    if (size < 1024) { return format_size_decimal(size, buf); }
    var unit_ch = 75;             # 'K'
    var scale = 1024;
    if (size >= 1048576) {        # 1024^2
        unit_ch = 77;             # 'M'
        scale = 1048576;
    }
    if (size >= 1073741824) {     # 1024^3
        unit_ch = 71;             # 'G'
        scale = 1073741824;
    }
    if (size >= 1099511627776) {  # 1024^4
        unit_ch = 84;             # 'T'
        scale = 1099511627776;
    }
    if (size >= 1125899906842624) {      # 1024^5
        unit_ch = 80;                    # 'P'
        scale = 1125899906842624;
    }
    if (size >= 1152921504606846976) {   # 1024^6
        unit_ch = 69;                    # 'E'
        scale = 1152921504606846976;
    }
    var whole = size / scale;
    # floor(10 * r / scale), as floor(5 * r / (scale / 2)): exact, since
    # scale is a power of two, and 5 * r < 5 * 2^60 stays inside i64.
    var frac10 = (5 * (size % scale)) / (scale / 2);
    var n = format_size_decimal(whole, buf);
    store8(buf + n, 46);          # '.'
    store8(buf + n + 1, 48 + frac10);
    store8(buf + n + 2, unit_ch);
    return n + 3;
}

# Render mtime epoch seconds as `YYYY-MM-DD HH:MM` (16 bytes). UTC by
# default — locale-free per the v1.0 contract, stable across machines,
# deterministic in tests; the user's zone with `--local-time` (v1.6.0,
# tz.cyr). The seconds component is dropped to match ls(1) -l widths.
#
# v1.6.0: the civil date comes from Howard Hinnant's constant-time
# algorithm (`civil_from_days`, tz.cyr) instead of chrono's
# `epoch_to_date`. That retires three workarounds at once:
#   * pre-1970 mtimes render as dates. epoch_to_date drove negative
#     times into negative month/day components (v1.3.2 measured
#     `1970-01-\xD4+ /.:00` for a 1960 mtime), so v1.3.2 showed the
#     `????` placeholder for every one; `ls -l` shows the date.
#   * epoch_to_date looped once per year (a 9e18 mtime: ~19 minutes per
#     entry, v1.4.1); this is O(1).
#   * the v1.3.3 pin on chrono's private DateTime layout (DT_YEAR...)
#     has nothing left to pin.
# What stays is v1.4.1's bound: the field has four year digits, and
# `_chrono_w4` writes `48 + year / 1000` through store8, so a five-digit
# year would emit a raw control byte (ESC 7 / ESC 8 at year ~235,700 —
# terminal injection through a hostile tar's timestamps). Anything
# outside 0000-01-01 .. 9999-12-31 (after the zone offset) renders the
# placeholder.
var _mtime_local = 0;

fn set_mtime_local(v): i64 {
    _mtime_local = v;
    return 0;
}

fn _mtime_placeholder(buf): i64 {
    memcpy(buf, "????-??-?? ??:??", 16);
    return 16;
}

fn format_mtime(epoch, buf): i64 {
    # A day of margin either side keeps the offset addition far from i64
    # overflow; the exact bounds are checked after it.
    if (epoch > 253402387199) { return _mtime_placeholder(buf); }
    if (epoch < 0 - 62167305600) { return _mtime_placeholder(buf); }
    var t = epoch;
    if (_mtime_local == 1) { t = epoch + tz_offset(epoch); }
    if (t > 253402300799) { return _mtime_placeholder(buf); }     # 9999-12-31 23:59:59
    if (t < 0 - 62167219200) { return _mtime_placeholder(buf); }  # 0000-01-01 00:00:00
    var days = _tz_fdiv(t, 86400);
    var secs = t - days * 86400;
    var ymd[24];
    civil_from_days(days, &ymd);
    _chrono_w4(buf, 0, load64(&ymd));
    store8(buf + 4, 45);                       # '-'
    _chrono_w2(buf, 5, load64(&ymd + 8));
    store8(buf + 7, 45);                       # '-'
    _chrono_w2(buf, 8, load64(&ymd + 16));
    store8(buf + 10, 32);                      # ' '
    _chrono_w2(buf, 11, secs / 3600);
    store8(buf + 13, 58);                      # ':'
    _chrono_w2(buf, 14, (secs % 3600) / 60);
    return 16;
}
