# darshini — pure argv helpers.
#
# Split out of main.cyr at v1.4.1 so the test suite can include them:
# main.cyr ends in a top-level `main()` call, so a test file cannot
# include it, and through v1.4.0 tests/darshini.tcyr carried a COPY of
# `_parse_pos_int` — which is how the copy's overflow behavior and the
# real one could drift apart unnoticed. No I/O here; parse_cli (main.cyr)
# does the writing.

# Long-form flag string compare. cstr `arg` against literal `lit`.
# Returns 1 on exact match (both null-terminated and same length),
# else 0. Used for `--no-color` etc — short of writing a real getopt-
# long, this keeps the long-flag handling explicit + searchable.
fn _arg_eq(arg, lit): i64 {
    var i = 0;
    while (1 == 1) {
        var a = load8(arg + i);
        var l = load8(lit + i);
        if (a != l) { return 0; }
        if (a == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Parse a positive integer from a cstr. Returns the value on success
# or -1 on parse failure: empty, a non-digit (no sign, no whitespace),
# or a value above 2^31 - 1. Used by --level.
#
# v1.4.1: the bound. Through v1.4.0 the comment promised -1 on
# overflow and the code had no check, so `--level 18446744073709551617`
# wrapped to 1 and was silently accepted. A depth past 2^31 means
# "unlimited" in practice; a user who wants that omits --level.
fn _parse_pos_int(cstr): i64 {
    if (load8(cstr) == 0) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (load8(cstr + i) != 0) {
        var b = load8(cstr + i);
        if (b < 48) { return 0 - 1; }
        if (b > 57) { return 0 - 1; }
        v = v * 10 + (b - 48);
        if (v > 2147483647) { return 0 - 1; }
        i = i + 1;
    }
    return v;
}

# Long flags parse_cli recognizes.
enum LongFlag {
    LF_UNKNOWN = 0;
    LF_NO_COLOR = 1;
    LF_NO_ICONS = 2;
    LF_TREE = 3;
    LF_GIT = 4;
    LF_MIME = 5;
    LF_HELP = 6;
    LF_VERSION = 7;
    LF_LEVEL = 8;
    LF_END_OPTS = 9;
}

# Map a `--...` argument to its LongFlag. A bare `--` is LF_END_OPTS
# (v1.4.1): every later argument is a path, even one starting with
# `-` — the only way to hand darshini a glob like `*` safely when a
# name in it starts with a dash. Through v1.4.0 `--` was an unknown
# flag, so `darshini -- *` failed and `darshini *` read a file named
# `-l` as a flag (and one named `--help` as --help).
fn _long_flag_code(arg): i64 {
    if (_arg_eq(arg, "--") == 1)         { return LF_END_OPTS; }
    if (_arg_eq(arg, "--no-color") == 1) { return LF_NO_COLOR; }
    if (_arg_eq(arg, "--no-icons") == 1) { return LF_NO_ICONS; }
    if (_arg_eq(arg, "--tree") == 1)     { return LF_TREE; }
    if (_arg_eq(arg, "--git") == 1)      { return LF_GIT; }
    if (_arg_eq(arg, "--mime") == 1)     { return LF_MIME; }
    if (_arg_eq(arg, "--help") == 1)     { return LF_HELP; }
    if (_arg_eq(arg, "--version") == 1)  { return LF_VERSION; }
    if (_arg_eq(arg, "--level") == 1)    { return LF_LEVEL; }
    return LF_UNKNOWN;
}
