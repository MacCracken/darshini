# darshini — git status column (M7, `--git`).
#
# Reads the index (binary) directly, plus every ignore file git reads, to
# classify each listing entry as tracked / modified / untracked /
# ignored. Per CLAUDE.md hard rule: NO `git` subprocess — every byte
# comes from open + read against the on-disk files. The rules are git's,
# reimplemented and verified against `git check-ignore` (ADR 0005).
#
# Status chars (per-entry, single char):
#   '.' (46) — tracked, clean (stat matches index; a submodule whose
#              checked-out HEAD is the recorded commit)
#   'M' (77) — tracked, modified (mtime_sec or size differs; a submodule
#              whose HEAD moved)
#   '?' (63) — untracked, not ignored
#   '!' (33) — ignored (a pattern excludes it, or a directory above it)
#   ' ' (32) — no status: `.git` and anything inside it (not part of the
#              worktree), a submodule HEAD that cannot be resolved, or
#              an entry whose lstat failed
#
# Scope (v1.5.0, ADR 0005):
#   - Index v2–v4, SHA-1 or SHA-256; an index that exists but cannot be
#     used declines the context (no column) rather than lie.
#   - Ignore rules: git's gitignore(5) via src/ignore.cyr, from every
#     directory's `.gitignore`, `info/exclude` and `core.excludesFile`,
#     in git's precedence; an excluded directory's contents are ignored.
#   - Repositories found through a `.git` directory or a `gitdir:` file
#     (submodules, linked worktrees; `commondir`).
#   - Ownership: declined when the repository is not the user's, unless
#     `safe.directory` allows it (git's rule; Linux only).
#   - No HEAD-vs-index diff ("added/staged" shows as tracked) and no
#     per-subtree dirty aggregation for directories.
#   - Second-precision mtime check; comparing nanoseconds would
#     false-flag clean files on filesystems that report 0.

# ================================================================
# Endian + path helpers
# ================================================================

# Read 32 bits big-endian from buf+off as a non-negative i64.
fn _be_u32(buf, off): i64 {
    var a = load8(buf + off + 0);
    var b = load8(buf + off + 1);
    var c = load8(buf + off + 2);
    var d = load8(buf + off + 3);
    return (a << 24) | (b << 16) | (c << 8) | d;
}

# Read 16 bits big-endian.
fn _be_u16(buf, off): i64 {
    var a = load8(buf + off + 0);
    var b = load8(buf + off + 1);
    return (a << 8) | b;
}

# v1.3.2 (P(-1)): lexically normalize an ABSOLUTE path cstr.
# Collapses runs of '/', drops '.' components, and strips any
# trailing '/' — so "/r/src/.", "/r/src/" and "/r//src" all become
# "/r/src". The filesystem root normalizes to "/".
#
# Why this exists: through v1.3.1 the listing path reached
# the repo-root walk-up un-normalized, while the walk truncates a COPY
# to locate the repo root. For "/r/src/." the probe of
# "/r/src/./.git" fails, so find_root truncates past it to "/r",
# and `_git_listing_rel` is then left computing a rel of "src/."
# against root "/r". `_git_entry_relpath` builds "src/./a.txt",
# which misses a tracked_map keyed on "src/a.txt" — so EVERY
# tracked file rendered '?' (untracked). That hit the most common
# invocation there is: bare `darshini --git` inside any repo
# subdirectory, where main.cyr supplies "." as the path.
#
# `..` components are deliberately LEFT IN PLACE: resolving them
# lexically would rewrite "/a/link/.." to "/a" when `link` points into
# a different repo. Since v1.4.1 this only matters on the fallback
# path — `_git_physical` asks the kernel for the real directory first.
fn _git_normalize_abs(p): i64 {
    var plen = strlen(p);
    var out = alloc(plen + 2);
    var w = 0;
    var i = 0;
    # Hoisted: the loop body must not declare a `var` it re-enters,
    # per the Cyrius loop-scoping constraint in CLAUDE.md.
    var cs = 0;
    var ce = 0;
    var clen = 0;
    var skip = 0;
    var scanning = 0;
    while (i < plen) {
        if (load8(p + i) == 47) {
            i = i + 1;
        } else {
            cs = i;
            ce = i;
            scanning = 1;
            while (scanning == 1) {
                if (ce >= plen) { scanning = 0; }
                else {
                    if (load8(p + ce) == 47) { scanning = 0; }
                    else { ce = ce + 1; }
                }
            }
            clen = ce - cs;
            skip = 0;
            if (clen == 1) { if (load8(p + cs) == 46) { skip = 1; } }
            if (skip == 0) {
                store8(out + w, 47);
                w = w + 1;
                memcpy(out + w, p + cs, clen);
                w = w + clen;
            }
            i = ce;
        }
    }
    # Everything collapsed away (input was "/", "/.", "///") -> root.
    if (w == 0) { store8(out + w, 47); w = w + 1; }
    store8(out + w, 0);
    return out;
}

# Return the absolute version of a path cstr. If already
# absolute (starts with '/'), returns a normalized copy.
# Else, prepends cwd + '/' and normalizes. Doesn't resolve `..`
# or symlinks — the lexical fallback behind `_git_physical`.
fn _git_make_absolute(p): i64 {
    if (load8(p) == 47) { return _git_normalize_abs(p); }
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no getcwd (no per-process cwd in the userland ABI —
    # "CWD is userland-owned, absolute paths"). A relative listing
    # path therefore can't be anchored to a repo root, so `--git` is
    # only available when an absolute path is passed. Returning `p`
    # unchanged makes _git_discover's walk-up bail (no absolute
    # anchor) → git_open returns 0 → the column silently doesn't
    # appear, exactly as the M7 out-of-repo acceptance criterion.
    return p;
    #else
    var cwd_buf = alloc(4096);
    var n = syscall(SYS_GETCWD, cwd_buf, 4096);
    if (n <= 0) { return p; }
    var plen = strlen(p);
    var cwd_len = strlen(cwd_buf);
    var out = alloc(cwd_len + 1 + plen + 1);
    memcpy(out, cwd_buf, cwd_len);
    store8(out + cwd_len, 47);
    memcpy(out + cwd_len + 1, p, plen);
    store8(out + cwd_len + 1 + plen, 0);
    # cwd + "/" + "." is the bare-`darshini --git` case; normalize
    # before find_root sees it.
    return _git_normalize_abs(out);
    #endif
}

#ifndef CYRIUS_TARGET_AGNOS
# The kernel's absolute path for directory `dir_cstr`, or 0 if it can't
# be had: open it and read back /proc/self/fd/<fd>, which names the
# real directory with every symlink and `..` already resolved.
fn _git_dir_physical(dir_cstr): i64 {
    var fd = d_open_dir(dir_cstr);
    if (fd < 0) { return 0; }
    var lp[32];
    memcpy(&lp, "/proc/self/fd/", 14);
    var digits[24];
    var nd = 0;
    var v = fd;
    if (v == 0) { store8(&digits, 48); nd = 1; }
    while (v > 0) {
        store8(&digits + nd, 48 + v % 10);
        v = v / 10;
        nd = nd + 1;
    }
    var k = 0;
    while (k < nd) {
        store8(&lp + 14 + k, load8(&digits + nd - 1 - k));
        k = k + 1;
    }
    store8(&lp + 14 + nd, 0);
    var out = alloc(4097);
    var n = sys_readlink(&lp, out, 4096);
    sys_close(fd);
    if (n <= 0) { return 0; }
    if (n >= 4096) { return 0; }
    if (load8(out) != 47) { return 0; }
    store8(out + n, 0);
    return out;
}
#endif

# v1.4.1: the PHYSICAL absolute path of a listing path, as git sees it.
#
# Through v1.4.0 the repo-root walk-up ran on the lexical path. Any `..`
# the walk had to step past stayed in the listing's repo-relative prefix
# ("src/sub/.."), so every lookup missed and every tracked file showed
# '?' — `darshini --git ..` from two levels down, or `--git ../sibling`.
# And a symlink into another repo bound to the wrong index: from repo
# A, `darshini --git link` (link -> B/src) used A's, while `cd link;
# darshini --git` used B's. git resolves the physical cwd, so now does
# this. A directory resolves whole; for a non-directory (`-l --git
# file`), its parent resolves and the name is re-attached unresolved —
# a symlink is tracked as itself. Falls back to the lexical
# `_git_make_absolute` when /proc can't answer, and always on agnos.
fn _git_physical(p): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    var whole = _git_dir_physical(p);
    if (whole != 0) { return whole; }
    # Not a directory: split off the last component (ignoring trailing
    # '/'), resolve the parent, re-attach the name.
    var e = strlen(p);
    var trimming = 1;
    while (trimming == 1) {
        if (e > 1) {
            if (load8(p + e - 1) == 47) { e = e - 1; }
            else { trimming = 0; }
        } else { trimming = 0; }
    }
    var slash = 0 - 1;
    var i = e - 1;
    var searching = 1;
    while (searching == 1) {
        if (i < 0) { searching = 0; }
        else {
            if (load8(p + i) == 47) { slash = i; searching = 0; }
            else { i = i - 1; }
        }
    }
    var parent = ".";
    var name_off = 0;
    if (slash == 0) { parent = "/"; name_off = 1; }
    if (slash > 0) {
        parent = alloc(slash + 1);
        memcpy(parent, p, slash);
        store8(parent + slash, 0);
        name_off = slash + 1;
    }
    var nlen = e - name_off;
    if (nlen > 0) {
        var pp = _git_dir_physical(parent);
        if (pp != 0) {
            var pl = strlen(pp);
            var out = alloc(pl + 1 + nlen + 1);
            memcpy(out, pp, pl);
            var w = pl;
            if (pl > 1) { store8(out + w, 47); w = w + 1; }
            if (pl == 1) { if (load8(pp) != 47) { store8(out + w, 47); w = w + 1; } }
            memcpy(out + w, p + name_off, nlen);
            store8(out + w + nlen, 0);
            return out;
        }
    }
    #endif
    return _git_make_absolute(p);
}

# Read a small text file whole (`.git` files, HEAD, commondir), trimmed
# of trailing whitespace. Returns a fresh cstr, or 0.
fn _git_read_small(path): i64 {
    var r = _git_slurp(path, 65536);
    if (load64(r + 16) != 0) { return 0; }
    var b = load64(r);
    var n = load64(r + 8);
    var trimming = 1;
    while (trimming == 1) {
        if (n == 0) { trimming = 0; }
        else {
            var c = load8(b + n - 1);
            if (c == 10) { n = n - 1; }
            else { if (c == 13) { n = n - 1; }
            else { if (c == 32) { n = n - 1; }
            else { if (c == 9) { n = n - 1; } else { trimming = 0; } } } }
        }
    }
    store8(b + n, 0);
    return b;
}

# `rel` resolved against directory `dir`: unchanged when absolute.
fn _git_resolve(dir, rel): i64 {
    if (load8(rel) == 47) { return rel; }
    return _git_path(dir, rel);
}

# 1 when `path` stats as a directory.
fn _git_is_dir(path): i64 {
    var st[144];
    if (d_stat(path, &st) < 0) { return 0; }
    if ((load32(&st + STAT_MODE) & S_IFMT) == S_IFDIR) { return 1; }
    return 0;
}

# A repository found by `_git_discover`, 32 bytes:
#   +0 worktree  — the directory holding `.git` (cstr)
#   +8 gitdir    — the git directory: `<worktree>/.git`, or where a
#                  `gitdir:` file points
#   +16 common   — the common dir (`<gitdir>/commondir` for a linked
#                  worktree), else the gitdir: config, info/exclude, refs
#   +24 gitfile  — the `.git` file's path when there was one, else 0
#
# Walk up from `dir_abs` (an absolute cstr) to the nearest `<dir>/.git`.
# A directory is the git dir itself. A regular file must read
# `gitdir: <path>` (relative to the file's directory) and name a
# directory — a submodule or linked worktree; through v1.4.0 the walk
# stepped past it to the enclosing repository, v1.4.1 declined, v1.5.0
# follows it. Anything else at `.git` (a malformed file, a FIFO) ends the
# walk with 0: the nearest `.git` decides, so an enclosing repository's
# index is never borrowed.
fn _git_discover(dir_abs): i64 {
    var len = strlen(dir_abs);
    var buf = alloc(len + 2);
    memcpy(buf, dir_abs, len);
    store8(buf + len, 0);
    var done = 0;
    while (done == 0) {
        var cur_len = strlen(buf);
        var probe = 0;
        if (cur_len == 1) { probe = "/.git"; }
        else { probe = _git_path(buf, ".git"); }
        var stat_buf[144];
        var rc = d_stat(probe, &stat_buf);
        if (rc >= 0) {
            var fmt = load32(&stat_buf + STAT_MODE) & S_IFMT;
            var gitdir = 0;
            var gitfile = 0;
            if (fmt == S_IFDIR) { gitdir = probe; }
            if (fmt == S_IFREG) {
                var txt = _git_read_small(probe);
                if (txt == 0) { return 0; }
                if (strlen(txt) <= 8) { return 0; }
                if (memeq(txt, "gitdir: ", 8) == 0) { return 0; }
                gitdir = _git_resolve(buf, txt + 8);
                gitfile = probe;
            }
            if (gitdir == 0) { return 0; }
            if (_git_is_dir(gitdir) == 0) { return 0; }
            var common = gitdir;
            var cd = _git_read_small(_git_path(gitdir, "commondir"));
            if (cd != 0) {
                if (strlen(cd) > 0) { common = _git_resolve(gitdir, cd); }
            }
            var repo = alloc(32);
            store64(repo, buf);
            store64(repo + 8, gitdir);
            store64(repo + 16, common);
            store64(repo + 24, gitfile);
            return repo;
        }
        # Walk up — find last '/' in buf and truncate.
        if (cur_len <= 1) { done = 1; }
        else {
            var i = cur_len - 1;
            var found = 0 - 1;
            var scanning = 1;
            while (scanning == 1) {
                if (load8(buf + i) == 47) {
                    found = i;
                    scanning = 0;
                } else { if (i == 0) { scanning = 0; }
                    else { i = i - 1; } }
            }
            if (found < 0) { done = 1; }
            else {
                # v1.4.1: a '/' at index 0 means the parent IS the root;
                # keep it, so the next probe is "/.git".
                if (found == 0) { store8(buf + 1, 0); }
                else { store8(buf + found, 0); }
            }
        }
    }
    return 0;
}

# Compute the relative path from `repo_root` to `listing_abs`.
# Both must be absolute cstrs. Returns a heap-alloc'd Str (may
# be empty when listing_abs == repo_root).
fn _git_listing_rel(repo_root, listing_abs): i64 {
    var rlen = strlen(repo_root);
    var llen = strlen(listing_abs);
    if (llen < rlen) { return str_clone(str_from("")); }
    if (memeq(listing_abs, repo_root, rlen) == 0) { return str_clone(str_from("")); }
    if (llen == rlen) { return str_clone(str_from("")); }
    var off = rlen;
    if (load8(listing_abs + off) == 47) { off = off + 1; }
    var slen = llen - off;
    var buf = alloc(slen + 1);
    memcpy(buf, listing_abs + off, slen);
    store8(buf + slen, 0);
    return str_clone(str_from(buf));
}

# ================================================================
# .git/index parsing (v2 / v3 / v4)
# ================================================================

# Read git's offset-varint (index v4) at buf+pos, bounded by `len`.
# Stores the position after it at `out_pos`; returns the value, or -1
# when the varint runs off the buffer or past 2^31.
fn _git_varint(buf, pos, len, out_pos): i64 {
    if (pos >= len) { return 0 - 1; }
    var c = load8(buf + pos);
    pos = pos + 1;
    var val = c & 127;
    while ((c & 128) != 0) {
        if (pos >= len) { return 0 - 1; }
        if (val > 16777215) { return 0 - 1; }
        val = val + 1;
        c = load8(buf + pos);
        pos = pos + 1;
        val = (val << 7) + (c & 127);
    }
    store64(out_pos, pos);
    return val;
}

# The parser, for an object id of `oid_len` bytes (20 = SHA-1, 32 =
# SHA-256). Entry layout: 40 bytes of stat data, the oid, a 16-bit
# flags word (low 12 bits: name length, 0xFFF = "longer, scan for the
# NUL"), then from v3 a second 16-bit word when flags bit 0x4000 is set.
# v2/v3: the NUL-terminated name, NUL-padded to a multiple of 8.
# v4: an offset-varint count of bytes to drop from the PREVIOUS path,
# then the NUL-terminated suffix, unpadded.
#
# v1.4.1. Through v1.4.0 only v2 was accepted, and the -1 for anything
# else was ignored, so a v3 index (`git add -N`, sparse checkout) or v4
# (`feature.manyFiles`) produced a git column with every file '?'. A
# SHA-256 repository has a v2 header but 32-byte ids, so its entries
# were misread outright. The long-name branch started its NUL scan at
# 0xFFF instead of 0, so a path of 4095+ bytes ended parsing and every
# later entry showed '?'. And a name is now required to be non-empty and
# to end in a NUL where git puts one, which catches a misframed entry
# early.
# Parse with gitlink capture: when `gitlinks` is a Str-keyed map, every
# gitlink entry (mode 0160000 — a submodule) maps its path to the
# recorded commit as lowercase hex (v1.5.0).
fn _git_parse_index_oid(buf, len, oid_len, paths, mtimes, sizes): i64 {
    return _git_parse_index_full(buf, len, oid_len, paths, mtimes, sizes, 0);
}

fn _git_hex(src, n): i64 {
    var out = alloc(n * 2 + 1);
    var i = 0;
    while (i < n) {
        var b = load8(src + i);
        store8(out + i * 2, load8("0123456789abcdef" + (b >> 4)));
        store8(out + i * 2 + 1, load8("0123456789abcdef" + (b & 15)));
        i = i + 1;
    }
    store8(out + n * 2, 0);
    return out;
}

fn _git_parse_index_full(buf, len, oid_len, paths, mtimes, sizes, gitlinks): i64 {
    if (len < 12) { return 0 - 1; }
    if (load8(buf + 0) != 68) { return 0 - 1; }   # 'D'
    if (load8(buf + 1) != 73) { return 0 - 1; }   # 'I'
    if (load8(buf + 2) != 82) { return 0 - 1; }   # 'R'
    if (load8(buf + 3) != 67) { return 0 - 1; }   # 'C'
    var version = _be_u32(buf, 4);
    if (version < 2) { return 0 - 1; }
    if (version > 4) { return 0 - 1; }
    var n = _be_u32(buf, 8);
    var fixed = 42 + oid_len;              # stat data + oid + flags
    var pos = 12;
    var prev = 0;                          # v4: previous path (cstr)
    var prev_len = 0;
    var npos[8];
    var i = 0;
    while (i < n) {
        if (pos + fixed > len) { return 0 - 1; }
        var pos_entry = pos;
        var mtime_sec = _be_u32(buf, pos + 8);
        var size = _be_u32(buf, pos + 36);
        var flags = _be_u16(buf, pos + 40 + oid_len);
        var hdr = fixed;
        if (version >= 3) {
            if ((flags & 0x4000) != 0) { hdr = hdr + 2; }
        }
        if (pos + hdr > len) { return 0 - 1; }
        var name_start = pos + hdr;
        var name_buf = 0;
        var name_len = 0;
        if (version == 4) {
            var strip = _git_varint(buf, name_start, len, &npos);
            if (strip < 0) { return 0 - 1; }
            if (strip > prev_len) { return 0 - 1; }
            var sfx = load64(&npos);
            var se = sfx;
            var nul = 0;
            while (nul == 0) {
                if (se >= len) { return 0 - 1; }                  # no NUL
                if (load8(buf + se) == 0) { nul = 1; }
                else { se = se + 1; }
            }
            var keep = prev_len - strip;
            name_len = keep + (se - sfx);
            name_buf = alloc(name_len + 1);
            if (keep > 0) { memcpy(name_buf, prev, keep); }
            memcpy(name_buf + keep, buf + sfx, se - sfx);
            store8(name_buf + name_len, 0);
            pos = se + 1;
        } else {
            name_len = flags & 0xFFF;
            if (name_len == 0xFFF) {
                name_len = 0;
                var lnul = 0;
                while (lnul == 0) {
                    if (name_start + name_len >= len) { return 0 - 1; }   # no NUL
                    if (load8(buf + name_start + name_len) == 0) { lnul = 1; }
                    else { name_len = name_len + 1; }
                }
            }
            if (name_start + name_len + 1 > len) { return 0 - 1; }
            if (load8(buf + name_start + name_len) != 0) { return 0 - 1; }
            name_buf = alloc(name_len + 1);
            memcpy(name_buf, buf + name_start, name_len);
            store8(name_buf + name_len, 0);
            # Entry size: header + name + 1..8 NUL pad to a multiple of 8.
            var total = hdr + name_len + 1;
            var rem = total % 8;
            if (rem != 0) { total = total + (8 - rem); }
            pos = pos + total;
        }
        # git never writes an empty path; one here means misframing.
        if (name_len == 0) { return 0 - 1; }
        if (gitlinks != 0) {
            if ((_be_u32(buf, pos_entry + 24) & 0xF000) == 0xE000) {
                map_set(gitlinks, str_from(name_buf), _git_hex(buf + pos_entry + 40, oid_len));
            }
        }
        vec_push(paths, str_from(name_buf));
        vec_push(mtimes, mtime_sec);
        vec_push(sizes, size);
        prev = name_buf;
        prev_len = name_len;
        i = i + 1;
    }
    return 0;
}

# Parse the index buffer into three parallel vecs:
#   paths  : vec<Str>  — repo-relative path of each tracked entry
#   mtimes : vec<i64>  — index-recorded mtime_sec (u32)
#   sizes  : vec<i64>  — index-recorded size (u32)
# for a SHA-1 repository. Returns 0 on success, -1 on any malformation.
fn _git_parse_index(buf, len, paths, mtimes, sizes): i64 {
    return _git_parse_index_oid(buf, len, 20, paths, mtimes, sizes);
}

# 20 for a SHA-1 repository, 32 when the repository config sets
# `extensions.objectFormat = sha256` — the only case git writes 32-byte
# ids into the index. (v1.4.1 scanned for the two words on one line;
# v1.5.0 reads the key through gitcfg.cyr.)
fn _git_oid_len(cfg, n): i64 {
    var vals = vec_new();
    gitcfg_values(cfg, n, "extensions", "objectformat", vals);
    var v = gitcfg_last(vals);
    if (v != 0) {
        if (strlen(v) == 6) {
            var lc = alloc(7);
            var i = 0;
            while (i < 6) { store8(lc + i, lower_byte(load8(v + i))); i = i + 1; }
            store8(lc + 6, 0);
            if (streq(lc, "sha256") == 1) { return 32; }
        }
    }
    return 20;
}

# ================================================================
# GitCtx — the "loaded git state for this listing"
# ================================================================
#
# 80-byte struct. +0..+56 belong to the repository and are shared by
# every listing in it (git_open copies them); +32 is per listing.
#   +0  paths       : vec<Str> tracked repo-relative paths
#   +8  mtimes      : vec<i64> index-recorded mtime_sec, parallel
#   +16 sizes       : vec<i64> index-recorded size, parallel
#   +24 base_lists  : vec of ignore lists from outside the tree, highest
#                     precedence first: info/exclude, core.excludesFile
#   +32 listing     : Str — listing path relative to the worktree root
#   +40 tracked_map : Str → (idx + 1) into the parallel vecs (v1.1)
#   +48 dir_cell    : → cell holding the directory prefix set (v1.4.1)
#   +56 worktree    : cstr, where per-directory .gitignore files are read
#                     from (0: none are read — unit tests)
#   +64 ign_cell    : → 48-byte ignore cache (see `_git_ign_cell_new`)
#   +72 gitlinks    : Str → recorded commit hex for submodules (0: none)

fn _ctx_paths(c): i64       { return load64(c + 0); }
fn _ctx_mtimes(c): i64      { return load64(c + 8); }
fn _ctx_sizes(c): i64       { return load64(c + 16); }
fn _ctx_base_lists(c): i64  { return load64(c + 24); }
fn _ctx_listing(c): i64     { return load64(c + 32); }
fn _ctx_tracked_map(c): i64 { return load64(c + 40); }
fn _ctx_dir_cell(c): i64    { return load64(c + 48); }
fn _ctx_worktree(c): i64    { return load64(c + 56); }
fn _ctx_ign_cell(c): i64    { return load64(c + 64); }
fn _ctx_gitlinks(c): i64    { return load64(c + 72); }

# The ignore cache, 48 bytes, shared by every context over one index:
#   +0  dirinfo : Str dir → dirinfo record (see `_git_dirinfo`)
#   +8  lists   : Str dir → that directory's .gitignore list, or 1 for
#                 "none" (absent, a symlink, unreadable)
#   +16 last_ptr / +24 last_len / +32 last_info — the dirinfo of the last
#                 parent looked up, so siblings cost no allocation
fn _git_ign_cell_new(): i64 {
    var c = alloc(48);
    store64(c, map_new_str());
    store64(c + 8, map_new_str());
    store64(c + 16, 0);
    store64(c + 24, 0 - 1);
    store64(c + 32, 0);
    return c;
}

# Read a whole file into a heap buf. Returns a 24-byte struct
# {ptr@0, len@8, status@16}: status 0 = read (ptr/len valid), 1 = absent
# (no such file, or empty), 2 = present but unusable (unreadable, not a
# regular file, larger than `cap`, short read).
fn _git_slurp(path_cstr, cap): i64 {
    var r = alloc(24);
    store64(r, 0);
    store64(r + 8, 0);
    store64(r + 16, 1);
    # v1.3.2 (P(-1)): size from stat(2), then read to EOF.
    #
    # Through v1.3.1 this allocated the full `cap` and did ONE
    # `sys_read(fd, buf, cap)`, which had two defects. (a) A single
    # read is not guaranteed to fill the buffer; the code treated
    # whatever came back as the whole file. (b) When the file was
    # LARGER than cap, the read returned exactly cap and the parse
    # walked a truncated index — every entry past the cutoff simply
    # wasn't there, so those tracked files rendered '?' (untracked)
    # with no indication anything had been dropped.
    #
    # Now: stat first, allocate exactly the file's size, and loop
    # until EOF. `cap` is a sanity ceiling rather than a truncation
    # point. A FIFO stats with st_size 0 and is refused here; since
    # v1.4.1 the open is also non-blocking and fstat must confirm a
    # regular file, so one swapped in after the stat cannot hang us.
    var st[144];
    if (d_stat(path_cstr, &st) < 0) { return r; }
    var size = load64(&st + STAT_SIZE);
    if (size <= 0) { return r; }
    store64(r + 16, 2);
    if (size > cap) { return r; }
    var fd = d_open_data(path_cstr);
    if (fd < 0) { return r; }
    var fsz[8];
    if (d_fd_regular_size(fd, &fsz) == 0) { sys_close(fd); return r; }
    var buf = alloc(size + 1);
    var got = 0;
    var reading = 1;
    while (reading == 1) {
        var n = sys_read(fd, buf + got, size - got);
        if (n <= 0) { reading = 0; }
        else {
            got = got + n;
            if (got >= size) { reading = 0; }
        }
    }
    sys_close(fd);
    if (got < size) { return r; }
    store64(r, buf);
    store64(r + 8, got);
    store64(r + 16, 0);
    return r;
}

# `<root>/<rel>` as a fresh cstr.
fn _git_path(root, rel): i64 {
    var rlen = strlen(root);
    var nlen = strlen(rel);
    var out = alloc(rlen + 1 + nlen + 1);
    memcpy(out, root, rlen);
    store8(out + rlen, 47);
    memcpy(out + rlen + 1, rel, nlen);
    store8(out + rlen + 1 + nlen, 0);
    return out;
}

# `<root>/<rel[0..n)>` for a slice that is not NUL-terminated.
fn _git_path_n(root, rel, n): i64 {
    var rlen = strlen(root);
    var out = alloc(rlen + 1 + n + 1);
    memcpy(out, root, rlen);
    store8(out + rlen, 47);
    memcpy(out + rlen + 1, rel, n);
    store8(out + rlen + 1 + n, 0);
    return out;
}

# ================================================================
# Configuration (gitcfg.cyr does the parsing)
# ================================================================

# git's boolean for an environment value: unset or "", "0", "false",
# "no", "off" (any case) are false; anything else is true.
fn _git_env_true(v): i64 {
    if (v == 0) { return 0; }
    var n = strlen(v);
    if (n == 0) { return 0; }
    var lc = alloc(n + 1);
    var i = 0;
    while (i < n) { store8(lc + i, lower_byte(load8(v + i))); i = i + 1; }
    store8(lc + n, 0);
    if (streq(lc, "0") == 1) { return 0; }
    if (streq(lc, "false") == 1) { return 0; }
    if (streq(lc, "no") == 1) { return 0; }
    if (streq(lc, "off") == 1) { return 0; }
    return 1;
}

fn _git_cfg_push(out, path): i64 {
    var r = _git_slurp(path, 1048576);
    if (load64(r + 16) == 0) { vec_push(out, r); }
    return 0;
}

# The config files git reads, as slurp results, lowest precedence first:
# /etc/gitconfig (unless GIT_CONFIG_NOSYSTEM), $XDG_CONFIG_HOME/git/config
# (else ~/.config/git/config), ~/.gitconfig, and — unless
# `protected_only` — the repository's `<common>/config`. safe.directory
# is honored only from the protected (non-repository) files, as in git.
fn _git_cfg_bufs(common, protected_only): i64 {
    var out = vec_new();
    if (_git_env_true(getenv("GIT_CONFIG_NOSYSTEM")) == 0) { _git_cfg_push(out, "/etc/gitconfig"); }
    var home = getenv("HOME");
    var xdg = getenv("XDG_CONFIG_HOME");
    var used_xdg = 0;
    if (xdg != 0) { if (strlen(xdg) > 0) {
            _git_cfg_push(out, _git_path(xdg, "git/config"));
            used_xdg = 1;
        } }
    if (used_xdg == 0) { if (home != 0) { if (strlen(home) > 0) {
                _git_cfg_push(out, _git_path(home, ".config/git/config"));
            } } }
    if (home != 0) { if (strlen(home) > 0) { _git_cfg_push(out, _git_path(home, ".gitconfig")); } }
    if (protected_only == 0) { if (common != 0) { _git_cfg_push(out, _git_path(common, "config")); } }
    return out;
}

# Every value of section.key across `bufs`, in precedence order.
fn _git_cfg_values(bufs, section, key): i64 {
    var vals = vec_new();
    var i = 0;
    while (i < vec_len(bufs)) {
        var r = vec_get(bufs, i);
        gitcfg_values(load64(r), load64(r + 8), section, key, vals);
        i = i + 1;
    }
    return vals;
}

# A leading "~/" (or a bare "~") expanded from $HOME; 0 when it needs
# $HOME and there is none. Other paths are returned unchanged.
fn _git_expand_home(v): i64 {
    if (load8(v) != 126) { return v; }
    var nx = load8(v + 1);
    var ok = 0;
    if (nx == 0) { ok = 1; }
    if (nx == 47) { ok = 1; }
    if (ok == 0) { return v; }               # ~user/: not supported
    var home = getenv("HOME");
    if (home == 0) { return 0; }
    if (nx == 0) { return home; }
    return _git_path(home, v + 2);
}

# The core.excludesFile path: the configured value (with "~/" expanded,
# relative to the worktree root), else $XDG_CONFIG_HOME/git/ignore, else
# ~/.config/git/ignore. 0 when none can be formed.
fn _git_excludes_path(bufs, worktree): i64 {
    var v = gitcfg_last(_git_cfg_values(bufs, "core", "excludesfile"));
    if (v != 0) { if (strlen(v) > 0) {
            var e = _git_expand_home(v);
            if (e == 0) { return 0; }
            return _git_resolve(worktree, e);
        } }
    var xdg = getenv("XDG_CONFIG_HOME");
    if (xdg != 0) { if (strlen(xdg) > 0) { return _git_path(xdg, "git/ignore"); } }
    var home = getenv("HOME");
    if (home != 0) { if (strlen(home) > 0) { return _git_path(home, ".config/git/ignore"); } }
    return 0;
}

# An ignore list (base "") from a whole file, or 0 when it can't be read.
fn _git_list_from_file(path): i64 {
    var r = _git_slurp(path, 16777216);
    if (load64(r + 16) != 0) { return 0; }
    var l = _ig_list_new("", 0);
    _ig_parse(load64(r), load64(r + 8), load64(l));
    return l;
}

# ================================================================
# Ownership (git's safe.directory)
# ================================================================

#ifndef CYRIUS_TARGET_AGNOS
# 1 when `path` is owned by the effective uid — or, running as root, by
# $SUDO_UID — as git's is_path_owned_by_current_user.
fn _git_owned(path): i64 {
    var st[144];
    if (d_stat(path, &st) < 0) { return 0; }
    var uid = load32(&st + STAT_UID);
    var euid = sys_geteuid();
    if (uid == euid) { return 1; }
    if (euid == 0) {
        var su = getenv("SUDO_UID");
        if (su != 0) {
            var v = _parse_pos_int(su);
            if (v >= 0) { if (v == uid) { return 1; } }
        }
    }
    return 0;
}

# `path` without trailing '/' (but "/" stays "/"), as a fresh cstr.
fn _git_strip_slash(path): i64 {
    var n = strlen(path);
    var trimming = 1;
    while (trimming == 1) {
        if (n <= 1) { trimming = 0; }
        else { if (load8(path + n - 1) == 47) { n = n - 1; } else { trimming = 0; } }
    }
    var out = alloc(n + 1);
    memcpy(out, path, n);
    store8(out + n, 0);
    return out;
}

# git's safe.directory over `vals` (in config order): an empty value
# resets the list, "*" allows every repository, "<path>/*" every
# repository at or below <path>, any other value exactly that worktree.
fn _git_safe_match(vals, worktree): i64 {
    var wt = _git_strip_slash(worktree);
    var wl = strlen(wt);
    var safe = 0;
    var i = 0;
    while (i < vec_len(vals)) {
        var v = vec_get(vals, i);
        var vl = strlen(v);
        if (vl == 0) { safe = 0; }
        else { if (streq(v, "*") == 1) { safe = 1; }
        else {
            var e = _git_expand_home(v);
            if (e != 0) {
                var el = strlen(e);
                var star = 0;
                if (el >= 2) { if (load8(e + el - 1) == 42) { if (load8(e + el - 2) == 47) { star = 1; } } }
                if (star == 1) {
                    # "<path>/*": the worktree is <path> or below it.
                    var dirlen = el - 2;
                    if (wl >= dirlen) { if (memeq(wt, e, dirlen) == 1) {
                            if (wl == dirlen) { safe = 1; }
                            else { if (load8(wt + dirlen) == 47) { safe = 1; } }
                        } }
                } else {
                    if (streq(_git_strip_slash(e), wt) == 1) { safe = 1; }
                }
            }
        } }
        i = i + 1;
    }
    return safe;
}

# safe.directory, read from the protected (non-repository) config files.
fn _git_safe_listed(worktree): i64 {
    return _git_safe_match(_git_cfg_values(_git_cfg_bufs(0, 1), "safe", "directory"), worktree);
}

# v1.5.0: git refuses a repository that is not the user's — the `.git`
# file, the worktree root and the git dir must all be owned by the
# effective uid — unless safe.directory lists it. Without this a `.git`
# planted in a shared parent directory (`/tmp/.git`) applied to every
# other user's listings below it. Declining means no column, the same
# answer as for any unusable repository.
fn _git_ownership_ok(repo): i64 {
    var ok = 1;
    var gitfile = load64(repo + 24);
    if (gitfile != 0) { if (_git_owned(gitfile) == 0) { ok = 0; } }
    if (_git_owned(load64(repo)) == 0) { ok = 0; }
    if (_git_owned(load64(repo + 8)) == 0) { ok = 0; }
    if (ok == 1) { return 1; }
    return _git_safe_listed(load64(repo));
}
#endif

# ================================================================
# Loading
# ================================================================

# One parsed index per repository per run (v1.4.1): `darshini -l --git *`
# opens a context per argument; those in the same repository share the
# parse and differ only in their listing prefix. Keyed on the git dir
# (two linked worktrees share a common dir but not an index).
var _git_cache_key = 0;
var _git_cache_ctx = 0;

# Parse a discovered repository into a GitCtx with an empty listing
# prefix, or 0 when its index is present but unusable.
fn _git_load(repo): i64 {
    var worktree = load64(repo);
    var gitdir = load64(repo + 8);
    var common = load64(repo + 16);
    # 256 MB: a sanity ceiling, not a truncation point — _git_slurp sizes
    # its buffer from stat(2). Past it the context is declined.
    var idx_slurp = _git_slurp(_git_path(gitdir, "index"), 268435456);
    var paths = vec_new();
    var mtimes = vec_new();
    var sizes = vec_new();
    var gitlinks = map_new_str();
    # No index at all is a fresh repository: nothing tracked, a true
    # answer. One that exists but can't be read or parsed is declined.
    if (load64(idx_slurp + 16) == 2) { return 0; }
    if (load64(idx_slurp + 16) == 0) {
        var oid_len = 20;
        var lc = _git_slurp(_git_path(common, "config"), 1048576);
        if (load64(lc + 16) == 0) { oid_len = _git_oid_len(load64(lc), load64(lc + 8)); }
        var prc = _git_parse_index_full(load64(idx_slurp), load64(idx_slurp + 8), oid_len,
          paths, mtimes, sizes, gitlinks);
        if (prc < 0) { return 0; }
    }
    # Ignore sources from outside the tree, highest precedence first. The
    # per-directory .gitignore files (the root's included) load lazily.
    var base_lists = vec_new();
    var exl = _git_list_from_file(_git_path(common, "info/exclude"));
    if (exl != 0) { vec_push(base_lists, exl); }
    var xp = _git_excludes_path(_git_cfg_bufs(common, 0), worktree);
    if (xp != 0) {
        var xl = _git_list_from_file(xp);
        if (xl != 0) { vec_push(base_lists, xl); }
    }
    var tracked_map = map_new_str();
    var pi = 0;
    var pn = vec_len(paths);
    while (pi < pn) {
        map_set(tracked_map, vec_get(paths, pi), pi + 1);
        pi = pi + 1;
    }
    var cell = alloc(8);
    store64(cell, 0);
    var ctx = alloc(80);
    store64(ctx + 0, paths);
    store64(ctx + 8, mtimes);
    store64(ctx + 16, sizes);
    store64(ctx + 24, base_lists);
    store64(ctx + 32, str_clone(str_from("")));
    store64(ctx + 40, tracked_map);
    store64(ctx + 48, cell);
    store64(ctx + 56, worktree);
    store64(ctx + 64, _git_ign_cell_new());
    store64(ctx + 72, gitlinks);
    return ctx;
}

# Top-level: open the listing path's repository and build a GitCtx.
# Returns 0 — the column silently doesn't appear — when there is no
# repository above the path (the M7 acceptance criterion), when its index
# is unusable (v1.4.1), or when it is not the user's (v1.5.0).
fn git_open(listing_cstr): i64 {
    var listing_abs = _git_physical(listing_cstr);
    var repo = _git_discover(listing_abs);
    if (repo == 0) { return 0; }
    var gitdir = load64(repo + 8);
    var base = 0;
    if (_git_cache_key != 0) {
        if (streq(_git_cache_key, gitdir) == 1) { base = _git_cache_ctx; }
    }
    if (base == 0) {
        #ifndef CYRIUS_TARGET_AGNOS
        if (_git_ownership_ok(repo) == 0) { return 0; }
        #endif
        base = _git_load(repo);
        if (base == 0) { return 0; }
        _git_cache_key = gitdir;
        _git_cache_ctx = base;
    }
    var ctx = alloc(80);
    memcpy(ctx, base, 80);
    store64(ctx + 32, _git_listing_rel(load64(repo), listing_abs));
    return ctx;
}

# Build the repo-relative path for an entry: `<listing>/<name>`,
# or just `<name>` when listing is empty. Returns heap-alloc'd Str.
fn _git_entry_relpath(ctx, name): i64 {
    var l = _ctx_listing(ctx);
    var llen = str_len(l);
    var nlen = str_len(name);
    if (llen == 0) { return str_clone(name); }
    var out = alloc(llen + 1 + nlen + 1);
    memcpy(out, str_data(l), llen);
    store8(out + llen, 47);
    memcpy(out + llen + 1, str_data(name), nlen);
    store8(out + llen + 1 + nlen, 0);
    return str_clone(str_from(out));
}

# Look up an entry's repo-relative path in the tracked vec.
# Returns the slot index (>=0) on hit, -1 on miss. v1.1: O(1)
# average via the GitCtx's hashmap built at git_open time
# (was O(N) linear scan through v1.0). Map values are stored
# as `idx + 1` so the 0 sentinel maps to "not found".
fn _git_find_tracked(ctx, rel_path): i64 {
    var v = map_get(_ctx_tracked_map(ctx), rel_path);
    if (v == 0) { return 0 - 1; }
    return v - 1;
}

# Every proper directory prefix of every tracked path ("a/b/c.txt"
# contributes "a" and "a/b"), as a Str-keyed set.
#
# git keeps the index sorted by path, so a prefix the previous path
# shares has already been inserted: only the '/' positions at or past
# the common prefix with the previous path are new. That makes the
# build one insert per distinct directory instead of one per path per
# level (20k paths in 2k dirs: ~2.1k inserts, not ~40k). An unsorted
# index stays correct — it just inserts some prefixes twice.
fn _git_build_dir_set(paths): i64 {
    var m = map_new_str();
    var n = vec_len(paths);
    var prev = 0;
    var prev_len = 0;
    var i = 0;
    while (i < n) {
        var p = vec_get(paths, i);
        var pd = str_data(p);
        var pl = str_len(p);
        var common = 0;
        var cmp_on = 1;
        while (cmp_on == 1) {
            if (common >= pl) { cmp_on = 0; }
            else { if (common >= prev_len) { cmp_on = 0; }
                else { if (load8(pd + common) != load8(prev + common)) { cmp_on = 0; }
                    else { common = common + 1; } } }
        }
        var j = common;
        while (j < pl) {
            if (load8(pd + j) == 47) {
                if (j > 0) { map_set(m, str_from_buf(pd, j), 1); }
            }
            j = j + 1;
        }
        prev = pd;
        prev_len = pl;
        i = i + 1;
    }
    return m;
}

# Check whether any tracked path lives under `dir_rel`. Used for
# directory entries — git's index doesn't track directories
# themselves, only files, so a directory is "tracked" iff it
# contains a tracked file.
#
# v1.4.1: a set lookup. Through v1.4.0 this scanned the whole index
# once per directory entry — measured on 90k index entries in 5k
# directories, `-T --git` took 10.9 s against 0.87 s without `--git`.
# The prefix set is built on the first directory lookup and shared by
# every context over the same index. A context without a cell (unit
# tests) keeps the scan.
fn _git_dir_has_tracked(ctx, dir_rel): i64 {
    var paths = _ctx_paths(ctx);
    var n = vec_len(paths);
    var dlen = str_len(dir_rel);
    # v1.3.3: an empty rel means "the listing root itself" — asked by
    # `git_status_for_root` for the `-T` root line when the listing IS
    # the repo root, so there is no prefix to match against. Any
    # tracked path at all lives under it. Through v1.3.2 this returned
    # 0 unconditionally, which is why the tree's own root rendered '?'.
    if (dlen == 0) {
        if (n > 0) { return 1; }
        return 0;
    }
    var cell = _ctx_dir_cell(ctx);
    if (cell != 0) {
        if (load64(cell) == 0) { store64(cell, _git_build_dir_set(paths)); }
        return map_has(load64(cell), dir_rel);
    }
    var dd = str_data(dir_rel);
    var i = 0;
    while (i < n) {
        var p = vec_get(paths, i);
        if (str_len(p) > dlen) {
            if (memeq(str_data(p), dd, dlen) == 1) {
                if (load8(str_data(p) + dlen) == 47) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Status of the tracked entry at index slot `idx` given the entry's own
# lstat mtime and size. v1.4.1: compared as u32, as git does
# (`sd_size != (unsigned)st_size`) — the index stores both fields in 32
# bits. Through v1.4.0 the full 64-bit values were compared, so every
# tracked file of 4 GiB or more, and every pre-1970 mtime, showed 'M'.
fn _git_tracked_status(ctx, idx, mtime_sec, size): i64 {
    var indexed_mtime = vec_get(_ctx_mtimes(ctx), idx);
    var indexed_size = vec_get(_ctx_sizes(ctx), idx);
    if (indexed_mtime != (mtime_sec & 0xFFFFFFFF)) { return 77; }   # 'M'
    if (indexed_size != (size & 0xFFFFFFFF)) { return 77; }
    return 46;                                                      # '.'
}

# ================================================================
# Ignore evaluation (ADR 0005)
# ================================================================

# Index of the last '/' in p[0..n), or -1.
fn _git_last_slash(p, n): i64 {
    var i = n - 1;
    while (i >= 0) {
        if (load8(p + i) == 47) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

# Directory d[0..dl)'s own .gitignore as a list (base d), or 0. Read from
# the worktree at most once per directory per run. A .gitignore that is
# a symlink is not followed — git (2.32+) refuses those in the worktree.
fn _git_dir_list(ctx, d, dl): i64 {
    var cell = _ctx_ign_cell(ctx);
    if (cell == 0) { return 0; }
    var key = str_from_buf(d, dl);
    var hit = map_get(load64(cell + 8), key);
    if (hit == 1) { return 0; }
    if (hit != 0) { return hit; }
    var wt = _ctx_worktree(ctx);
    var list = 0;
    if (wt != 0) {
        var path = 0;
        if (dl == 0) { path = _git_path(wt, ".gitignore"); }
        else { path = _git_path(_git_path_n(wt, d, dl), ".gitignore"); }
        var st[144];
        if (d_lstat(path, &st) >= 0) {
            if ((load32(&st + STAT_MODE) & S_IFMT) == S_IFREG) {
                var r = _git_slurp(path, 16777216);
                if (load64(r + 16) == 0) {
                    list = _ig_list_new(d, dl);
                    _ig_parse(load64(r), load64(r + 8), load64(list));
                }
            }
        }
    }
    if (list == 0) {
        map_set(load64(cell + 8), key, 1);
        return 0;
    }
    map_set(load64(cell + 8), key, list);
    return list;
}

# git's verdict for path p[0..pl) from the per-directory lists in `chain`
# (deepest directory first), then the base lists (info/exclude, then
# core.excludesFile): the first list with a matching pattern decides, and
# within a list the last matching pattern. 1 excluded, 2 re-included by a
# negation, 0 no match.
fn _git_excluded_with(ctx, chain, p, pl, is_dir): i64 {
    var boff = _git_last_slash(p, pl) + 1;
    var i = 0;
    while (i < vec_len(chain)) {
        var r = _ig_list_match(vec_get(chain, i), p, pl, boff, is_dir);
        if (r != 0) { return r; }
        i = i + 1;
    }
    var bl = _ctx_base_lists(ctx);
    if (bl != 0) {
        var j = 0;
        while (j < vec_len(bl)) {
            var r2 = _ig_list_match(vec_get(bl, j), p, pl, boff, is_dir);
            if (r2 != 0) { return r2; }
            j = j + 1;
        }
    }
    return 0;
}

# The record for directory d[0..dl) (relative to the worktree root, ""
# for the root), 16 bytes, memoized:
#   +0 chain     — the .gitignore lists that apply to d's CONTENTS,
#                  deepest first: d's own, then its parent's chain
#   +8 inherited — 1 when d or a directory above it is excluded
# git does not descend into an excluded directory, so everything below
# one is ignored and its .gitignore files never apply (ADR 0005 §4). d is
# judged by its PARENT's chain: a directory's own .gitignore governs what
# is inside it, not the directory itself.
fn _git_dirinfo(ctx, d, dl): i64 {
    var cell = _ctx_ign_cell(ctx);
    var key = str_from_buf(d, dl);
    var hit = map_get(load64(cell), key);
    if (hit != 0) { return hit; }
    var chain = vec_new();
    var inherited = 0;
    if (dl == 0) {
        var root = _git_dir_list(ctx, d, 0);
        if (root != 0) { vec_push(chain, root); }
    } else {
        var ps = _git_last_slash(d, dl);
        var plen = 0;
        if (ps > 0) { plen = ps; }
        var pinfo = _git_dirinfo(ctx, d, plen);
        inherited = load64(pinfo + 8);
        if (inherited == 0) {
            if (_git_excluded_with(ctx, load64(pinfo), d, dl, 1) == 1) { inherited = 1; }
        }
        if (inherited == 0) {
            var own = _git_dir_list(ctx, d, dl);
            if (own != 0) { vec_push(chain, own); }
            var pc = load64(pinfo);
            var k = 0;
            while (k < vec_len(pc)) {
                vec_push(chain, vec_get(pc, k));
                k = k + 1;
            }
        }
    }
    var rec = alloc(16);
    store64(rec, chain);
    store64(rec + 8, inherited);
    map_set(load64(cell), key, rec);
    return rec;
}

# _git_dirinfo with a one-entry front cache: consecutive entries of one
# directory (the common case) skip the key allocation and map lookup.
fn _git_dirinfo_cached(ctx, d, dl): i64 {
    var cell = _ctx_ign_cell(ctx);
    if (load64(cell + 24) == dl) {
        if (dl == 0) { return load64(cell + 32); }
        if (memeq(load64(cell + 16), d, dl) == 1) { return load64(cell + 32); }
    }
    var info = _git_dirinfo(ctx, d, dl);
    var copy = alloc(dl + 1);
    if (dl > 0) { memcpy(copy, d, dl); }
    store8(copy + dl, 0);
    store64(cell + 16, copy);
    store64(cell + 24, dl);
    store64(cell + 32, info);
    return info;
}

# 1 when the untracked path p[0..pl) (relative to the worktree root) is
# ignored: a directory above it is excluded, or the lists say so.
fn _git_ignored(ctx, p, pl, is_dir): i64 {
    if (pl == 0) { return 0; }
    if (_ctx_ign_cell(ctx) == 0) { return 0; }
    var ps = _git_last_slash(p, pl);
    var dl = 0;
    if (ps > 0) { dl = ps; }
    var info = _git_dirinfo_cached(ctx, p, dl);
    if (load64(info + 8) == 1) { return 1; }
    if (_git_excluded_with(ctx, load64(info), p, pl, is_dir) == 1) { return 1; }
    return 0;
}

# 1 when any component of p[0..pl) is exactly ".git" — the repository's
# own storage, or a nested repository's, never part of the worktree.
fn _git_in_dotgit(p, pl): i64 {
    var s = 0;
    var i = 0;
    while (i <= pl) {
        var at_sep = 0;
        if (i == pl) { at_sep = 1; } else { if (load8(p + i) == 47) { at_sep = 1; } }
        if (at_sep == 1) {
            if (i - s == 4) { if (memeq(p + s, ".git", 4) == 1) { return 1; } }
            s = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Submodules
# ================================================================

# 1 when s[0..n) is all lowercase-or-uppercase hex.
fn _git_is_hex(s, n): i64 {
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        var ok = 0;
        if (c >= 48) { if (c <= 57) { ok = 1; } }
        if (c >= 97) { if (c <= 102) { ok = 1; } }
        if (c >= 65) { if (c <= 70) { ok = 1; } }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# `<hex>` for `ref` from `<common>/packed-refs`, or 0.
fn _git_packed_ref(common, ref): i64 {
    var r = _git_slurp(_git_path(common, "packed-refs"), 268435456);
    if (load64(r + 16) != 0) { return 0; }
    var b = load64(r);
    var n = load64(r + 8);
    var rl = strlen(ref);
    var pos = 0;
    while (pos < n) {
        var e = pos;
        var eol = 0;
        while (eol == 0) {
            if (e >= n) { eol = 1; }
            else { if (load8(b + e) == 10) { eol = 1; } else { e = e + 1; } }
        }
        # "<hex> <refname>"; '#' (header) and '^' (peeled) lines have no
        # space at a hex boundary and fall out at the hex check.
        var sp = pos;
        var found = 0;
        while (found == 0) {
            if (sp >= e) { found = 2; }
            else { if (load8(b + sp) == 32) { found = 1; } else { sp = sp + 1; } }
        }
        if (found == 1) {
            var hl = sp - pos;
            if (e - sp - 1 == rl) { if (memeq(b + sp + 1, ref, rl) == 1) {
                    if (_git_is_hex(b + pos, hl) == 1) {
                        var out = alloc(hl + 1);
                        memcpy(out, b + pos, hl);
                        store8(out + hl, 0);
                        return out;
                    }
                } }
        }
        pos = e + 1;
    }
    return 0;
}

# The commit a git dir's HEAD names, as lowercase hex, or 0 when it can't
# be resolved (a reftable repository, a dangling or looping symref).
# Follows "ref: <name>" through the git dir, the common dir and
# packed-refs, up to a few levels.
fn _git_resolve_head(gd): i64 {
    var common = gd;
    var cd = _git_read_small(_git_path(gd, "commondir"));
    if (cd != 0) { if (strlen(cd) > 0) { common = _git_resolve(gd, cd); } }
    var h = _git_read_small(_git_path(gd, "HEAD"));
    var depth = 0;
    while (depth < 5) {
        if (h == 0) { return 0; }
        var hl = strlen(h);
        var is_ref = 0;
        if (hl > 5) { if (memeq(h, "ref: ", 5) == 1) { is_ref = 1; } }
        if (is_ref == 1) {
            var ref = h + 5;
            var v = _git_read_small(_git_path(gd, ref));
            if (v == 0) { v = _git_read_small(_git_path(common, ref)); }
            if (v == 0) { v = _git_packed_ref(common, ref); }
            h = v;
            depth = depth + 1;
        } else {
            var ok = 0;
            if (hl == 40) { ok = 1; }
            if (hl == 64) { ok = 1; }
            if (ok == 0) { return 0; }
            if (_git_is_hex(h, hl) == 0) { return 0; }
            var out = alloc(hl + 1);
            var i = 0;
            while (i < hl) { store8(out + i, lower_byte(load8(h + i))); i = i + 1; }
            store8(out + hl, 0);
            return out;
        }
    }
    return 0;
}

# Status of a gitlink (submodule) entry: '.' when the submodule's
# checked-out HEAD is the commit the index records, 'M' when it moved,
# '.' when the submodule is not checked out (no `.git` in it — git
# reports nothing), ' ' when its HEAD can't be resolved. Through v1.4.1 a
# submodule compared its directory's mtime against the gitlink's index
# mtime (0) and always showed 'M'.
fn _git_gitlink_status(ctx, rel, want): i64 {
    var wt = _ctx_worktree(ctx);
    if (wt == 0) { return 46; }
    var sub = _git_path_n(wt, str_data(rel), str_len(rel));
    var dotgit = _git_path(sub, ".git");
    var st[144];
    if (d_stat(dotgit, &st) < 0) { return 46; }
    var fmt = load32(&st + STAT_MODE) & S_IFMT;
    var gd = 0;
    if (fmt == S_IFDIR) { gd = dotgit; }
    if (fmt == S_IFREG) {
        var txt = _git_read_small(dotgit);
        if (txt != 0) { if (strlen(txt) > 8) { if (memeq(txt, "gitdir: ", 8) == 1) {
                    gd = _git_resolve(sub, txt + 8);
                } } }
    }
    if (gd == 0) { return 32; }
    var head = _git_resolve_head(gd);
    if (head == 0) { return 32; }
    if (streq(head, want) == 1) { return 46; }
    return 77;
}

# ================================================================
# Status
# ================================================================

# The status of the path `rel` (a Str relative to the worktree root).
fn _git_status_rel(ctx, rel, is_dir, mtime_sec, size): i64 {
    var rp = str_data(rel);
    var rl = str_len(rel);
    if (_git_in_dotgit(rp, rl) == 1) { return 32; }
    var idx = _git_find_tracked(ctx, rel);
    if (idx >= 0) {
        var gl = _ctx_gitlinks(ctx);
        if (gl != 0) {
            var want = map_get(gl, rel);
            if (want != 0) { return _git_gitlink_status(ctx, rel, want); }
        }
        return _git_tracked_status(ctx, idx, mtime_sec, size);
    }
    # Directories aren't in the index directly — tracked if any indexed
    # path lives under them (no per-subtree dirty aggregation).
    if (is_dir == 1) {
        if (_git_dir_has_tracked(ctx, rel) == 1) { return 46; }
    }
    if (_git_ignored(ctx, rp, rl, is_dir) == 1) { return 33; }   # '!'
    return 63;                                                  # '?'
}

# Status for an entry identified by its path RELATIVE TO THE LISTING ROOT
# (`sub_rel`, e.g. "src/deep/c.txt" under `-T`). v1.3.2: through v1.3.1
# the tree passed the bare basename and every tracked file below depth 1
# was mislabelled. `basename` is kept for the callers; since v1.5.0 the
# ignore rules see the whole path, as git's do.
fn git_status_for_sub(ctx, sub_rel, basename, is_dir, mtime_sec, size): i64 {
    return _git_status_rel(ctx, _git_entry_relpath(ctx, sub_rel), is_dir, mtime_sec, size);
}

# Status for a direct child `name` of the listing.
fn git_status_for(ctx, name, is_dir, mtime_sec, size): i64 {
    return git_status_for_sub(ctx, name, name, is_dir, mtime_sec, size);
}

# Status for the LISTING PATH ITSELF: the `-T` root line (v1.3.3) and a
# path rendered by `-l <file>` / `-ld <dir>` (v1.4.1) — its repo-relative
# path is the ctx listing prefix. v1.5.0: directories are judged by the
# ignore rules too (v1.3.3 exempted them); with an excluded directory's
# contents now `!`, the exemption would show `?` above a tree of `!`.
fn git_status_for_root(ctx, basename, is_dir, mtime_sec, size): i64 {
    return _git_status_rel(ctx, _ctx_listing(ctx), is_dir, mtime_sec, size);
}

# Fixed display-width budget per entry when `--git` is on.
# Same shape as icon_display_width — 1 char status + 1 space.
fn git_display_width(): i64 { return 2; }
