# darshini — main entry point.
#
# Single-shot CLI: parse flags, stat each path, dispatch to the long /
# multi-column / single-column / tree listing, exit. lib/flags.cyr
# doesn't support bundled short flags (`-lh1`), so the parser is local
# — getopt-bundle semantics are part of the v1.0 CLI contract.
#
# Stdlib auto-included via cyrius.cyml [deps].stdlib.
# Includes are in dependency order, by convention (cycc 6.7.9 resolves
# a call to a function defined later, so this is for the reader):
# walk.cyr defines d_write and the ModeBit enum used by everything after
# it, icons.cyr defines icon_for_entry used by color.cyr's compute_decor,
# color.cyr defines emit_decorated / emit_error used by the emit paths
# (render.cyr / columns.cyr / long.cyr / tree.cyr).
include "src/walk.cyr"
include "src/cli.cyr"
include "src/width_table.cyr"
include "src/width.cyr"
include "src/icons.cyr"
include "src/mime.cyr"
include "src/ignore.cyr"
include "src/gitcfg.cyr"
include "src/git.cyr"
include "src/tz.cyr"
include "src/color.cyr"
include "src/render.cyr"
include "src/columns.cyr"
include "src/long.cyr"
include "src/tree.cyr"

fn emit_usage(): i64 {
    print_cstr_fd(STDERR_FD, "usage: darshini [-lh1TFd] [--tree] [--level N] [--git] [--mime] [--local-time]\n");
    print_cstr_fd(STDERR_FD, "                [--no-color] [--no-icons] [--help] [--version] [--] [path ...]\n");
    return 0;
}

fn emit_unknown_flag(arg): i64 {
    print_cstr_fd(STDERR_FD, "darshini: unknown flag: ");
    _write_err_bytes(arg, strlen(arg));          # untrusted: a glob can expand to "-<anything>"
    d_write(STDERR_FD, "\n", 1);
    emit_usage();
    return 0;
}

# v1.4.1: the version comes from cyrius.cyml's `[package].version`, which
# reads the VERSION file, via the CYRIUS_PKG_VERSION constant `cyrius
# build` defines. Through v1.4.0 it was a hand-bumped literal kept in
# lockstep with VERSION by a release step and a CI grep.
fn emit_version_line(): i64 {
    print_cstr_fd(STDOUT_FD, "darshini ");
    print_cstr_fd(STDOUT_FD, CYRIUS_PKG_VERSION);
    d_write(STDOUT_FD, "\n", 1);
    return 0;
}

fn emit_help(): i64 {
    emit_version_line();
    print_cstr_fd(STDOUT_FD, "usage: darshini [flags] [--] [path ...]\n\n");
    print_cstr_fd(STDOUT_FD, "format flags:\n");
    print_cstr_fd(STDOUT_FD, "  -l             long format (perms, size, mtime, name)\n");
    print_cstr_fd(STDOUT_FD, "  -h             human-readable sizes (IEC: K/M/G/T/P/E)\n");
    print_cstr_fd(STDOUT_FD, "  -1             force single-column output\n");
    print_cstr_fd(STDOUT_FD, "  -T, --tree     recursive tree view (box-drawing connectors)\n");
    print_cstr_fd(STDOUT_FD, "  --level N      cap tree recursion at depth N (with -T)\n");
    print_cstr_fd(STDOUT_FD, "  -F             classify entries (/ dir, * exec, @ symlink, | fifo, = socket)\n");
    print_cstr_fd(STDOUT_FD, "  -d             list the directory itself, not its contents\n");
    print_cstr_fd(STDOUT_FD, "  --local-time   -l mtimes in local time (TZ, else /etc/localtime); default UTC\n\n");
    print_cstr_fd(STDOUT_FD, "extra-column flags:\n");
    print_cstr_fd(STDOUT_FD, "  --git          git status column (./M/?/!) — silent outside a repo\n");
    print_cstr_fd(STDOUT_FD, "  --mime         mime-type column (only under -l)\n\n");
    print_cstr_fd(STDOUT_FD, "decoration flags:\n");
    print_cstr_fd(STDOUT_FD, "  --no-color     suppress per-entry color (ADR 0001)\n");
    print_cstr_fd(STDOUT_FD, "  --no-icons     suppress per-entry icons (ADR 0002)\n\n");
    print_cstr_fd(STDOUT_FD, "meta flags:\n");
    print_cstr_fd(STDOUT_FD, "  --help         this text\n");
    print_cstr_fd(STDOUT_FD, "  --version      print version + exit\n");
    print_cstr_fd(STDOUT_FD, "  --             end of flags: every later argument is a path\n\n");
    print_cstr_fd(STDOUT_FD, "defaults: every entry is shown, dotfiles included. On a TTY, color +\n");
    print_cstr_fd(STDOUT_FD, "          icons + multi-column are on; on a pipe, one entry per line\n");
    print_cstr_fd(STDOUT_FD, "          with no color or icons (the --git / --mime / -F columns still\n");
    print_cstr_fd(STDOUT_FD, "          print). Sort: case-insensitive, locale-free.\n");
    return 0;
}

# Parse argv. Flag outputs land via the pointer-out args; the
# `out_paths` arg is a caller-allocated `vec<cstr>` that we
# push positional args onto. Returns 0 on success, 1 on error,
# 2 on success-but-already-handled (--help / --version).
#
# Supports bundled short flags (`-lh1T`). A bare `-` is a path, and
# since v1.4.1 so is everything after `--`. Any number of positional
# args are accepted (v1.1.1); an empty vec → run_all uses ".".
fn parse_cli(out_long, out_human, out_single, out_no_color, out_no_icons,
  out_tree, out_level, out_git, out_mime, out_classify, out_dir, out_paths, out_local): i64 {
    var n = argc();
    var lflag = 0;
    var hflag = 0;
    var sflag = 0;
    var ncflag = 0;
    var niflag = 0;
    var tflag = 0;
    var level = 0;
    var gflag = 0;
    var mflag = 0;
    var fflag = 0;
    var dflag = 0;
    var ltflag = 0;
    var opts_done = 0;
    var i = 1;
    var failed = 0;
    while (i < n) {
        if (failed == 0) {
            var arg = argv(i);
            var first = load8(arg);
            var second = load8(arg + 1);
            # 0 = path, 1 = long flag, 2 = short-flag bundle.
            var kind = 0;
            if (opts_done == 0) {
                if (first == 45) {
                    if (second == 45) { kind = 1; }
                    else { if (second != 0) { kind = 2; } }
                }
            }
            if (kind == 1) {
                var code = _long_flag_code(arg);
                if (code == LF_NO_COLOR) { ncflag = 1; }
                if (code == LF_NO_ICONS) { niflag = 1; }
                if (code == LF_TREE)     { tflag = 1; }
                if (code == LF_GIT)      { gflag = 1; }
                if (code == LF_MIME)     { mflag = 1; }
                if (code == LF_END_OPTS) { opts_done = 1; }
                if (code == LF_LOCAL_TIME) { ltflag = 1; }
                if (code == LF_HELP)     { emit_help(); return 2; }
                if (code == LF_VERSION)  { emit_version_line(); return 2; }
                if (code == LF_LEVEL) {
                    if (i + 1 >= n) {
                        print_cstr_fd(STDERR_FD, "darshini: --level requires a value\n");
                        failed = 1;
                    } else {
                        i = i + 1;
                        var v = _parse_pos_int(argv(i));
                        if (v <= 0) {
                            print_cstr_fd(STDERR_FD, "darshini: --level requires a positive integer\n");
                            failed = 1;
                        } else { level = v; }
                    }
                }
                if (code == LF_UNKNOWN) { emit_unknown_flag(arg); failed = 1; }
            }
            if (kind == 2) {
                var k = 1;
                while (load8(arg + k) != 0) {
                    if (failed == 0) {
                        var c = load8(arg + k);
                        var known = 1;
                        if (c == 108)      { lflag = 1; }     # 'l'
                        else { if (c == 104) { hflag = 1; }     # 'h'
                        else { if (c == 49)  { sflag = 1; }     # '1'
                        else { if (c == 84)  { tflag = 1; }     # 'T'
                        else { if (c == 70)  { fflag = 1; }     # 'F'
                        else { if (c == 100) { dflag = 1; }     # 'd'
                        else { known = 0; } } } } } }
                        if (known == 0) { emit_unknown_flag(arg); failed = 1; }
                    }
                    k = k + 1;
                }
            }
            if (kind == 0) { vec_push(out_paths, arg); }
        }
        i = i + 1;
    }
    store64(out_long, lflag);
    store64(out_human, hflag);
    store64(out_single, sflag);
    store64(out_no_color, ncflag);
    store64(out_no_icons, niflag);
    store64(out_tree, tflag);
    store64(out_level, level);
    store64(out_git, gflag);
    store64(out_mime, mflag);
    store64(out_classify, fflag);
    store64(out_dir, dflag);
    store64(out_local, ltflag);
    return failed;
}

# Render path arguments as ONE listing (v1.6.0): every non-directory
# argument, or every argument under `-d`, in argv order. They get what a
# directory's entries get — color, icons, the `--git` column, `-F`, the
# multi-column grid on a terminal, and under `-l` a single table whose
# size column is aligned across them. Through v1.5.0 each was echoed on its
# own: `darshini *` printed the files it was handed plain, one per line,
# and `-l a b c` sized each row separately. Names are the paths as given,
# sanitized on a terminal (v1.4.0); icon / mime / ignore rules see their
# last component (compute_decor_args).
fn render_args(args, want_long, want_human, want_single, want_no_color, want_no_icons, want_git, want_mime,
  want_classify): i64 {
    var n = vec_len(args);
    if (n == 0) { return 0; }
    var tw = term_width();
    var want_color = 0;
    var want_icons = 0;
    if (tw > 0) { want_color = 1; }
    if (tw > 0) { want_icons = 1; }
    if (want_no_color == 1) { want_color = 0; }
    if (want_no_icons == 1) { want_icons = 0; }
    var want_mime_eff = 0;
    if (want_mime == 1) { if (want_long == 1) { want_mime_eff = 1; } }
    var entries = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(entries, str_from(vec_get(args, i)));
        i = i + 1;
    }
    var decor = compute_decor_args(entries, want_color, want_icons, want_git, want_mime_eff, want_classify);
    var colors = load64(decor + 0);
    var icons = load64(decor + 8);
    var gitchrs = load64(decor + 16);
    var mimes = load64(decor + 24);
    var classifies = load64(decor + 32);
    var stats = load64(decor + 40);
    if (want_long == 1) {
        # `stats` always holds every entry's lstat, so render_long never
        # joins the (empty) directory with a name.
        render_long(entries, "", want_human, colors, icons, gitchrs, mimes, classifies, stats);
        return 0;
    }
    var tw_eff = tw;
    if (want_single == 1) { tw_eff = 0; }
    if (tw_eff <= 0) { print_entries(entries, colors, icons, gitchrs, classifies); }
    else { render_columns(entries, tw_eff, colors, icons, gitchrs, classifies); }
    return 0;
}

# One path: an error message, a directory's listing (or tree), or — for
# a non-directory — a one-entry argument listing (render_args).
fn run(path_cstr, want_long, want_human, want_single, want_no_color, want_no_icons,
  want_tree, level, want_git, want_mime, want_classify): i64 {
    var c = classify_path(path_cstr);
    if (c == 0 - ENOENT) {
        emit_error("darshini", path_cstr, "no such file or directory");
        return 1;
    }
    if (c == 0 - EACCES) {
        emit_error("darshini", path_cstr, "permission denied");
        return 1;
    }
    if (c < 0) {
        emit_error("darshini", path_cstr, "cannot stat");
        return 1;
    }
    if (c == 0) {
        var one = vec_new();
        vec_push(one, path_cstr);
        return render_args(one, want_long, want_human, want_single, want_no_color, want_no_icons, want_git,
          want_mime, want_classify);
    }
    var tw = term_width();
    var want_color = 0;
    var want_icons = 0;
    if (tw > 0) { want_color = 1; }
    if (tw > 0) { want_icons = 1; }
    if (want_no_color == 1) { want_color = 0; }
    if (want_no_icons == 1) { want_icons = 0; }
    # Name sanitization is NOT decided here: main() sets it once per
    # run, per stream, before anything is written (v1.4.0 — see main).
    # Optional git context. When --git was passed but no
    # enclosing `.git/` is found, git_open returns 0 and the
    # column silently doesn't appear (per the M7 acceptance
    # criterion).
    var git_ctx = 0;
    if (want_git == 1) { git_ctx = git_open(path_cstr); }
    # --mime only shows under -l per ADR 0003.
    var want_mime_eff = 0;
    if (want_mime == 1) { if (want_long == 1) { want_mime_eff = 1; } }
    if (c == 1) {
        var rd = check_dir_readable(path_cstr);
        if (rd == 0 - EACCES) {
            emit_error("darshini", path_cstr, "permission denied");
            return 1;
        }
        if (rd < 0) {
            emit_error("darshini", path_cstr, "cannot open directory");
            return 1;
        }
        if (want_tree == 1) {
            return render_tree(path_cstr, level, want_long, want_human, want_color, want_icons, git_ctx,
              want_classify, want_mime_eff);
        }
        var dir_str = str_from(path_cstr);
        var entries = vec_new();
        # v1.4.1: a read error part-way is reported and fails the run;
        # whatever was read before it is still listed.
        var lrc = list_dir_checked(dir_str, entries);
        sort_entries(entries);
        var colors = 0;
        var icons = 0;
        var gitchrs = 0;
        var mimes = 0;
        var classifies = 0;
        # v1.3.3: stat buffers from the decor pass, reused by
        # render_long instead of lstat'ing every entry a second time.
        # Stays 0 when no decor pass runs, which keeps render_long's
        # own lstat path live for `-l` on a bare pipe.
        var stats = 0;
        var any_decor = want_color + want_icons + want_mime_eff + want_classify;
        if (git_ctx != 0) { any_decor = any_decor + 1; }
        if (any_decor > 0) {
            var decor = compute_decor(entries, dir_str, want_color, want_icons, git_ctx, want_mime_eff,
              want_classify);
            colors = load64(decor + 0);
            icons = load64(decor + 8);
            gitchrs = load64(decor + 16);
            mimes = load64(decor + 24);
            classifies = load64(decor + 32);
            stats = load64(decor + 40);
        }
        if (want_long == 1) {
            render_long(entries, dir_str, want_human, colors, icons, gitchrs, mimes, classifies, stats);
        } else {
            var tw_eff = tw;
            if (want_single == 1) { tw_eff = 0; }
            if (tw_eff <= 0) {
                print_entries(entries, colors, icons, gitchrs, classifies);
            } else {
                render_columns(entries, tw_eff, colors, icons, gitchrs, classifies);
            }
        }
        if (lrc < 0) {
            emit_dir_error(path_cstr, lrc);
            return 1;
        }
        return 0;
    }
    return 0;
}

# v1.1.1 multi-path orchestrator, ls(1) ordering: errors first (on
# stderr, argv order), then the arguments that are listed as entries —
# every non-directory, or every path under `-d` — as ONE listing
# (render_args, v1.6.0), then each directory's contents, with a `<path>:`
# header when more than one path was given and a blank line between
# sections. `-d` stops after the argument listing. `-T` emits each path's
# tree in argv order with a blank line between (the root line names it).
fn run_all(paths, want_long, want_human, want_single, want_no_color, want_no_icons,
  want_tree, level, want_git, want_mime, want_classify, want_dir): i64 {
    var n = vec_len(paths);
    if (n == 0) { vec_push(paths, "."); n = 1; }
    var any_failed = 0;

    if (want_tree == 1) { if (want_dir == 0) {
            var t = 0;
            while (t < n) {
                if (t > 0) { d_write(STDOUT_FD, "\n", 1); }
                var trc = run(vec_get(paths, t), want_long, want_human, want_single, want_no_color,
                  want_no_icons, want_tree, level, want_git, want_mime, want_classify);
                if (trc != 0) { any_failed = 1; }
                t = t + 1;
            }
            return any_failed;
        } }

    var classes = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(classes, classify_path(vec_get(paths, i)));
        i = i + 1;
    }
    # Errors first. run() reports them (and only them, for c < 0).
    var pass1_emitted = 0;
    i = 0;
    while (i < n) {
        if (vec_get(classes, i) < 0) {
            run(vec_get(paths, i), want_long, want_human, want_single, want_no_color, want_no_icons,
              want_tree, level, want_git, want_mime, want_classify);
            any_failed = 1;
            pass1_emitted = 1;
        }
        i = i + 1;
    }
    # The argument listing.
    var args = vec_new();
    i = 0;
    while (i < n) {
        var c = vec_get(classes, i);
        if (c == 0) { vec_push(args, vec_get(paths, i)); }
        if (c == 1) { if (want_dir == 1) { vec_push(args, vec_get(paths, i)); } }
        i = i + 1;
    }
    if (vec_len(args) > 0) {
        render_args(args, want_long, want_human, want_single, want_no_color, want_no_icons, want_git,
          want_mime, want_classify);
        pass1_emitted = 1;
    }
    if (want_dir == 1) { return any_failed; }

    var dir_count = 0;
    i = 0;
    while (i < n) {
        if (vec_get(classes, i) == 1) { dir_count = dir_count + 1; }
        i = i + 1;
    }
    # Headers needed when: >1 dir, or any dirs alongside any other path.
    var need_dir_headers = 0;
    if (dir_count > 1) { need_dir_headers = 1; }
    if (dir_count >= 1) { if (n > dir_count) { need_dir_headers = 1; } }
    var first_dir = 1;
    i = 0;
    while (i < n) {
        var p = vec_get(paths, i);
        if (vec_get(classes, i) == 1) {
            if (first_dir == 0) { d_write(STDOUT_FD, "\n", 1); }
            else { if (pass1_emitted == 1) { d_write(STDOUT_FD, "\n", 1); } }
            first_dir = 0;
            if (need_dir_headers == 1) {
                _write_name_bytes(p, strlen(p));     # untrusted, as in run() (v1.4.0)
                d_write(STDOUT_FD, ":\n", 2);
            }
            var rc = run(p, want_long, want_human, want_single, want_no_color, want_no_icons,
              want_tree, level, want_git, want_mime, want_classify);
            if (rc != 0) { any_failed = 1; }
        }
        i = i + 1;
    }
    return any_failed;
}

fn main(): i64 {
    alloc_init();
    args_init();
    # v1.4.0: decide untrusted-text sanitization once, per stream, before
    # the first byte goes out — before parse_cli too, whose unknown-flag
    # diagnostic quotes an argument. Through v1.3.4 it was set inside
    # run() and applied to listing names only: the multi-path `<dir>:`
    # header, every argv path echoed by `-d` or as a non-directory, and
    # every path in an error message went out through the raw writer
    # and reached the terminal unsanitized. Keyed on the terminal, NOT
    # on want_color:
    # `--no-color` disables decoration, not the terminal, and a hostile
    # name is just as dangerous on a monochrome TTY. On a pipe or file
    # the true bytes are written, so scripts still receive an openable
    # name. darshana's tty_isatty is the same TIOCGWINSZ probe on Linux
    # that term_width makes; for AGNOS see color.cyr.
    set_sanitize_names(tty_isatty(STDOUT_FD));
    set_sanitize_errs(tty_isatty(STDERR_FD));
    # v1.4.1: stdout is buffered (walk.cyr), line by line on a terminal.
    d_set_line_buffered(tty_isatty(STDOUT_FD));
    var want_long = 0;
    var want_human = 0;
    var want_single = 0;
    var want_no_color = 0;
    var want_no_icons = 0;
    var want_tree = 0;
    var level = 0;
    var want_git = 0;
    var want_mime = 0;
    var want_classify = 0;
    var want_dir = 0;
    var want_local = 0;
    var paths = vec_new();
    var rc = parse_cli(&want_long, &want_human, &want_single, &want_no_color, &want_no_icons,
      &want_tree, &level, &want_git, &want_mime, &want_classify, &want_dir, paths, &want_local);
    # v1.6.0: --local-time loads the zone once (tz.cyr); every mtime the
    # listing formats is then shifted by its offset at that instant.
    if (want_local == 1) {
        tz_init();
        set_mtime_local(1);
    }
    # rc=2: parse_cli already handled --help / --version — exit 0
    # without a listing, unless writing it failed (below). Through v1.4.0
    # this returned before the write-error check, so `darshini --help >
    # /dev/full` exited 0.
    var listing_rc = 1;
    if (rc == 2) { listing_rc = 0; }
    if (rc == 0) {
        listing_rc = run_all(paths, want_long, want_human, want_single, want_no_color, want_no_icons,
          want_tree, level, want_git, want_mime, want_classify, want_dir);
    }
    d_flush();
    # v1.3.3: a failed or truncated stdout write is an error exit.
    # Through v1.3.2 every write return was discarded, so `darshini >
    # out.txt` on a full filesystem exited 0 having written nothing and
    # a calling script saw success. The diagnostic goes out via bare
    # sys_write rather than d_write: stderr is frequently still healthy
    # when stdout is not, and routing it through the wrapper whose flag
    # we are reporting on is circular.
    if (d_write_failed() == 1) {
        sys_write(STDERR_FD, "darshini: write error\n", 22);
        return 1;
    }
    return listing_rc;
}

var r = main();
syscall(SYS_EXIT, r);
