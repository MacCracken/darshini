# darshini — per-entry color (M4).
#
# Maps stat-derived file types to darshana SGR codes per ADR 0001.
# All ANSI escapes route through darshana's `tty_sgr` /
# `tty_sgr_reset` per the CLAUDE.md hard rule (no raw ANSI inline).
#
# Two-tier surface:
#   color_for_mode(mode)       — pure: mode bits → SGR code (no I/O)
#   compute_colors(entries, dir_str)
#                              — fs side: lstat + follow-stat per
#                                entry, returns parallel vec<i64>
#                                of SGR codes (0 = no color)
#   emit_colored(name, color)  — write the name bytes optionally
#                                wrapped in SGR + reset

# Map a stat mode (lstat-flavored) to the SGR foreground code per
# ADR 0001. Returns 0 when the entry should render uncolored
# (regular non-executable file). Symlinks return CYAN here —
# broken-symlink detection requires a follow-stat against the
# path, which only `compute_colors` can do.
fn color_for_mode(mode): i64 {
    var fmt = mode & S_IFMT;
    if (fmt == S_IFDIR)  { return TTY_FG_BLUE; }
    if (fmt == S_IFLNK)  { return TTY_FG_CYAN; }
    if (fmt == S_IFIFO)  { return TTY_FG_YELLOW; }
    if (fmt == S_IFSOCK) { return TTY_FG_BRIGHT_MAGENTA; }
    if (fmt == S_IFBLK)  { return TTY_FG_BRIGHT_YELLOW; }
    if (fmt == S_IFCHR)  { return TTY_FG_BRIGHT_YELLOW; }
    if (fmt == S_IFREG) {
        var x_bits = S_IXUSR | S_IXGRP | S_IXOTH;
        if ((mode & x_bits) != 0) { return TTY_FG_GREEN; }
        return 0;
    }
    return 0;
}

# Build per-entry "decoration" vecs for the listing of `entries`
# (basenames inside `dir_str`):
#   - colors  vec: parallel vec<sgr_code> per ADR 0001 (or 0)
#   - icons   vec: parallel vec<cstr glyph bytes> per ADR 0002
#                  (or 0 if stat failed)
#   - gitchrs vec: parallel vec<i64 status-char byte> per M7
#                  (or 0 when want_git == 0; ' ' = 32 when ctx
#                  is non-null but the lookup failed)
# Each vec is omitted if its want_ flag is 0; the returned
# 24-byte struct stores 0 for the omitted slot.
#
# Single lstat per entry — saves three separate passes.
# Symlinks pay one extra `sys_stat` for broken-target detection
# (only when want_color is on; the icon stays the link glyph
# either way; git status uses lstat-only data).
#
# Returns a 24-byte heap struct: {colors@0, icons@8, gitchrs@16}.
# v1.1.2 path-join into a caller-allocated cstr buffer.
# Writes `dir + "/" + name + "\0"` into buf and returns buf.
# Saves an allocation per call vs lib/fs.cyr's `path_join`
# (which builds via str_builder). Caller is responsible for
# sizing buf large enough — `PATH_BUF_SIZE` (4096) covers
# the Linux PATH_MAX. The buffer is OK to reuse across loop
# iterations because no consumer stashes the cstr past its
# iteration.
var PATH_BUF_SIZE = 4096;
fn _path_join_into(buf, dir_str, name_str): i64 {
    var dlen = str_len(dir_str);
    var dd = str_data(dir_str);
    var nlen = str_len(name_str);
    # Separator only when dir is non-empty and doesn't already end
    # in '/'. Computed before the copy so the bound below is exact.
    var sep = 0;
    if (dlen > 0) {
        if (load8(dd + dlen - 1) != 47) { sep = 1; }
    }
    # v1.3.2 (P(-1)): bound BEFORE the first write. Through v1.3.1
    # this fn memcpy'd dir + '/' + name + NUL into `buf` with no
    # capacity check at all, while its only caller hands it a fixed
    # alloc(PATH_BUF_SIZE). A listing path near PATH_MAX holding a
    # NAME_MAX entry needs 4096 + 1 + 255 + 1 = 4353 bytes, so up to
    # 257 bytes landed in the next bump allocation. Measured on a
    # 3915-byte directory holding a 255-byte name: 76 bytes past the
    # end, argv-reachable, no crash (the bump allocator's slack hides
    # it) — which is exactly why it survived to v1.3.1.
    #
    # Refusing yields an empty cstr and returns 0. The caller's lstat
    # then fails and the entry renders with `?` placeholders — the
    # SAME row the unbounded code produced, because a path that long
    # fails the syscall with ENAMETOOLONG anyway. So this is
    # output-preserving on every input: it removes the heap write,
    # not a rendered byte.
    if (dlen + sep + nlen + 1 > PATH_BUF_SIZE) {
        store8(buf, 0);
        return 0;
    }
    memcpy(buf, dd, dlen);
    if (sep == 1) { store8(buf + dlen, 47); }
    var pos = dlen + sep;
    memcpy(buf + pos, str_data(name_str), nlen);
    store8(buf + pos + nlen, 0);
    return buf;
}

fn compute_decor(entries, dir_str, want_color, want_icons, git_ctx, want_mime, want_classify): i64 {
    var colors = 0;
    var icons = 0;
    var gitchrs = 0;
    var mimes = 0;
    var classifies = 0;
    var want_git = 0;
    if (git_ctx != 0) { want_git = 1; }
    if (want_color == 1)    { colors = vec_new(); }
    if (want_icons == 1)    { icons = vec_new(); }
    if (want_git == 1)      { gitchrs = vec_new(); }
    if (want_mime == 1)     { mimes = vec_new(); }
    if (want_classify == 1) { classifies = vec_new(); }
    var n = vec_len(entries);
    # v1.1.2: one path buffer per listing instead of one per
    # entry. Save N heap allocs per compute_decor call.
    var path_buf = alloc(PATH_BUF_SIZE);
    var i = 0;
    while (i < n) {
        var name = vec_get(entries, i);
        _path_join_into(path_buf, dir_str, name);
        var stat_buf = alloc(144);
        var rc = lstat_path(path_buf, stat_buf);
        var c = 0;
        var ic = 0;
        var gc = 32;
        var mm = 0;
        var cl = 0;
        if (rc >= 0) {
            var mode = load32(stat_buf + STAT_MODE);
            var fmt = mode & S_IFMT;
            if (want_color == 1) {
                if (fmt == S_IFLNK) {
                    var probe[144];
                    var rc2 = d_stat(path_buf, &probe);
                    if (rc2 < 0) { c = TTY_FG_RED; }
                    else { c = TTY_FG_CYAN; }
                } else {
                    c = color_for_mode(mode);
                }
            }
            if (want_icons == 1) { ic = icon_for_entry(name, mode); }
            if (want_git == 1) {
                var is_dir = 0;
                if (fmt == S_IFDIR) { is_dir = 1; }
                var mtime = load64(stat_buf + STAT_MTIME);
                var size = load64(stat_buf + STAT_SIZE);
                gc = git_status_for(git_ctx, name, is_dir, mtime, size);
            }
            if (want_mime == 1) {
                mm = mime_for_entry(path_buf, name, mode);
            }
            if (want_classify == 1) {
                cl = classify_indicator(mode);
            }
        } else {
            if (want_mime == 1) { mm = "application/octet-stream"; }
        }
        if (want_color == 1)    { vec_push(colors, c); }
        if (want_icons == 1)    { vec_push(icons, ic); }
        if (want_git == 1)      { vec_push(gitchrs, gc); }
        if (want_mime == 1)     { vec_push(mimes, mm); }
        if (want_classify == 1) { vec_push(classifies, cl); }
        i = i + 1;
    }
    var r = alloc(40);
    store64(r + 0, colors);
    store64(r + 8, icons);
    store64(r + 16, gitchrs);
    store64(r + 24, mimes);
    store64(r + 32, classifies);
    return r;
}

# Write `name` bytes to stdout with full decoration: optional
# git status char (M7), optional icon (M5), optional color (M4).
# Emission order before the name: `<git><space><icon><space>`
# (each pair only emitted when its budget is non-zero).
# Color SGR wrap envelopes ALL prefixed decoration so the
# status / icon takes the name's color.
#
# `color == 0` skips the SGR. `icon == 0` skips the icon glyph
# (and emits 2 spaces of padding when `icon_pad > 0` to keep
# column alignment for stat-failed entries). `git_char == 0`
# is the same shape for the git column (emits 2 spaces when
# `git_pad > 0` and char is 0).
#
# All four pad params (color is implicit, others explicit) are
# 0 when the corresponding decoration is globally disabled.
# v1.3.2 (P(-1) security sweep): control-character sanitization on
# TTY output.
#
# A filename is attacker-controlled input — an extracted tarball, a
# cloned repo, a shared downloads dir. Written raw to a terminal, a
# name containing C0 controls executes them. Demonstrated against
# v1.3.1: ESC + "[2J" clears the screen, ESC + "]0;...BEL" retitles
# the window, CR overwrites the line, and ESC "[1A" ESC "[2K" erases
# the PRECEDING entry — so a hostile archive can hide a sibling file
# from the listing entirely. A bare ESC + "[0m" resets the SGR state
# (escape bytes are spelled out here rather than written literally:
# CI greps src/ for inline ANSI literals, and rightly so)
# darshini itself set, corrupting every later entry's color.
# `ls`, `eza` and BSD `ls` all sanitize here; darshini did not.
#
# Substitution is `?` per offending BYTE — the shape `ls -q` uses,
# chosen because it is exactly length-preserving. Every width
# calculation in the codebase (`_columns_total_width`, `pick_cols`,
# `_columns_emit`'s padding, long.cyr's alignment pass) measures
# `str_len(name)`, so byte-for-byte substitution keeps all of that
# arithmetic correct with no changes anywhere else. It also FIXES
# alignment for such names, which previously counted escape bytes as
# display columns.
#
# Replaced: C0 (0x00-0x1f), DEL (0x7f), and the UTF-8 encoding of the
# C1 controls (0xC2 0x80..0x9F) — a terminal decoding UTF-8 acts on
# those as real C1, which makes U+009B a CSI introducer. The C1 pair
# becomes two `?`, one per byte, preserving the length invariant.
#
# NOT replaced: any other byte >= 0x80. In UTF-8 those are only ever
# multibyte lead or continuation bytes, so touching them would corrupt
# CJK, accented and emoji filenames. This relies on `load8` being
# UNSIGNED — verified by probe on cycc 6.5.35, and guarded by the
# `_is_ctrl_byte` high-byte assertions in tests/darshini.tcyr, which
# all fail if that ever changes.
#
# TTY-only, matching `ls`: on a pipe the true bytes are written, so
# `darshini | while read -r f` still yields a name that opens. Set
# once per run from main.cyr on the same `term_width() > 0` signal
# that already gates color and icons.
var _sanitize_names = 0;

fn set_sanitize_names(v): i64 {
    _sanitize_names = v;
    return 0;
}

# 1 if byte `b` must not reach a terminal verbatim.
fn _is_ctrl_byte(b): i64 {
    if (b < 32) { return 1; }
    if (b == 127) { return 1; }
    return 0;
}

# Write `n` bytes at `d` to stdout, substituting `?` per byte for
# control sequences when sanitization is on. Safe runs are emitted
# whole, so a clean name still costs exactly one `sys_write` — the
# same syscall count the pre-v1.3.2 path had.
fn _write_name_bytes(d, n): i64 {
    if (_sanitize_names == 0) {
        sys_write(STDOUT_FD, d, n);
        return 0;
    }
    var start = 0;
    var i = 0;
    while (i < n) {
        var bad = 0;
        var span = 1;
        var b = load8(d + i);
        if (_is_ctrl_byte(b) == 1) {
            bad = 1;
        } else {
            if (b == 0xC2) {
                if (i + 1 < n) {
                    var b2 = load8(d + i + 1);
                    if (b2 >= 0x80) {
                        if (b2 <= 0x9F) { bad = 1; span = 2; }
                    }
                }
            }
        }
        if (bad == 1) {
            if (i > start) { sys_write(STDOUT_FD, d + start, i - start); }
            if (span == 2) { sys_write(STDOUT_FD, "??", 2); }
            else { sys_write(STDOUT_FD, "?", 1); }
            i = i + span;
            start = i;
        } else {
            i = i + 1;
        }
    }
    if (n > start) { sys_write(STDOUT_FD, d + start, n - start); }
    return 0;
}

fn emit_decorated(name, color, icon, icon_pad, git_char, git_pad, classify_char, classify_pad): i64 {
    if (color != 0) { tty_sgr(color); }
    if (git_pad > 0) {
        if (git_char != 0) {
            var cb[1];
            store8(&cb, git_char);
            sys_write(STDOUT_FD, &cb, 1);
            sys_write(STDOUT_FD, " ", 1);
        } else {
            sys_write(STDOUT_FD, "  ", 2);
        }
    }
    if (icon != 0) {
        sys_write(STDOUT_FD, icon, strlen(icon));
        sys_write(STDOUT_FD, " ", 1);
    } else { if (icon_pad > 0) {
        sys_write(STDOUT_FD, "  ", 2);
    } }
    _write_name_bytes(str_data(name), str_len(name));
    # v1.1 -F classify indicator: trailing 1-char suffix (or
    # space if `-F` is on but the entry's mode has no indicator —
    # keeps column alignment).
    if (classify_pad > 0) {
        if (classify_char != 0) {
            var cb2[1];
            store8(&cb2, classify_char);
            sys_write(STDOUT_FD, &cb2, 1);
        } else {
            sys_write(STDOUT_FD, " ", 1);
        }
    }
    if (color != 0) { tty_sgr_reset(); }
    return 0;
}

# Back-compat shim for callers that still want the no-decoration
# (or color-only) path — most of the long-format / non-listing
# emit paths.
fn emit_colored(name, color): i64 {
    return emit_decorated(name, color, 0, 0, 0, 0, 0, 0);
}
