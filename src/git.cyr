# darshini — git status column (M7, `--git`).
#
# Reads `.git/index` (binary) directly + `.gitignore` / `info/exclude`
# (text) to classify each listing entry as tracked / modified /
# untracked / ignored. Per CLAUDE.md hard rule: NO `git` subprocess —
# every byte comes from open + read against the on-disk files.
#
# Status chars (per-entry, single char):
#   '.' (46) — tracked, clean (stat matches index)
#   'M' (77) — tracked, modified (mtime_sec or size differs)
#   '?' (63) — untracked, not matched by ignore patterns
#   '!' (33) — ignored (matches a .gitignore / info/exclude rule)
#   ' ' (32) — entry's mode lookup failed (broken symlink, race)
#
# Scope (v1.4.1):
#   - `.git/index` versions 2, 3 and 4 (v4's path-prefix compression),
#     SHA-1 or SHA-256 object ids. An index that exists but cannot be
#     read or parsed DECLINES the git context — the column does not
#     appear — rather than appearing with every file '?'.
#   - O(1) tracked-path lookup (hashmap, v1.1) and O(1) directory
#     lookup (prefix set, v1.4.1).
#   - Ignore rules from the repo-root `.gitignore` and
#     `.git/info/exclude` only, matched against the entry's basename,
#     in a subset: exact name, `*<suffix>`, `<name>/` directory-only.
#     No negation, no mid-pattern or class globs, no nested
#     `.gitignore`, no `core.excludesFile`. The full rule set is a
#     roadmap milestone, not a patch.
#   - No HEAD-vs-index diff ("added/staged" shows as tracked) and no
#     per-subtree dirty aggregation for directories.
#   - Second-precision mtime check; comparing nanoseconds would
#     false-flag clean files on filesystems that report 0.
#   - A `.git` FILE (a submodule or linked worktree) declines the
#     context instead of falling through to the enclosing repo.

# ================================================================
# Endian + path helpers
# ================================================================

# Read 32 bits big-endian from buf+off as a non-negative i64.
fn _be_u32(buf, off): i64 {
    var a = load8(buf + off + 0);
    var b = load8(buf + off + 1);
    var c = load8(buf + off + 2);
    var d = load8(buf + off + 3);
    return (a << 24) | (b << 16) | (c << 8) | d;
}

# Read 16 bits big-endian.
fn _be_u16(buf, off): i64 {
    var a = load8(buf + off + 0);
    var b = load8(buf + off + 1);
    return (a << 8) | b;
}

# v1.3.2 (P(-1)): lexically normalize an ABSOLUTE path cstr.
# Collapses runs of '/', drops '.' components, and strips any
# trailing '/' — so "/r/src/.", "/r/src/" and "/r//src" all become
# "/r/src". The filesystem root normalizes to "/".
#
# Why this exists: through v1.3.1 the listing path reached
# `_git_find_root` un-normalized, while find_root truncates a COPY
# to locate the repo root. For "/r/src/." the probe of
# "/r/src/./.git" fails, so find_root truncates past it to "/r",
# and `_git_listing_rel` is then left computing a rel of "src/."
# against root "/r". `_git_entry_relpath` builds "src/./a.txt",
# which misses a tracked_map keyed on "src/a.txt" — so EVERY
# tracked file rendered '?' (untracked). That hit the most common
# invocation there is: bare `darshini --git` inside any repo
# subdirectory, where main.cyr supplies "." as the path.
#
# `..` components are deliberately LEFT IN PLACE: resolving them
# lexically would rewrite "/a/link/.." to "/a" when `link` points into
# a different repo. Since v1.4.1 this only matters on the fallback
# path — `_git_physical` asks the kernel for the real directory first.
fn _git_normalize_abs(p): i64 {
    var plen = strlen(p);
    var out = alloc(plen + 2);
    var w = 0;
    var i = 0;
    # Hoisted: the loop body must not declare a `var` it re-enters,
    # per the Cyrius loop-scoping constraint in CLAUDE.md.
    var cs = 0;
    var ce = 0;
    var clen = 0;
    var skip = 0;
    var scanning = 0;
    while (i < plen) {
        if (load8(p + i) == 47) {
            i = i + 1;
        } else {
            cs = i;
            ce = i;
            scanning = 1;
            while (scanning == 1) {
                if (ce >= plen) { scanning = 0; }
                else {
                    if (load8(p + ce) == 47) { scanning = 0; }
                    else { ce = ce + 1; }
                }
            }
            clen = ce - cs;
            skip = 0;
            if (clen == 1) { if (load8(p + cs) == 46) { skip = 1; } }
            if (skip == 0) {
                store8(out + w, 47);
                w = w + 1;
                memcpy(out + w, p + cs, clen);
                w = w + clen;
            }
            i = ce;
        }
    }
    # Everything collapsed away (input was "/", "/.", "///") -> root.
    if (w == 0) { store8(out + w, 47); w = w + 1; }
    store8(out + w, 0);
    return out;
}

# Return the absolute version of a path cstr. If already
# absolute (starts with '/'), returns a normalized copy.
# Else, prepends cwd + '/' and normalizes. Doesn't resolve `..`
# or symlinks — the lexical fallback behind `_git_physical`.
fn _git_make_absolute(p): i64 {
    if (load8(p) == 47) { return _git_normalize_abs(p); }
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no getcwd (no per-process cwd in the userland ABI —
    # "CWD is userland-owned, absolute paths"). A relative listing
    # path therefore can't be anchored to a repo root, so `--git` is
    # only available when an absolute path is passed. Returning `p`
    # unchanged makes _git_find_root's walk-up bail (no absolute
    # anchor) → git_open returns 0 → the column silently doesn't
    # appear, exactly as the M7 out-of-repo acceptance criterion.
    return p;
    #else
    var cwd_buf = alloc(4096);
    var n = syscall(SYS_GETCWD, cwd_buf, 4096);
    if (n <= 0) { return p; }
    var plen = strlen(p);
    var cwd_len = strlen(cwd_buf);
    var out = alloc(cwd_len + 1 + plen + 1);
    memcpy(out, cwd_buf, cwd_len);
    store8(out + cwd_len, 47);
    memcpy(out + cwd_len + 1, p, plen);
    store8(out + cwd_len + 1 + plen, 0);
    # cwd + "/" + "." is the bare-`darshini --git` case; normalize
    # before find_root sees it.
    return _git_normalize_abs(out);
    #endif
}

#ifndef CYRIUS_TARGET_AGNOS
# The kernel's absolute path for directory `dir_cstr`, or 0 if it can't
# be had: open it and read back /proc/self/fd/<fd>, which names the
# real directory with every symlink and `..` already resolved.
fn _git_dir_physical(dir_cstr): i64 {
    var fd = d_open_dir(dir_cstr);
    if (fd < 0) { return 0; }
    var lp[32];
    memcpy(&lp, "/proc/self/fd/", 14);
    var digits[24];
    var nd = 0;
    var v = fd;
    if (v == 0) { store8(&digits, 48); nd = 1; }
    while (v > 0) {
        store8(&digits + nd, 48 + v % 10);
        v = v / 10;
        nd = nd + 1;
    }
    var k = 0;
    while (k < nd) {
        store8(&lp + 14 + k, load8(&digits + nd - 1 - k));
        k = k + 1;
    }
    store8(&lp + 14 + nd, 0);
    var out = alloc(4097);
    var n = sys_readlink(&lp, out, 4096);
    sys_close(fd);
    if (n <= 0) { return 0; }
    if (n >= 4096) { return 0; }
    if (load8(out) != 47) { return 0; }
    store8(out + n, 0);
    return out;
}
#endif

# v1.4.1: the PHYSICAL absolute path of a listing path, as git sees it.
#
# Through v1.4.0 the repo-root walk-up ran on the lexical path. Any `..`
# the walk had to step past stayed in the listing's repo-relative prefix
# ("src/sub/.."), so every lookup missed and every tracked file showed
# '?' — `darshini --git ..` from two levels down, or `--git ../sibling`.
# And a symlink into another repo bound to the wrong index: from repo
# A, `darshini --git link` (link -> B/src) used A's, while `cd link;
# darshini --git` used B's. git resolves the physical cwd, so now does
# this. A directory resolves whole; for a non-directory (`-l --git
# file`), its parent resolves and the name is re-attached unresolved —
# a symlink is tracked as itself. Falls back to the lexical
# `_git_make_absolute` when /proc can't answer, and always on agnos.
fn _git_physical(p): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    var whole = _git_dir_physical(p);
    if (whole != 0) { return whole; }
    # Not a directory: split off the last component (ignoring trailing
    # '/'), resolve the parent, re-attach the name.
    var e = strlen(p);
    var trimming = 1;
    while (trimming == 1) {
        if (e > 1) {
            if (load8(p + e - 1) == 47) { e = e - 1; }
            else { trimming = 0; }
        } else { trimming = 0; }
    }
    var slash = 0 - 1;
    var i = e - 1;
    var searching = 1;
    while (searching == 1) {
        if (i < 0) { searching = 0; }
        else {
            if (load8(p + i) == 47) { slash = i; searching = 0; }
            else { i = i - 1; }
        }
    }
    var parent = ".";
    var name_off = 0;
    if (slash == 0) { parent = "/"; name_off = 1; }
    if (slash > 0) {
        parent = alloc(slash + 1);
        memcpy(parent, p, slash);
        store8(parent + slash, 0);
        name_off = slash + 1;
    }
    var nlen = e - name_off;
    if (nlen > 0) {
        var pp = _git_dir_physical(parent);
        if (pp != 0) {
            var pl = strlen(pp);
            var out = alloc(pl + 1 + nlen + 1);
            memcpy(out, pp, pl);
            var w = pl;
            if (pl > 1) { store8(out + w, 47); w = w + 1; }
            if (pl == 1) { if (load8(pp) != 47) { store8(out + w, 47); w = w + 1; } }
            memcpy(out + w, p + name_off, nlen);
            store8(out + w + nlen, 0);
            return out;
        }
    }
    #endif
    return _git_make_absolute(p);
}

# Walk up from `dir_abs` (must be an absolute cstr), checking at each
# level for `<dir>/.git`. Returns a heap cstr of the directory whose
# `.git` is a directory, or 0 when none was found before the filesystem
# root — or when the nearest `.git` is NOT a directory (v1.4.1).
#
# A `.git` file is a submodule or a linked worktree (`gitdir: <path>`).
# Through v1.4.0 the walk stepped past it to the enclosing repo, whose
# index does not hold the submodule's files, so every one showed '?'.
# Following `gitdir:` is roadmap work; until then no context beats a
# wrong one.
fn _git_find_root(dir_abs): i64 {
    var len = strlen(dir_abs);
    var buf = alloc(len + 2);
    memcpy(buf, dir_abs, len);
    store8(buf + len, 0);
    var done = 0;
    while (done == 0) {
        var cur_len = strlen(buf);
        # Probe <buf>/.git.
        var probe = alloc(cur_len + 8);
        memcpy(probe, buf, cur_len);
        var pos = cur_len;
        if (cur_len == 0) {
            store8(probe + pos, 47);
            pos = pos + 1;
        } else { if (load8(buf + cur_len - 1) != 47) {
                store8(probe + pos, 47);
                pos = pos + 1;
            } }
        store8(probe + pos + 0, 46);
        store8(probe + pos + 1, 103);
        store8(probe + pos + 2, 105);
        store8(probe + pos + 3, 116);
        store8(probe + pos + 4, 0);
        var stat_buf[144];
        var rc = d_stat(probe, &stat_buf);
        if (rc >= 0) {
            var mode = load32(&stat_buf + STAT_MODE);
            if ((mode & S_IFMT) == S_IFDIR) { return buf; }
            return 0;
        }
        # Walk up — find last '/' in buf and truncate.
        if (cur_len <= 1) { done = 1; }
        else {
            var i = cur_len - 1;
            var found = 0 - 1;
            var scanning = 1;
            while (scanning == 1) {
                if (load8(buf + i) == 47) {
                    found = i;
                    scanning = 0;
                } else { if (i == 0) { scanning = 0; }
                    else { i = i - 1; } }
            }
            if (found < 0) { done = 1; }
            else {
                # v1.4.1: a '/' at index 0 means the parent IS the root;
                # keep it, so the next probe is "/.git". Through v1.4.0
                # the walk stopped here and a repo rooted at / was never
                # found from below.
                if (found == 0) { store8(buf + 1, 0); }
                else { store8(buf + found, 0); }
            }
        }
    }
    return 0;
}

# Compute the relative path from `repo_root` to `listing_abs`.
# Both must be absolute cstrs. Returns a heap-alloc'd Str (may
# be empty when listing_abs == repo_root).
fn _git_listing_rel(repo_root, listing_abs): i64 {
    var rlen = strlen(repo_root);
    var llen = strlen(listing_abs);
    if (llen < rlen) { return str_clone(str_from("")); }
    if (memeq(listing_abs, repo_root, rlen) == 0) { return str_clone(str_from("")); }
    if (llen == rlen) { return str_clone(str_from("")); }
    var off = rlen;
    if (load8(listing_abs + off) == 47) { off = off + 1; }
    var slen = llen - off;
    var buf = alloc(slen + 1);
    memcpy(buf, listing_abs + off, slen);
    store8(buf + slen, 0);
    return str_clone(str_from(buf));
}

# ================================================================
# .git/index parsing (v2 / v3 / v4)
# ================================================================

# Read git's offset-varint (index v4) at buf+pos, bounded by `len`.
# Stores the position after it at `out_pos`; returns the value, or -1
# when the varint runs off the buffer or past 2^31.
fn _git_varint(buf, pos, len, out_pos): i64 {
    if (pos >= len) { return 0 - 1; }
    var c = load8(buf + pos);
    pos = pos + 1;
    var val = c & 127;
    while ((c & 128) != 0) {
        if (pos >= len) { return 0 - 1; }
        if (val > 16777215) { return 0 - 1; }
        val = val + 1;
        c = load8(buf + pos);
        pos = pos + 1;
        val = (val << 7) + (c & 127);
    }
    store64(out_pos, pos);
    return val;
}

# The parser, for an object id of `oid_len` bytes (20 = SHA-1, 32 =
# SHA-256). Entry layout: 40 bytes of stat data, the oid, a 16-bit
# flags word (low 12 bits: name length, 0xFFF = "longer, scan for the
# NUL"), then from v3 a second 16-bit word when flags bit 0x4000 is set.
# v2/v3: the NUL-terminated name, NUL-padded to a multiple of 8.
# v4: an offset-varint count of bytes to drop from the PREVIOUS path,
# then the NUL-terminated suffix, unpadded.
#
# v1.4.1. Through v1.4.0 only v2 was accepted, and the -1 for anything
# else was ignored, so a v3 index (`git add -N`, sparse checkout) or v4
# (`feature.manyFiles`) produced a git column with every file '?'. A
# SHA-256 repository has a v2 header but 32-byte ids, so its entries
# were misread outright. The long-name branch started its NUL scan at
# 0xFFF instead of 0, so a path of 4095+ bytes ended parsing and every
# later entry showed '?'. And a name is now required to be non-empty and
# to end in a NUL where git puts one, which catches a misframed entry
# early.
fn _git_parse_index_oid(buf, len, oid_len, paths, mtimes, sizes): i64 {
    if (len < 12) { return 0 - 1; }
    if (load8(buf + 0) != 68) { return 0 - 1; }   # 'D'
    if (load8(buf + 1) != 73) { return 0 - 1; }   # 'I'
    if (load8(buf + 2) != 82) { return 0 - 1; }   # 'R'
    if (load8(buf + 3) != 67) { return 0 - 1; }   # 'C'
    var version = _be_u32(buf, 4);
    if (version < 2) { return 0 - 1; }
    if (version > 4) { return 0 - 1; }
    var n = _be_u32(buf, 8);
    var fixed = 42 + oid_len;              # stat data + oid + flags
    var pos = 12;
    var prev = 0;                          # v4: previous path (cstr)
    var prev_len = 0;
    var npos[8];
    var i = 0;
    while (i < n) {
        if (pos + fixed > len) { return 0 - 1; }
        var mtime_sec = _be_u32(buf, pos + 8);
        var size = _be_u32(buf, pos + 36);
        var flags = _be_u16(buf, pos + 40 + oid_len);
        var hdr = fixed;
        if (version >= 3) {
            if ((flags & 0x4000) != 0) { hdr = hdr + 2; }
        }
        if (pos + hdr > len) { return 0 - 1; }
        var name_start = pos + hdr;
        var name_buf = 0;
        var name_len = 0;
        if (version == 4) {
            var strip = _git_varint(buf, name_start, len, &npos);
            if (strip < 0) { return 0 - 1; }
            if (strip > prev_len) { return 0 - 1; }
            var sfx = load64(&npos);
            var se = sfx;
            var nul = 0;
            while (nul == 0) {
                if (se >= len) { return 0 - 1; }                  # no NUL
                if (load8(buf + se) == 0) { nul = 1; }
                else { se = se + 1; }
            }
            var keep = prev_len - strip;
            name_len = keep + (se - sfx);
            name_buf = alloc(name_len + 1);
            if (keep > 0) { memcpy(name_buf, prev, keep); }
            memcpy(name_buf + keep, buf + sfx, se - sfx);
            store8(name_buf + name_len, 0);
            pos = se + 1;
        } else {
            name_len = flags & 0xFFF;
            if (name_len == 0xFFF) {
                name_len = 0;
                var lnul = 0;
                while (lnul == 0) {
                    if (name_start + name_len >= len) { return 0 - 1; }   # no NUL
                    if (load8(buf + name_start + name_len) == 0) { lnul = 1; }
                    else { name_len = name_len + 1; }
                }
            }
            if (name_start + name_len + 1 > len) { return 0 - 1; }
            if (load8(buf + name_start + name_len) != 0) { return 0 - 1; }
            name_buf = alloc(name_len + 1);
            memcpy(name_buf, buf + name_start, name_len);
            store8(name_buf + name_len, 0);
            # Entry size: header + name + 1..8 NUL pad to a multiple of 8.
            var total = hdr + name_len + 1;
            var rem = total % 8;
            if (rem != 0) { total = total + (8 - rem); }
            pos = pos + total;
        }
        # git never writes an empty path; one here means misframing.
        if (name_len == 0) { return 0 - 1; }
        vec_push(paths, str_from(name_buf));
        vec_push(mtimes, mtime_sec);
        vec_push(sizes, size);
        prev = name_buf;
        prev_len = name_len;
        i = i + 1;
    }
    return 0;
}

# Parse the index buffer into three parallel vecs:
#   paths  : vec<Str>  — repo-relative path of each tracked entry
#   mtimes : vec<i64>  — index-recorded mtime_sec (u32)
#   sizes  : vec<i64>  — index-recorded size (u32)
# for a SHA-1 repository. Returns 0 on success, -1 on any malformation.
fn _git_parse_index(buf, len, paths, mtimes, sizes): i64 {
    return _git_parse_index_oid(buf, len, 20, paths, mtimes, sizes);
}

# 20 for a SHA-1 repository, 32 when `.git/config` sets
# `extensions.objectFormat = sha256` — the only case git writes 32-byte
# ids into the index. A cheap scan (case-insensitive key, as git
# config is), not a config parser: it looks for "objectformat" followed
# on the same line by "sha256".
fn _git_oid_len(cfg, n): i64 {
    var i = 0;
    while (i + 12 <= n) {
        var j = 0;
        var hit = 1;
        var key = "objectformat";
        while (j < 12) {
            if (lower_byte(load8(cfg + i + j)) != load8(key + j)) { hit = 0; j = 12; }
            else { j = j + 1; }
        }
        if (hit == 1) {
            var k = i + 12;
            while (k + 6 <= n) {
                if (load8(cfg + k) == 10) { k = n; }
                else {
                    if (memeq(cfg + k, "sha256", 6) == 1) { return 32; }
                    k = k + 1;
                }
            }
        }
        i = i + 1;
    }
    return 20;
}

# ================================================================
# .gitignore parsing
# ================================================================

# Parse a .gitignore-style text buffer into the patterns vec.
# Each pattern is a Str of the trimmed line. Comments (#) and
# negation (!) and blank lines are skipped. Trailing '\r' from
# CRLF endings is trimmed. Patterns are stored as-given (with
# any trailing '/' preserved — _git_match_one handles that).
fn _git_parse_ignore(buf, len, patterns): i64 {
    var pos = 0;
    while (pos < len) {
        # v1.3.2 (P(-1)): the original first scan that computed an
        # `eol` here was dead — `line_end` below recomputes the same
        # thing, and nothing ever read `eol`. Removed; one full scan
        # per line instead of two.
        var line_end = pos;
        var scanning = 1;
        while (scanning == 1) {
            if (line_end >= len) { scanning = 0; }
            else { if (load8(buf + line_end) == 10) { scanning = 0; }
                else { line_end = line_end + 1; } }
        }
        var line_len = line_end - pos;
        # Trim trailing CR
        if (line_len > 0) {
            if (load8(buf + pos + line_len - 1) == 13) { line_len = line_len - 1; }
        }
        # v1.3.2 (P(-1)): end of the CR-TRIMMED content. The restore
        # below used `line_end`, which still points at the '\n' — so
        # it silently re-admitted the '\r' the trim had just removed.
        # On a CRLF-authored .gitignore every pattern therefore
        # carried a trailing 0x0D: "build/\r" is not a directory
        # pattern (last byte isn't '/') and "*.swp\r" matches nothing,
        # so NO ignore rule fired at all. Reproduced against git's own
        # `--ignored` output, which correctly reported the same files
        # as ignored.
        var content_end = pos + line_len;
        # Trim leading whitespace (spaces)
        var s = pos;
        var l = line_len;
        while (l > 0) {
            if (load8(buf + s) == 32) { s = s + 1; l = l - 1; }
            else { l = 0 - 1; }     # break-via-flag
        }
        if (l < 0) { l = content_end - s; }
        # Skip blank
        if (l > 0) {
            var first = load8(buf + s);
            if (first != 35) { if (first != 33) {
                    # Not comment, not negation — keep it.
                    # Strip leading '/' (root-anchor; we match basename only).
                    if (first == 47) { s = s + 1; l = l - 1; }
                    if (l > 0) {
                        var pat = alloc(l + 1);
                        memcpy(pat, buf + s, l);
                        store8(pat + l, 0);
                        vec_push(patterns, str_clone(str_from(pat)));
                    }
                } }
        }
        pos = line_end + 1;
    }
    return 0;
}

# Match `name` against one ignore `pattern` (both Strs).
# `is_dir` (0/1) is honored by directory-only `pat/` patterns.
# Subset semantics — see the header.
fn _git_match_one(pattern, name, is_dir): i64 {
    var plen = str_len(pattern);
    var nlen = str_len(name);
    if (plen == 0) { return 0; }
    var pd = str_data(pattern);
    var nd = str_data(name);
    # Directory-only `pat/`
    var match_len = plen;
    if (load8(pd + plen - 1) == 47) {
        match_len = plen - 1;
        if (is_dir == 0) { return 0; }
    }
    # `*<suffix>` glob — check the rest of the pattern as a
    # suffix of `name`.
    if (load8(pd) == 42) {
        var sfx_len = match_len - 1;
        if (sfx_len > nlen) { return 0; }
        var sfx_off = 1;
        return memeq(nd + nlen - sfx_len, pd + sfx_off, sfx_len);
    }
    # Exact basename match.
    if (match_len != nlen) { return 0; }
    return memeq(nd, pd, match_len);
}

# Match `name` against any pattern in `patterns`. `is_dir` is
# the entry's directory flag.
fn _git_match_any(patterns, name, is_dir): i64 {
    var n = vec_len(patterns);
    var i = 0;
    while (i < n) {
        if (_git_match_one(vec_get(patterns, i), name, is_dir) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# GitCtx — the "loaded git state for this listing"
# ================================================================
#
# 56-byte struct:
#   +0  paths       : vec<Str> tracked repo-relative paths
#   +8  mtimes      : vec<i64> index-recorded mtime_sec, parallel
#   +16 sizes       : vec<i64> index-recorded size, parallel
#   +24 patterns    : vec<Str> ignore patterns
#   +32 listing     : Str — listing path relative to repo root ("" if at root)
#   +40 tracked_map : Str-keyed hashmap of repo-relative-path → (idx + 1)
#                     into the parallel mtimes/sizes vecs. v1.1 replaces
#                     the v1.0 linear scan in _git_find_tracked. Values are
#                     stored as `idx + 1` so a 0 result from map_get can be
#                     distinguished from "first entry's idx is 0".
#   +48 dir_cell    : pointer to an 8-byte cell holding the directory
#                     prefix set (built on first use), or 0 for "scan".
#                     A cell, not the map, so contexts sharing one parsed
#                     index (see git_open) build the set once. v1.4.1.

fn _ctx_paths(c): i64       { return load64(c + 0); }
fn _ctx_mtimes(c): i64      { return load64(c + 8); }
fn _ctx_sizes(c): i64       { return load64(c + 16); }
fn _ctx_patterns(c): i64    { return load64(c + 24); }
fn _ctx_listing(c): i64     { return load64(c + 32); }
fn _ctx_tracked_map(c): i64 { return load64(c + 40); }
fn _ctx_dir_cell(c): i64    { return load64(c + 48); }

# Read a whole file into a heap buf. Returns a 24-byte struct
# {ptr@0, len@8, status@16}: status 0 = read (ptr/len valid), 1 = absent
# (no such file, or empty), 2 = present but unusable (unreadable, not a
# regular file, larger than `cap`, short read).
fn _git_slurp(path_cstr, cap): i64 {
    var r = alloc(24);
    store64(r, 0);
    store64(r + 8, 0);
    store64(r + 16, 1);
    # v1.3.2 (P(-1)): size from stat(2), then read to EOF.
    #
    # Through v1.3.1 this allocated the full `cap` and did ONE
    # `sys_read(fd, buf, cap)`, which had two defects. (a) A single
    # read is not guaranteed to fill the buffer; the code treated
    # whatever came back as the whole file. (b) When the file was
    # LARGER than cap, the read returned exactly cap and the parse
    # walked a truncated index — every entry past the cutoff simply
    # wasn't there, so those tracked files rendered '?' (untracked)
    # with no indication anything had been dropped.
    #
    # Now: stat first, allocate exactly the file's size, and loop
    # until EOF. `cap` is a sanity ceiling rather than a truncation
    # point. A FIFO stats with st_size 0 and is refused here; since
    # v1.4.1 the open is also non-blocking and fstat must confirm a
    # regular file, so one swapped in after the stat cannot hang us.
    var st[144];
    if (d_stat(path_cstr, &st) < 0) { return r; }
    var size = load64(&st + STAT_SIZE);
    if (size <= 0) { return r; }
    store64(r + 16, 2);
    if (size > cap) { return r; }
    var fd = d_open_data(path_cstr);
    if (fd < 0) { return r; }
    var fsz[8];
    if (d_fd_regular_size(fd, &fsz) == 0) { sys_close(fd); return r; }
    var buf = alloc(size + 1);
    var got = 0;
    var reading = 1;
    while (reading == 1) {
        var n = sys_read(fd, buf + got, size - got);
        if (n <= 0) { reading = 0; }
        else {
            got = got + n;
            if (got >= size) { reading = 0; }
        }
    }
    sys_close(fd);
    if (got < size) { return r; }
    store64(r, buf);
    store64(r + 8, got);
    store64(r + 16, 0);
    return r;
}

# `<root>/<rel>` as a fresh cstr.
fn _git_path(root, rel): i64 {
    var rlen = strlen(root);
    var nlen = strlen(rel);
    var out = alloc(rlen + 1 + nlen + 1);
    memcpy(out, root, rlen);
    store8(out + rlen, 47);
    memcpy(out + rlen + 1, rel, nlen);
    store8(out + rlen + 1 + nlen, 0);
    return out;
}

# v1.4.1: one parsed index per repository per run. `darshini -l --git *`
# opens a context per argument, and through v1.4.0 each one re-read and
# re-parsed `.git/index` — 18 file arguments against a 90k-entry index
# took 1.1 s and 430 MB. Arguments in the same repository now share the
# parse and differ only in their listing prefix.
var _git_cache_root = 0;
var _git_cache_ctx = 0;

# Parse one repository's index and ignore files into a GitCtx with an
# empty listing prefix, or 0 when the index is present but unusable.
fn _git_load(repo_root): i64 {
    # v1.3.2: sanity ceiling, not a truncation point — _git_slurp
    # sizes its buffer from stat(2), so a realistic index of any
    # size is read whole. 256 MB is far beyond any real .git/index
    # (linux.git's is ~9 MB); past it we decline the git context
    # rather than allocate absurdly.
    var idx_slurp = _git_slurp(_git_path(repo_root, ".git/index"), 268435456);
    var paths = vec_new();
    var mtimes = vec_new();
    var sizes = vec_new();
    # No index at all is a fresh repository: nothing is tracked, which is
    # a true answer. An index that exists but can't be read or parsed is
    # not — decline rather than show every file '?' (v1.4.1; through
    # v1.4.0 the failure was ignored and the column lied).
    if (load64(idx_slurp + 16) == 2) { return 0; }
    if (load64(idx_slurp + 16) == 0) {
        var oid_len = 20;
        var cfg = _git_slurp(_git_path(repo_root, ".git/config"), 1048576);
        if (load64(cfg + 16) == 0) { oid_len = _git_oid_len(load64(cfg), load64(cfg + 8)); }
        var prc = _git_parse_index_oid(load64(idx_slurp), load64(idx_slurp + 8), oid_len,
          paths, mtimes, sizes);
        if (prc < 0) { return 0; }
    }
    var patterns = vec_new();
    var ign_slurp = _git_slurp(_git_path(repo_root, ".gitignore"), 1048576);
    if (load64(ign_slurp + 16) == 0) {
        _git_parse_ignore(load64(ign_slurp), load64(ign_slurp + 8), patterns);
    }
    var exc_slurp = _git_slurp(_git_path(repo_root, ".git/info/exclude"), 1048576);
    if (load64(exc_slurp + 16) == 0) {
        _git_parse_ignore(load64(exc_slurp), load64(exc_slurp + 8), patterns);
    }
    # v1.1: the tracked-path hashmap so _git_find_tracked is O(1)
    # average. Values are (idx + 1) so a get-miss returns 0.
    var tracked_map = map_new_str();
    var pi = 0;
    var pn = vec_len(paths);
    while (pi < pn) {
        map_set(tracked_map, vec_get(paths, pi), pi + 1);
        pi = pi + 1;
    }
    var cell = alloc(8);
    store64(cell, 0);
    var ctx = alloc(56);
    store64(ctx + 0, paths);
    store64(ctx + 8, mtimes);
    store64(ctx + 16, sizes);
    store64(ctx + 24, patterns);
    store64(ctx + 32, str_clone(str_from("")));
    store64(ctx + 40, tracked_map);
    store64(ctx + 48, cell);
    return ctx;
}

# Top-level: open the listing path's enclosing git repo, parse index +
# ignores, build a GitCtx. Returns 0 when no enclosing `.git/` was found
# (caller renders without the column per the M7 acceptance criterion),
# and — since v1.4.1 — when the index exists but cannot be used.
fn git_open(listing_cstr): i64 {
    var listing_abs = _git_physical(listing_cstr);
    var repo_root = _git_find_root(listing_abs);
    if (repo_root == 0) { return 0; }
    var base = 0;
    if (_git_cache_root != 0) {
        if (streq(_git_cache_root, repo_root) == 1) { base = _git_cache_ctx; }
    }
    if (base == 0) {
        base = _git_load(repo_root);
        if (base == 0) { return 0; }
        _git_cache_root = repo_root;
        _git_cache_ctx = base;
    }
    var ctx = alloc(56);
    memcpy(ctx, base, 56);
    store64(ctx + 32, _git_listing_rel(repo_root, listing_abs));
    return ctx;
}

# Build the repo-relative path for an entry: `<listing>/<name>`,
# or just `<name>` when listing is empty. Returns heap-alloc'd Str.
fn _git_entry_relpath(ctx, name): i64 {
    var l = _ctx_listing(ctx);
    var llen = str_len(l);
    var nlen = str_len(name);
    if (llen == 0) { return str_clone(name); }
    var out = alloc(llen + 1 + nlen + 1);
    memcpy(out, str_data(l), llen);
    store8(out + llen, 47);
    memcpy(out + llen + 1, str_data(name), nlen);
    store8(out + llen + 1 + nlen, 0);
    return str_clone(str_from(out));
}

# Look up an entry's repo-relative path in the tracked vec.
# Returns the slot index (>=0) on hit, -1 on miss. v1.1: O(1)
# average via the GitCtx's hashmap built at git_open time
# (was O(N) linear scan through v1.0). Map values are stored
# as `idx + 1` so the 0 sentinel maps to "not found".
fn _git_find_tracked(ctx, rel_path): i64 {
    var v = map_get(_ctx_tracked_map(ctx), rel_path);
    if (v == 0) { return 0 - 1; }
    return v - 1;
}

# Every proper directory prefix of every tracked path ("a/b/c.txt"
# contributes "a" and "a/b"), as a Str-keyed set.
#
# git keeps the index sorted by path, so a prefix the previous path
# shares has already been inserted: only the '/' positions at or past
# the common prefix with the previous path are new. That makes the
# build one insert per distinct directory instead of one per path per
# level (20k paths in 2k dirs: ~2.1k inserts, not ~40k). An unsorted
# index stays correct — it just inserts some prefixes twice.
fn _git_build_dir_set(paths): i64 {
    var m = map_new_str();
    var n = vec_len(paths);
    var prev = 0;
    var prev_len = 0;
    var i = 0;
    while (i < n) {
        var p = vec_get(paths, i);
        var pd = str_data(p);
        var pl = str_len(p);
        var common = 0;
        var cmp_on = 1;
        while (cmp_on == 1) {
            if (common >= pl) { cmp_on = 0; }
            else { if (common >= prev_len) { cmp_on = 0; }
                else { if (load8(pd + common) != load8(prev + common)) { cmp_on = 0; }
                    else { common = common + 1; } } }
        }
        var j = common;
        while (j < pl) {
            if (load8(pd + j) == 47) {
                if (j > 0) { map_set(m, str_from_buf(pd, j), 1); }
            }
            j = j + 1;
        }
        prev = pd;
        prev_len = pl;
        i = i + 1;
    }
    return m;
}

# Check whether any tracked path lives under `dir_rel`. Used for
# directory entries — git's index doesn't track directories
# themselves, only files, so a directory is "tracked" iff it
# contains a tracked file.
#
# v1.4.1: a set lookup. Through v1.4.0 this scanned the whole index
# once per directory entry — measured on 90k index entries in 5k
# directories, `-T --git` took 10.9 s against 0.87 s without `--git`.
# The prefix set is built on the first directory lookup and shared by
# every context over the same index. A context without a cell (unit
# tests) keeps the scan.
fn _git_dir_has_tracked(ctx, dir_rel): i64 {
    var paths = _ctx_paths(ctx);
    var n = vec_len(paths);
    var dlen = str_len(dir_rel);
    # v1.3.3: an empty rel means "the listing root itself" — asked by
    # `git_status_for_root` for the `-T` root line when the listing IS
    # the repo root, so there is no prefix to match against. Any
    # tracked path at all lives under it. Through v1.3.2 this returned
    # 0 unconditionally, which is why the tree's own root rendered '?'.
    if (dlen == 0) {
        if (n > 0) { return 1; }
        return 0;
    }
    var cell = _ctx_dir_cell(ctx);
    if (cell != 0) {
        if (load64(cell) == 0) { store64(cell, _git_build_dir_set(paths)); }
        return map_has(load64(cell), dir_rel);
    }
    var dd = str_data(dir_rel);
    var i = 0;
    while (i < n) {
        var p = vec_get(paths, i);
        if (str_len(p) > dlen) {
            if (memeq(str_data(p), dd, dlen) == 1) {
                if (load8(str_data(p) + dlen) == 47) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Status of the tracked entry at index slot `idx` given the entry's own
# lstat mtime and size. v1.4.1: compared as u32, as git does
# (`sd_size != (unsigned)st_size`) — the index stores both fields in 32
# bits. Through v1.4.0 the full 64-bit values were compared, so every
# tracked file of 4 GiB or more, and every pre-1970 mtime, showed 'M'.
fn _git_tracked_status(ctx, idx, mtime_sec, size): i64 {
    var indexed_mtime = vec_get(_ctx_mtimes(ctx), idx);
    var indexed_size = vec_get(_ctx_sizes(ctx), idx);
    if (indexed_mtime != (mtime_sec & 0xFFFFFFFF)) { return 77; }   # 'M'
    if (indexed_size != (size & 0xFFFFFFFF)) { return 77; }
    return 46;                                                      # '.'
}

# v1.3.2 (P(-1)): status for an entry identified by its path
# RELATIVE TO THE LISTING ROOT (`sub_rel`, e.g. "src/deep/c.txt"),
# rather than by basename alone.
#
# `-T` streams a recursive walk, so an entry at depth 2 is not a
# child of the listing root — but through v1.3.1 tree.cyr passed the
# bare basename here, and `_git_entry_relpath` prepends the listing
# prefix captured once at the TREE ROOT. A tracked "src/deep/c.txt"
# was therefore looked up as "c.txt", missed the tracked_map, and
# rendered '?'. Every tracked file below depth 1 was mislabelled.
#
# Ignore patterns still match against `basename`, preserving v1.3.1
# semantics exactly — widening those to path-anchored matching is a
# separate behavior change and is deliberately not bundled here.
fn git_status_for_sub(ctx, sub_rel, basename, is_dir, mtime_sec, size): i64 {
    var rel = _git_entry_relpath(ctx, sub_rel);
    var idx = _git_find_tracked(ctx, rel);
    if (idx >= 0) { return _git_tracked_status(ctx, idx, mtime_sec, size); }
    # Directories aren't in the index directly — treat as tracked if
    # any indexed path lives under them. Doesn't surface per-subtree
    # dirty status.
    if (is_dir == 1) {
        if (_git_dir_has_tracked(ctx, rel) == 1) { return 46; }
    }
    if (_git_match_any(_ctx_patterns(ctx), basename, is_dir) == 1) { return 33; }   # '!'
    return 63;                                                                      # '?'
}

# Status for a direct child `name` of the listing.
fn git_status_for(ctx, name, is_dir, mtime_sec, size): i64 {
    return git_status_for_sub(ctx, name, name, is_dir, mtime_sec, size);
}

# Status for the LISTING PATH ITSELF: the `-T` root line (v1.3.3) and,
# since v1.4.1, a path rendered by `-l <file>` / `-ld <dir>`. Its
# repo-relative path is the ctx listing prefix directly, not prefix +
# display name. Through v1.3.2 the tree root was looked up as "src/src"
# and always rendered '?'; through v1.4.0 `-l --git <file>` had the same
# defect — `a.txt` was looked up as "a.txt/a.txt" — so every file
# argument showed '?', tracked or not.
#
# Ignore matching applies to a non-directory (`basename` is its name):
# `darshini -l --git app.log` agrees with the `! app.log` row of the
# listing around it. A directory skips it, as the tree root always has:
# reporting '!' for a directory the user explicitly named is noise.
fn git_status_for_root(ctx, basename, is_dir, mtime_sec, size): i64 {
    var rel = _ctx_listing(ctx);
    var idx = _git_find_tracked(ctx, rel);
    if (idx >= 0) { return _git_tracked_status(ctx, idx, mtime_sec, size); }
    if (is_dir == 1) {
        if (_git_dir_has_tracked(ctx, rel) == 1) { return 46; }
        return 63;
    }
    if (_git_match_any(_ctx_patterns(ctx), basename, 0) == 1) { return 33; }
    return 63;
}

# Fixed display-width budget per entry when `--git` is on.
# Same shape as icon_display_width — 1 char status + 1 space.
fn git_display_width(): i64 { return 2; }
