# darshini — multi-column auto-layout (the default-mode path).
#
# When `darshini` is run on a TTY without `-l` or `-1`, fit the
# entries into the terminal width using the classic
# `ls`-style vertical-then-horizontal layout: column 0 holds
# entries[0..rows), column 1 holds entries[rows..2*rows), etc.
# Two-space separator between columns; trailing partial rows
# leave the unused trailing slots empty (no padding past the
# last filled cell).
#
# Pipe-aware: on a pipe / non-TTY, `term_width()` returns 0 and
# the caller (main.cyr) falls back to single-column emit via
# print_entries — keeps `darshini | cat` script-safe.

# Terminal width of stdout, or 0 when stdout is not a terminal — the
# one signal that gates every decoration: color, icons, multi-column.
# 0 on a pipe / non-TTY is what makes `darshini | cat` script-safe.
#
# v1.4.0: the size comes from darshana's `tty_winsize`. Through v1.3.4
# this re-implemented its Linux half (the same TIOCGWINSZ ioctl on fd
# 1); the bytes darshini emits are unchanged.
#
# Not `tty_winsize_or`: it writes its defaults when the query FAILS as
# well as when it answers 0 x 0, so it cannot tell "not a terminal"
# (pipe → plain) from "a terminal of unknown size" (→ 80 columns), and
# that distinction is darshini's whole pipe-awareness. A pty whose size
# was never set (common under `script` and CI) answers 0 columns; it is
# still a terminal, so it gets the classic 80.
fn term_width(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS: 0, deliberately — single-column, decoration-free output,
    # the pipe-safe path. Not because the size is unknowable (through
    # v1.3.4 this comment said agnos had "no way to query the terminal
    # size", which was wrong: darshana's `tty_winsize` reads it from
    # winsize#60). The reason is that agnos cannot say whether fd 1 IS
    # the console. winsize#60 is a property of the framebuffer, not of
    # the fd, so with the console up it answers for a pipe or a file
    # too (darshana documents the same for its agnos `tty_isatty`).
    # agnsh implements `>` and `|` (redirect syscall #62), so taking the
    # console width here puts SGR escapes, Nerd Font glyphs and a
    # multi-column grid into `darshini > out.txt` and `darshini | ...` —
    # measured at v1.4.0 under mirshi with a probe build that called
    # tty_winsize here — the script-consumer surprise CLAUDE.md calls a
    # bug. Revisit when agnos exposes a per-fd terminal property; the
    # Linux arm below is then the whole function.
    return 0;
    #else
    var rows = 0;
    var cols = 0;
    if (tty_winsize(STDOUT_FD, &rows, &cols) != 0) { return 0; }
    if (cols == 0) { return 80; }
    return cols;
    #endif
}

# v1.4.0: per-entry display widths for the column layout, or 0 when
# every entry's width is just its `str_len`. Names are measured by the
# bytes actually written (`_name_display_len`, color.cyr), which differs
# from `str_len` only on a terminal and only for a name holding an
# encoded C1 control, which sanitizes two bytes to one `?`. Returning 0
# for the normal case keeps the layout math exactly as cheap as before:
# one `tty_has_ctl` scan per entry per listing, no vec.
fn _display_widths(entries): i64 {
    if (_sanitize_names == 0) { return 0; }
    var n = vec_len(entries);
    var differs = 0;
    var i = 0;
    while (i < n) {
        var name = vec_get(entries, i);
        if (differs == 0) {
            if (_name_display_len(name) != str_len(name)) { differs = 1; }
        }
        i = i + 1;
    }
    if (differs == 0) { return 0; }
    var w = vec_new();
    i = 0;
    while (i < n) {
        vec_push(w, _name_display_len(vec_get(entries, i)));
        i = i + 1;
    }
    return w;
}

# Width of entry `idx`: `widths[idx]` when a widths vec is present (see
# `_display_widths`), else the name's `str_len`.
fn _entry_width(entries, widths, idx): i64 {
    if (widths != 0) { return vec_get(widths, idx); }
    return str_len(vec_get(entries, idx));
}

# Compute the total horizontal width that would be consumed by
# `cols` columns over `n` entries laid out vertically-then-
# horizontally (`rows` rows). Includes 2-space separators between
# adjacent columns; no trailing space after the last column.
# `icon_width` (M5): fixed display-cell prefix per entry when
# icons are enabled (`icon_display_width()` returns 2). Pass 0
# to ignore.
fn _columns_total_width(entries, n, cols, rows, icon_width): i64 {
    return _columns_total_width_w(entries, 0, n, cols, rows, icon_width);
}

# `_columns_total_width` over explicit display widths (0 = `str_len`).
fn _columns_total_width_w(entries, widths, n, cols, rows, icon_width): i64 {
    var sep = 2;
    var total = 0;
    var c = 0;
    while (c < cols) {
        var max_w = 0;
        var r = 0;
        # `_entry_width`, inlined and hoisted out of the loop: this is
        # pick_cols' hot loop, and the common case (no widths vec) must
        # cost what it did before v1.4.0.
        if (widths == 0) {
            while (r < rows) {
                var idx = c * rows + r;
                if (idx < n) {
                    var w = str_len(vec_get(entries, idx));
                    if (w > max_w) { max_w = w; }
                }
                r = r + 1;
            }
        } else {
            while (r < rows) {
                var idx2 = c * rows + r;
                if (idx2 < n) {
                    var w2 = vec_get(widths, idx2);
                    if (w2 > max_w) { max_w = w2; }
                }
                r = r + 1;
            }
        }
        total = total + max_w;
        if (c < cols - 1) { total = total + sep; }
        c = c + 1;
    }
    return total + cols * icon_width;
}

# Choose the largest column count that still fits in `term_width`
# for `entries`'s names laid out vertically-then-horizontally.
# Starts at min(n, term_width) and walks down — the first fit
# wins. Returns at least 1 (caller dispatches to single-column
# emit when this returns 1).
# `icon_width` (M5): per-entry display-cell prefix when icons
# enabled (typically 2). Pass 0 when icons are off.
fn pick_cols(entries, term_width, icon_width): i64 {
    return _pick_cols_w(entries, 0, term_width, icon_width);
}

# `pick_cols` over explicit display widths (0 = `str_len`).
fn _pick_cols_w(entries, widths, term_width, icon_width): i64 {
    var n = vec_len(entries);
    if (n <= 1) { return 1; }
    if (term_width <= 0) { return 1; }
    var sep = 2;
    # v1.1.2 widest-aware short-circuit: if the widest entry
    # alone doesn't fit, no multi-column layout fits. The
    # outer caller falls back to single-column emit (the long
    # name will wrap at the terminal). Skips the entire
    # per-col iteration loop in this degenerate case.
    # NOTE: we deliberately DON'T use widest as a per-col
    # cap — jagged layouts (one wide entry + many narrow) can
    # legitimately fit more cols than a widest-uniform cap
    # would estimate (test: 1+1+30+1+1 entries at tw=40 fit
    # in 3 cols even though widest=30 would suggest 1).
    var widest = 0;
    var wi = 0;
    while (wi < n) {
        var w = 0;
        if (widths != 0) { w = vec_get(widths, wi); }
        else { w = str_len(vec_get(entries, wi)); }
        if (w > widest) { widest = w; }
        wi = wi + 1;
    }
    if (widest + icon_width >= term_width) { return 1; }
    var max_cols = n;
    # Trivially-impossible upper bound: each col needs at least
    # 1 char + icon_width + sep. The last col doesn't carry a
    # trailing sep. Loose intentionally — see NOTE above.
    var cap = (term_width + sep) / (1 + icon_width + sep);
    if (cap < max_cols) { max_cols = cap; }
    if (max_cols < 1) { max_cols = 1; }
    var picked = 1;
    var cols = max_cols;
    var searching = 1;
    while (searching == 1) {
        if (cols <= 1) {
            searching = 0;
        } else {
            var rows = (n + cols - 1) / cols;
            # Reject phantom layouts (trailing-column-empty); see
            # the v0.4.0 ship notes.
            var effective = (n + rows - 1) / rows;
            if (effective != cols) {
                cols = cols - 1;
            } else {
                var total = _columns_total_width_w(entries, widths, n, cols, rows, icon_width);
                if (total <= term_width) {
                    picked = cols;
                    searching = 0;
                } else {
                    cols = cols - 1;
                }
            }
        }
    }
    return picked;
}

# Emit `entries` in a `cols`-column, `rows`-row grid, vertically-
# then-horizontally (idx = c*rows + r). `col_widths[c]` gives the
# per-column max NAME length. Padding math uses the name's
# written width (`_entry_width`: `str_len`, or the sanitized
# length from `widths`) + `icon_width` + `git_width` (both
# uniform per cell) so escapes + multi-byte glyphs don't
# disturb alignment.
fn _columns_emit(entries, widths, n, cols, rows, col_widths, colors, icons, gitchrs, classifies,
  icon_width, git_width, classify_width): i64 {
    var sep = 2;
    var r = 0;
    while (r < rows) {
        var last_c = 0;
        var cc = 0;
        while (cc < cols) {
            if (cc * rows + r < n) { last_c = cc; }
            cc = cc + 1;
        }
        var c = 0;
        while (c <= last_c) {
            var idx = c * rows + r;
            var name = vec_get(entries, idx);
            var nlen = _entry_width(entries, widths, idx);
            var col_code = 0;
            if (colors != 0)     { col_code = vec_get(colors, idx); }
            var ic = 0;
            if (icons != 0)      { ic = vec_get(icons, idx); }
            var gc = 0;
            if (gitchrs != 0)    { gc = vec_get(gitchrs, idx); }
            var cl = 0;
            if (classifies != 0) { cl = vec_get(classifies, idx); }
            emit_decorated(name, col_code, ic, icon_width, gc, git_width, cl, classify_width);
            if (c < last_c) {
                var w = load64(col_widths + c * 8);
                var pad = w - nlen + sep;
                var pi = 0;
                while (pi < pad) {
                    d_write(STDOUT_FD, " ", 1);
                    pi = pi + 1;
                }
            }
            c = c + 1;
        }
        d_write(STDOUT_FD, "\n", 1);
        r = r + 1;
    }
    return 0;
}

# Top-level: pick the column count, compute per-column max NAME
# widths, emit. Falls back to single-column print_entries when
# the picker chooses 1 column. Per-cell prefix budget is
# icon_width + git_width + classify_width (all 0 when disabled).
fn render_columns(entries, term_width, colors, icons, gitchrs, classifies): i64 {
    var n = vec_len(entries);
    if (n == 0) { return 0; }
    var icon_w = 0;
    if (icons != 0)      { icon_w = icon_display_width(); }
    var git_w = 0;
    if (gitchrs != 0)    { git_w = git_display_width(); }
    var cls_w = 0;
    if (classifies != 0) { cls_w = classify_display_width(); }
    var prefix_w = icon_w + git_w + cls_w;
    var widths = _display_widths(entries);
    var cols = _pick_cols_w(entries, widths, term_width, prefix_w);
    if (cols <= 1) { return print_entries(entries, colors, icons, gitchrs, classifies); }
    var rows = (n + cols - 1) / cols;
    var col_widths = alloc(cols * 8);
    var c = 0;
    while (c < cols) {
        var max_w = 0;
        var r = 0;
        while (r < rows) {
            var idx = c * rows + r;
            if (idx < n) {
                var w = _entry_width(entries, widths, idx);
                if (w > max_w) { max_w = w; }
            }
            r = r + 1;
        }
        store64(col_widths + c * 8, max_w);
        c = c + 1;
    }
    return _columns_emit(entries, widths, n, cols, rows, col_widths, colors, icons, gitchrs, classifies,
      icon_w, git_w, cls_w);
}
