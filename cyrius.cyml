[package]
name = "darshini"
version = "${file:VERSION}"
description = "darshini — eza-equivalent pretty file listing (colors, icons, git-status, tree view, mime-type recognition). Sanskrit दर्शिनी: she who shows. Sibling-not-competitor to kriya's minimal ls."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.1.26"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "darshini"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "args", "fs", "chrono", "hashmap", "assert", "bench"]

# darshana — TTY/ANSI/cursor primitives. Per CLAUDE.md's hard rule
# (no raw ANSI inline), every color escape darshini emits routes
# through darshana's tty_sgr / tty_sgr_reset. Pinned at 0.7.0 (the
# pre-freeze hardening/API-reshaping cut). 0.7.0 carries BREAKING
# changes — but only to symbols darshini never calls: tty_cooked
# (now zero-arg), tty_itoa→tty_dec_buf, tty_clear_to_end→
# tty_clear_to_eos, tty_apply_raw_flags (privatized). darshini's
# entire darshana surface is tty_sgr / tty_sgr_reset, both
# unchanged — so this is a dep-bump-only upgrade for us (same
# category as darshana's anuenue/bannermanor consumers). Roadmap
# M4 dep gate is "≥ 0.3.0"; we're well past that.
[deps.darshana]
git = "https://github.com/MacCracken/darshana.git"
tag = "0.7.0"
modules = ["dist/darshana.cyr"]

# Future: possibly [deps.chakshu] later for AI-augmented mime-
# prediction or repo-context-aware coloring (v2.0 territory).
