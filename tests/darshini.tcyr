    vec_push(wm_rows, "j\t[a-e-n]\t00\n");
    vec_push(wm_rows, "-\t[a-e-n]\t11\n");
    vec_push(wm_rows, "a\t[!------]\t11\n");
    vec_push(wm_rows, "[\t[]-a]\t00\n");
