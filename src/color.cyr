# darshini — per-entry color (M4).
#
# Maps stat-derived file types to darshana SGR codes per ADR 0001.
# All ANSI escapes are composed by darshana's `tty_sgr_buf` /
# `tty_sgr_reset_buf` per the CLAUDE.md hard rule (no raw ANSI
# inline), and on a terminal every untrusted name goes through
# darshana's `tty_sanitize_buf`.
#
# Surface:
#   color_for_mode(mode)       — pure: mode bits → SGR code (no I/O)
#   compute_decor(entries, dir_str, ...)
#                              — fs side: lstat + follow-stat per
#                                entry, returns parallel vecs of SGR
#                                codes / icons / git / mime / classify
#   emit_decorated(name, ...)  — write one decorated name
#   _write_name_bytes / _write_err_bytes / _name_display_len
#                              — the untrusted-text writers

# Map a stat mode (lstat-flavored) to the SGR foreground code per
# ADR 0001. Returns 0 when the entry should render uncolored
# (regular non-executable file). Symlinks return CYAN here —
# broken-symlink detection requires a follow-stat against the
# path, which the callers holding one do (compute_decor,
# render_long_one, tree.cyr's _tree_decor).
fn color_for_mode(mode): i64 {
    var fmt = mode & S_IFMT;
    if (fmt == S_IFDIR)  { return TTY_FG_BLUE; }
    if (fmt == S_IFLNK)  { return TTY_FG_CYAN; }
    if (fmt == S_IFIFO)  { return TTY_FG_YELLOW; }
    if (fmt == S_IFSOCK) { return TTY_FG_BRIGHT_MAGENTA; }
    if (fmt == S_IFBLK)  { return TTY_FG_BRIGHT_YELLOW; }
    if (fmt == S_IFCHR)  { return TTY_FG_BRIGHT_YELLOW; }
    if (fmt == S_IFREG) {
        var x_bits = S_IXUSR | S_IXGRP | S_IXOTH;
        if ((mode & x_bits) != 0) { return TTY_FG_GREEN; }
        return 0;
    }
    return 0;
}

# v1.1.2 path-join into a caller-allocated cstr buffer of
# PATH_BUF_SIZE bytes. Writes `dir + "/" + name + "\0"` into buf and
# returns buf — or an empty cstr and 0 when the join would not fit
# (bounded since v1.3.2; see below). Saves an allocation per call vs
# lib/fs.cyr's `path_join` (which builds via str_builder). The buffer
# is OK to reuse across loop iterations because no consumer stashes
# the cstr past its iteration.
var PATH_BUF_SIZE = 4096;
fn _path_join_into(buf, dir_str, name_str): i64 {
    var dlen = str_len(dir_str);
    var dd = str_data(dir_str);
    var nlen = str_len(name_str);
    # Separator only when dir is non-empty and doesn't already end
    # in '/'. Computed before the copy so the bound below is exact.
    var sep = 0;
    if (dlen > 0) {
        if (load8(dd + dlen - 1) != 47) { sep = 1; }
    }
    # v1.3.2 (P(-1)): bound BEFORE the first write. Through v1.3.1
    # this fn memcpy'd dir + '/' + name + NUL into `buf` with no
    # capacity check at all, while its only caller hands it a fixed
    # alloc(PATH_BUF_SIZE). A listing path near PATH_MAX holding a
    # NAME_MAX entry needs 4096 + 1 + 255 + 1 = 4353 bytes, so up to
    # 257 bytes landed in the next bump allocation. Measured on a
    # 3915-byte directory holding a 255-byte name: 76 bytes past the
    # end, argv-reachable, no crash (the bump allocator's slack hides
    # it) — which is exactly why it survived to v1.3.1.
    #
    # Refusing yields an empty cstr and returns 0. The caller's lstat
    # then fails and the entry renders with `?` placeholders — the
    # SAME row the unbounded code produced, because a path that long
    # fails the syscall with ENAMETOOLONG anyway. So this is
    # output-preserving on every input: it removes the heap write,
    # not a rendered byte.
    if (dlen + sep + nlen + 1 > PATH_BUF_SIZE) {
        store8(buf, 0);
        return 0;
    }
    memcpy(buf, dd, dlen);
    if (sep == 1) { store8(buf + dlen, 47); }
    var pos = dlen + sep;
    memcpy(buf + pos, str_data(name_str), nlen);
    store8(buf + pos + nlen, 0);
    return buf;
}

# Build per-entry "decoration" vecs for the listing of `entries`
# (basenames inside `dir_str`), each parallel to `entries`:
#   - colors     vec<sgr_code> per ADR 0001 (0 = uncolored)
#   - icons      vec<cstr glyph> per ADR 0002 (0 if stat failed)
#   - gitchrs    vec<status byte> per M7 (' ' when the stat failed)
#   - mimes      vec<cstr> per ADR 0003
#   - classifies vec<indicator byte> for `-F` (0 = none)
#   - stats      vec<stat buffer> (0 where the lstat failed) — handed
#                to render_long so `-l` stats each entry once (v1.3.3)
# Each of the first five is 0 when its want_ flag is off.
#
# Single lstat per entry. Symlinks pay one extra stat for broken-target
# detection (only when want_color is on; the icon stays the link glyph
# either way; git status uses lstat-only data).
#
# Returns a 48-byte heap struct: {colors@0, icons@8, gitchrs@16,
# mimes@24, classifies@32, stats@40}.
fn compute_decor(entries, dir_str, want_color, want_icons, git_ctx, want_mime, want_classify): i64 {
    var colors = 0;
    var icons = 0;
    var gitchrs = 0;
    var mimes = 0;
    var classifies = 0;
    var want_git = 0;
    if (git_ctx != 0) { want_git = 1; }
    if (want_color == 1)    { colors = vec_new(); }
    if (want_icons == 1)    { icons = vec_new(); }
    if (want_git == 1)      { gitchrs = vec_new(); }
    if (want_mime == 1)     { mimes = vec_new(); }
    if (want_classify == 1) { classifies = vec_new(); }
    # v1.3.3: hand the stat buffers back. This pass already lstats
    # every entry; render_long then path_joined and lstat'd the whole
    # listing a SECOND time, so `-l` with any decoration issued 2
    # lstat(2) per entry where 1 suffices. Always built (it costs one
    # vec and N pointers we already hold) so the caller need not
    # predict whether it will be wanted.
    var stats = vec_new();
    var n = vec_len(entries);
    # v1.1.2: one path buffer per listing instead of one per
    # entry. Save N heap allocs per compute_decor call.
    var path_buf = alloc(PATH_BUF_SIZE);
    var i = 0;
    while (i < n) {
        var name = vec_get(entries, i);
        _path_join_into(path_buf, dir_str, name);
        var stat_buf = alloc(144);
        var rc = lstat_path(path_buf, stat_buf);
        var c = 0;
        var ic = 0;
        var gc = 32;
        var mm = 0;
        var cl = 0;
        if (rc >= 0) {
            var mode = load32(stat_buf + STAT_MODE);
            var fmt = mode & S_IFMT;
            if (want_color == 1) {
                if (fmt == S_IFLNK) {
                    var probe[144];
                    var rc2 = d_stat(path_buf, &probe);
                    if (rc2 < 0) { c = TTY_FG_RED; }
                    else { c = TTY_FG_CYAN; }
                } else {
                    c = color_for_mode(mode);
                }
            }
            if (want_icons == 1) { ic = icon_for_entry(name, mode); }
            if (want_git == 1) {
                var is_dir = 0;
                if (fmt == S_IFDIR) { is_dir = 1; }
                var mtime = load64(stat_buf + STAT_MTIME);
                var size = load64(stat_buf + STAT_SIZE);
                gc = git_status_for(git_ctx, name, is_dir, mtime, size);
            }
            if (want_mime == 1) {
                mm = mime_for_entry(path_buf, name, mode);
            }
            if (want_classify == 1) {
                cl = classify_indicator(mode);
            }
        } else {
            if (want_mime == 1) { mm = "application/octet-stream"; }
        }
        if (want_color == 1)    { vec_push(colors, c); }
        if (want_icons == 1)    { vec_push(icons, ic); }
        if (want_git == 1)      { vec_push(gitchrs, gc); }
        if (want_mime == 1)     { vec_push(mimes, mm); }
        if (want_classify == 1) { vec_push(classifies, cl); }
        # 0 for a failed stat — the same sentinel render_long already
        # uses to mean "substitute `?` placeholders for this row".
        if (rc >= 0) { vec_push(stats, stat_buf); }
        else         { vec_push(stats, 0); }
        i = i + 1;
    }
    var r = alloc(48);
    store64(r + 0, colors);
    store64(r + 8, icons);
    store64(r + 16, gitchrs);
    store64(r + 24, mimes);
    store64(r + 32, classifies);
    store64(r + 40, stats);
    return r;
}

# v1.6.0: the decoration pass for PATH ARGUMENTS rendered as one listing
# — every non-directory argument (`darshini *`), or every argument under
# `-d`. Same 48-byte result as compute_decor, but each entry is a path as
# given rather than a name inside one directory:
#   * it is lstat'd as is (no join), so a symlink argument shows as one;
#   * icon, mime and ignore rules see its last component (`d_basename`);
#   * git status is per argument, since each may sit in a different
#     repository: git_open (cached per repository) and
#     `git_status_for_root`. The column appears when `want_git` is set and
#     at least one argument is in a repository; the rest show ' '.
# Through v1.5.0 a file argument was echoed undecorated (`darshini *`
# colored the directories' contents but not the files it was handed), and
# `-l a b c` rendered each row on its own, so sizes did not line up.
fn compute_decor_args(paths, want_color, want_icons, want_git, want_mime, want_classify): i64 {
    var colors = 0;
    var icons = 0;
    var mimes = 0;
    var classifies = 0;
    if (want_color == 1)    { colors = vec_new(); }
    if (want_icons == 1)    { icons = vec_new(); }
    if (want_mime == 1)     { mimes = vec_new(); }
    if (want_classify == 1) { classifies = vec_new(); }
    var gitchrs = vec_new();
    var any_git = 0;
    var stats = vec_new();
    var n = vec_len(paths);
    var i = 0;
    while (i < n) {
        var p = vec_get(paths, i);
        var cp = str_data(p);
        var base = d_basename(cp);
        var stat_buf = alloc(144);
        var rc = lstat_path(cp, stat_buf);
        var c = 0;
        var ic = 0;
        var gc = 32;
        var mm = "application/octet-stream";
        var cl = 0;
        if (rc >= 0) {
            var mode = load32(stat_buf + STAT_MODE);
            var fmt = mode & S_IFMT;
            if (want_color == 1) {
                if (fmt == S_IFLNK) {
                    var probe[144];
                    if (d_stat(cp, &probe) < 0) { c = TTY_FG_RED; }
                    else { c = TTY_FG_CYAN; }
                } else {
                    c = color_for_mode(mode);
                }
            }
            if (want_icons == 1) { ic = icon_for_entry(base, mode); }
            if (want_git == 1) {
                var ctx = git_open(cp);
                if (ctx != 0) {
                    any_git = 1;
                    var is_dir = 0;
                    if (fmt == S_IFDIR) { is_dir = 1; }
                    gc = git_status_for_root(ctx, base, is_dir,
                      load64(stat_buf + STAT_MTIME), load64(stat_buf + STAT_SIZE));
                }
            }
            if (want_mime == 1) { mm = mime_for_entry(cp, base, mode); }
            if (want_classify == 1) { cl = classify_indicator(mode); }
        }
        if (want_color == 1)    { vec_push(colors, c); }
        if (want_icons == 1)    { vec_push(icons, ic); }
        vec_push(gitchrs, gc);
        if (want_mime == 1)     { vec_push(mimes, mm); }
        if (want_classify == 1) { vec_push(classifies, cl); }
        if (rc >= 0) { vec_push(stats, stat_buf); }
        else         { vec_push(stats, 0); }
        i = i + 1;
    }
    if (any_git == 0) { gitchrs = 0; }
    var r = alloc(48);
    store64(r + 0, colors);
    store64(r + 8, icons);
    store64(r + 16, gitchrs);
    store64(r + 24, mimes);
    store64(r + 32, classifies);
    store64(r + 40, stats);
    return r;
}

# Write `name` bytes to stdout with full decoration: optional
# git status char (M7), optional icon (M5), optional color (M4).
# Emission order before the name: `<git><space><icon><space>`
# (each pair only emitted when its budget is non-zero).
# Color SGR wrap envelopes ALL prefixed decoration so the
# status / icon takes the name's color.
#
# `color == 0` skips the SGR. `icon == 0` skips the icon glyph
# (and emits 2 spaces of padding when `icon_pad > 0` to keep
# column alignment for stat-failed entries). `git_char == 0`
# is the same shape for the git column (emits 2 spaces when
# `git_pad > 0` and char is 0).
#
# All four pad params (color is implicit, others explicit) are
# 0 when the corresponding decoration is globally disabled.
#
# ----------------------------------------------------------------
# Untrusted-name sanitization (v1.3.2; darshana's rule since v1.4.0)
# ----------------------------------------------------------------
#
# A filename is attacker-controlled input — an extracted tarball, a
# cloned repo, a shared downloads dir. Written raw to a terminal, a
# name containing control bytes executes them. Demonstrated against
# v1.3.1: ESC + "[2J" clears the screen, ESC + "]0;...BEL" retitles
# the window, CR overwrites the line, and ESC "[1A" ESC "[2K" erases
# the PRECEDING entry — so a hostile archive can hide a sibling file
# from the listing entirely. A bare ESC + "[0m" resets the SGR state
# darshini itself set, corrupting every later entry's color. (Escape
# bytes are spelled out here rather than written literally: CI greps
# src/ for inline ANSI literals, and rightly so.) `ls`, `eza` and BSD
# `ls` all sanitize here.
#
# The rule is darshana's `tty_sanitize_buf(..., TTY_SANITIZE_UTF8, 0)`
# (darshana ADR 0004), shared with every other AGNOS tool that prints
# text it did not write. It neutralizes, as one `?` each:
#   * every C0 byte (0x00-0x1f) and DEL (0x7f);
#   * every C1 control written as UTF-8 (C2 80 .. C2 9F), which a
#     UTF-8 terminal acts on — U+009B is a CSI introducer;
#   * every byte that is not part of well-formed UTF-8: a raw 0x80-0x9F
#     byte (an 8-bit C1 control to a terminal that honors them), a stray
#     continuation byte, an invalid lead, a sequence cut off by the end
#     of the name. GNU `ls -q` in a UTF-8 locale does nearly the same
#     (it differs only in collapsing a truncated tail to one `?`).
# Well-formed UTF-8 (accents, CJK, emoji) is copied byte-for-byte.
#
# v1.3.2..v1.3.4 ran darshini's own scrubber, which caught C0 / DEL /
# encoded C1 but passed every other byte >= 0x80 through — including a
# raw 0x9B. UTF-8 is the right mode for darshini specifically because
# it already assumes a UTF-8 terminal: its icons and tree connectors
# are UTF-8 on every TTY.
#
# Encoded C1 is the one case where the output is SHORTER than the input
# (two bytes in, one `?` out); everything else is one byte in, one byte
# out. The multi-column layout therefore measures a name by
# `_name_display_len` — the byte count actually written — rather than
# by `str_len`, so a row holding such a name stays aligned. Long, tree
# and single-column output put nothing after the name, so they need no
# width at all.
#
# Terminal-only, matching `ls`: on a pipe the true bytes are written,
# so `darshini | while read -r f` still yields a name that opens. Set
# ONCE per run by main() from darshana's `tty_isatty` — per stream:
# stdout gates names in the listing, stderr gates the paths quoted in
# error messages, because `darshini * > out.txt` still prints its
# errors on the terminal. On Linux `tty_isatty` is the same TIOCGWINSZ
# probe `term_width` makes. On AGNOS >= 1.57.13 (darshana >= 1.5.0) it
# answers about the fd too — fd_kind#111: the console or a terminal
# emulator's #97 channel — so a listing piped to a file is written raw,
# as on Linux. On older kernels (and under mirshi, which lacks the
# call) it answers whether the CONSOLE is up, so a redirected listing
# is sanitized too: the safe failure for a terminal-safety control.
# See term_width for why decoration takes the opposite default.
var _sanitize_names = 0;
var _sanitize_errs = 0;

fn set_sanitize_names(v): i64 {
    _sanitize_names = v;
    return 0;
}

fn set_sanitize_errs(v): i64 {
    _sanitize_errs = v;
    return 0;
}

# Write darshana's sanitized copy of the `n` bytes at `d` into `out`,
# which must hold at least `n` bytes (the output is never longer than
# the input). Returns the sanitized length, 0..n.
fn _sanitize_into(out, d, n): i64 {
    if (n <= 0) { return 0; }
    var m = tty_sanitize_buf(out, 0, d, n, TTY_SANITIZE_UTF8, 0);
    if (m < 0) { return 0; }   # only for a negative len or a bad mode — neither reachable here
    return m;
}

# Write the `n` bytes at `d` to `fd`, sanitized. A name with nothing to
# neutralize — nearly all of them — is written straight from its own
# storage in one write, with no copy. Otherwise it is sanitized into a
# stack scratch (heap only past 4096 bytes, which no directory entry
# reaches: NAME_MAX is 255) and that copy is written, also once.
fn _write_sanitized(fd, d, n): i64 {
    if (n <= 0) { return 0; }
    if (tty_has_ctl(d, n, TTY_SANITIZE_UTF8, 0) == 0) {
        d_write(fd, d, n);
        return 0;
    }
    var sbuf[4096];
    var buf = &sbuf;
    if (n > 4096) { buf = alloc(n); }
    var m = _sanitize_into(buf, d, n);
    d_write(fd, buf, m);
    return 0;
}

# Untrusted bytes bound for stdout: a listing name or an argv path.
fn _write_name_bytes(d, n): i64 {
    if (_sanitize_names == 0) {
        d_write(STDOUT_FD, d, n);
        return 0;
    }
    return _write_sanitized(STDOUT_FD, d, n);
}

# Untrusted bytes bound for stderr: a path or flag quoted in a diagnostic.
fn _write_err_bytes(d, n): i64 {
    if (_sanitize_errs == 0) {
        d_write(STDERR_FD, d, n);
        return 0;
    }
    return _write_sanitized(STDERR_FD, d, n);
}

# Bytes `_write_name_bytes` will emit for `name` — `str_len(name)`
# unless sanitization is on AND the name holds an encoded C1 control.
# The column layout's width math (columns.cyr) measures names with this.
fn _name_display_len(name): i64 {
    var n = str_len(name);
    if (_sanitize_names == 0) { return n; }
    var d = str_data(name);
    if (tty_has_ctl(d, n, TTY_SANITIZE_UTF8, 0) == 0) { return n; }
    var sbuf[4096];
    var buf = &sbuf;
    if (n > 4096) { buf = alloc(n); }
    return _sanitize_into(buf, d, n);
}

# v1.6.0: 1 when `name` may occupy a different number of terminal cells
# than its byte length — it holds a byte >= 0x80 (multibyte UTF-8, or a
# byte the sanitizer will replace), or, on a terminal, a control byte the
# sanitizer rewrites. Plain ASCII names (nearly all of them) skip the
# cell computation entirely.
fn _name_needs_cells(name): i64 {
    var n = str_len(name);
    var d = str_data(name);
    var i = 0;
    while (i < n) {
        var b = load8(d + i);
        if (b >= 0x80) { return 1; }
        if (_sanitize_names == 1) {
            if (b < 0x20) { return 1; }
            if (b == 0x7F) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# v1.6.0: terminal cells `_write_name_bytes` will occupy for `name`: the
# bytes it writes (sanitized on a terminal) measured by `utf8_cells`.
# Through v1.5.0 the grid used the byte count (`_name_display_len`), so
# `é`, CJK and combining marks misaligned every column to their right.
fn _name_display_cells(name): i64 {
    var n = str_len(name);
    var d = str_data(name);
    if (_sanitize_names == 1) {
        if (tty_has_ctl(d, n, TTY_SANITIZE_UTF8, 0) == 1) {
            var sbuf[4096];
            var buf = &sbuf;
            if (n > 4096) { buf = alloc(n); }
            var m = _sanitize_into(buf, d, n);
            return utf8_cells(buf, m);
        }
    }
    return utf8_cells(d, n);
}

# v1.4.0: the escapes come from darshana's `_buf` composers and every
# byte goes through `d_write`. Through v1.3.4 `tty_sgr` / `tty_sgr_reset`
# wrote each escape with their own unchecked write(2), so they were the
# only stdout bytes outside v1.3.3's checked-write contract, and a
# decorated entry cost up to eight writes. It is now three — prefix,
# name, suffix — with the same bytes in the same order.
fn emit_decorated(name, color, icon, icon_pad, git_char, git_pad, classify_char, classify_pad): i64 {
    # Prefix: SGR (at most 6 bytes, tty_sgr_buf's budget) + git column
    # (2) + icon glyph and its space. Shipped glyphs are 3-4 bytes, so 64
    # is ample; a longer one is flushed rather than overrun.
    var pre[64];
    var p = 0;
    if (color != 0) {
        var q = tty_sgr_buf(&pre, 0, color);
        if (q > 0) { p = q; }      # -1 = code outside [0, 999]: no escape, as tty_sgr did
    }
    if (git_pad > 0) {
        if (git_char != 0) { store8(&pre + p, git_char); }
        else { store8(&pre + p, 32); }
        store8(&pre + p + 1, 32);
        p = p + 2;
    }
    if (icon != 0) {
        var ilen = strlen(icon);
        if (p + ilen + 1 > 64) {
            if (p > 0) { d_write(STDOUT_FD, &pre, p); }
            d_write(STDOUT_FD, icon, ilen);
            p = 0;
        } else {
            memcpy(&pre + p, icon, ilen);
            p = p + ilen;
        }
        store8(&pre + p, 32);
        p = p + 1;
    } else { if (icon_pad > 0) {
            store8(&pre + p, 32);
            store8(&pre + p + 1, 32);
            p = p + 2;
        } }
    if (p > 0) { d_write(STDOUT_FD, &pre, p); }
    _write_name_bytes(str_data(name), str_len(name));
    # Suffix: the v1.1 -F classify indicator, then the SGR reset
    # (exactly 4 bytes). `classify_pad > 0` reserves the indicator's
    # cell with a space when the mode has none — only the multi-column
    # grid passes it, where the next column's alignment depends on it.
    # v1.4.1: every other layout (`-1`, a pipe, `-l`, `-T`, an argument
    # echo) put nothing after that space, so it was pure trailing
    # whitespace in the output — `darshini -F | while IFS= read -r f`
    # read "plain " for a file named "plain". `ls -F` never emits it.
    var suf[8];
    var s = 0;
    if (classify_char != 0) {
        store8(&suf, classify_char);
        s = 1;
    } else { if (classify_pad > 0) {
            store8(&suf, 32);
            s = 1;
        } }
    if (color != 0) {
        var r = tty_sgr_reset_buf(&suf, s);
        if (r > 0) { s = r; }
    }
    if (s > 0) { d_write(STDOUT_FD, &suf, s); }
    return 0;
}

# Write a NUL-terminated string darshini authored itself (a literal, a
# message) to `fd`. Never for a name or path — those go through
# `_write_name_bytes` / `_write_err_bytes`.
fn print_cstr_fd(fd, c): i64 {
    d_write(fd, c, strlen(c));
    return 0;
}

# `<prog>: <path>: <msg>` on stderr. The quoted path is untrusted — it
# is often a shell glob's expansion, so `darshini *` hands us every name
# in the directory — and goes through the stderr sanitizer (v1.4.0;
# through v1.3.4 it was written raw). Moved here from main.cyr at
# v1.4.1 so tree.cyr can report an unreadable subdirectory.
fn emit_error(prog_path, path_cstr, msg): i64 {
    print_cstr_fd(STDERR_FD, prog_path);
    print_cstr_fd(STDERR_FD, ": ");
    _write_err_bytes(path_cstr, strlen(path_cstr));
    print_cstr_fd(STDERR_FD, ": ");
    print_cstr_fd(STDERR_FD, msg);
    d_write(STDERR_FD, "\n", 1);
    return 0;
}

# The diagnostic for a directory that could not be read, discriminated
# the way run() discriminates a failed top-level open.
fn emit_dir_error(path_cstr, rc): i64 {
    if (rc == 0 - EACCES) {
        return emit_error("darshini", path_cstr, "permission denied");
    }
    return emit_error("darshini", path_cstr, "cannot read directory");
}
