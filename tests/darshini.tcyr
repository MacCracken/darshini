    vec_push(wm_rows, "foo/bar\tfoo/**/**/bar\t1-\n");
    vec_push(wm_rows, "foo/bar\tfoo?bar\t01\n");
    vec_push(wm_rows, "foo/bar\tfoo[/]bar\t0-\n");
    vec_push(wm_rows, "foo/bar\tf[^eiu][^eiu][^eiu][^eiu][^eiu]r\t01\n");
    vec_push(wm_rows, "foo-bar\tf[^eiu][^eiu][^eiu][^eiu][^eiu]r\t11\n");
    vec_push(wm_rows, "foo\t**/foo\t1-\n");
    vec_push(wm_rows, "XXX/foo\t**/foo\t1-\n");
    vec_push(wm_rows, "bar/baz/foo\t**/foo\t1-\n");
    vec_push(wm_rows, "bar/baz/foo\t*/foo\t0-\n");
