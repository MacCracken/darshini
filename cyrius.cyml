[package]
name = "darshini"
version = "${file:VERSION}"
description = "darshini — eza-equivalent pretty file listing (colors, icons, git-status, tree view, mime-type recognition). Sanskrit दर्शिनी: she who shows. Sibling-not-competitor to kriya's minimal ls."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "darshini"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "args", "fs", "chrono", "hashmap", "assert", "bench"]

# darshana — TTY/ANSI/cursor primitives. Per CLAUDE.md's hard rule
# (no raw ANSI inline), every escape darshini emits and every terminal
# query it makes routes through darshana. Pinned at 1.6.0 (was 1.5.0).
# darshana's API is frozen since 1.0.0 and only additive since. 1.6.0
# adds `tty_isatty_is_per_fd()` (its ADR 0008), which darshini asked for:
# on agnos it gates decoration and link targets (v1.8.1). The bump alone
# changes no byte darshini emits on any target (A/B-verified). On AGNOS
# `tty_isatty` answers about the fd on agnos >= 1.57.13 (darshana 1.5.0).
# An AGNOS build needs cyrius >= 6.7.11; Linux builds need >= 6.7.2.
#
# Used: tty_sgr_buf / tty_sgr_reset_buf + TTY_FG_* (color), tty_winsize
# (terminal width), tty_isatty (per-stream terminal test) and, since
# v1.8.1, tty_isatty_is_per_fd (is that test about the fd?),
# tty_sanitize_buf / tty_has_ctl + TTY_SANITIZE_UTF8 (untrusted names).
[deps.darshana]
git = "https://github.com/MacCracken/darshana.git"
tag = "1.6.0"
modules = ["dist/darshana.cyr"]

# Future: possibly [deps.chakshu] later for AI-augmented mime-
# prediction or repo-context-aware coloring (v2.0 territory).
