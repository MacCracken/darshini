    vec_push(wm_rows, "-\t[\\-_]\t11\n");
    vec_push(wm_rows, "]\t[\\]]\t11\n");
    vec_push(wm_rows, "\\]\t[\\]]\t00\n");
    vec_push(wm_rows, "\\\t[\\]]\t00\n");
    vec_push(wm_rows, "ab\ta[]b\t00\n");
    vec_push(wm_rows, "a[]b\ta[]b\t00\n");
    vec_push(wm_rows, "ab[\tab[\t00\n");
    vec_push(wm_rows, "ab\t[!\t00\n");
    vec_push(wm_rows, "ab\t[-\t00\n");
    vec_push(wm_rows, "-\t[-]\t11\n");
    vec_push(wm_rows, "-\t[a-\t00\n");
    vec_push(wm_rows, "-\t[!a-\t00\n");
    vec_push(wm_rows, "-\t[--A]\t11\n");
    vec_push(wm_rows, "5\t[--A]\t11\n");
    vec_push(wm_rows, " \t[ --]\t11\n");
    vec_push(wm_rows, "$\t[ --]\t11\n");
    vec_push(wm_rows, "-\t[ --]\t11\n");
    vec_push(wm_rows, "0\t[ --]\t00\n");
