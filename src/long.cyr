# darshini — long-format orchestration (the `-l` / `-lh` path).
#
# Single-shot per directory: lstat every entry, render the four
# columns (permissions / size / mtime / name) into aligned rows,
# emit. Multi-pass over the entry list because the size column
# is variable-width — we need to know the maximum width before
# we can right-align.
#
# Entries that fail lstat (broken symlinks, races) keep their
# slot in the listing with `?` placeholders so the alignment
# stays intact and the user sees the missing-row at a glance.

# Per-row state collected during the first pass and consumed by
# the second. Heap-alloced 16-byte struct: { stat_buf@0, size_buf@8 }.
# size_buf is itself a small heap buffer (32 bytes max for the
# decimal-or-human-formatted size string + length prefix).
#   stat_buf @ 0   — pointer to a 144-byte stat buffer (or 0 if
#                    lstat failed for this entry; len in size_buf
#                    will be the literal "?" placeholder).
#   size_buf @ 8   — pointer to {size_data@0, size_len@8}, where
#                    size_data is N ASCII bytes (e.g. "4.2K", "1024").

fn _long_row_new(stat_buf, size_data, size_len): i64 {
    var row = alloc(16);
    var sz = alloc(16);
    store64(sz, size_data);
    store64(sz + 8, size_len);
    store64(row, stat_buf);
    store64(row + 8, sz);
    return row;
}

fn _long_row_stat(row): i64 { return load64(row); }
fn _long_row_size_data(row): i64 { return load64(load64(row + 8)); }
fn _long_row_size_len(row): i64 { return load64(load64(row + 8) + 8); }

# Write `n` spaces to stdout. Used to right-align the size column.
fn _emit_spaces(n): i64 {
    var i = 0;
    while (i < n) {
        d_write(STDOUT_FD, " ", 1);
        i = i + 1;
    }
    return 0;
}

# v1.7.0: ` -> target` after a symlink's name under `-l` on a terminal,
# as `ls -l` shows it (`-T -l` too). Pipe output stays name-only until
# 2.0 (roadmap) because scripts read those rows. main() sets the switch
# once from tty_isatty(stdout), the same decision as name sanitization:
# `--no-color` turns off color, not the terminal. The target is the
# link's own bytes (readlink — nothing is followed to read it), untrusted
# like a name, so it goes out through emit_decorated's sanitizing writer.
# With color on it takes the color of what it points to, as `ls` colors
# it: the follow-stat's type (blue directory, green executable, a plain
# file uncolored), red when the link is broken or loops (ADR 0001).
# Under -F the `@` stays on the name and the target gets no indicator,
# so the name's bytes are the pipe's. A link that is gone or unreadable
# by the time of the readlink (a race: lstat on it just succeeded) gets
# no arrow.
var _link_targets = 0;
var _link_buf = 0;
var LINK_BUF_SIZE = 4096;      # PATH_MAX: a Linux link target is at most 4095 bytes

fn set_link_targets(v): i64 {
    _link_targets = v;
    return 0;
}

fn link_targets_on(): i64 { return _link_targets; }

fn emit_link_target(path_cstr, want_color): i64 {
    if (_link_targets == 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos's stat follows links (walk.cyr d_lstat), so no symlink row
    # reaches here until lstat#102 is adopted (roadmap 1.8.0).
    return 0;
    #else
    if (_link_buf == 0) { _link_buf = alloc(LINK_BUF_SIZE); }
    var n = sys_readlink(path_cstr, _link_buf, LINK_BUF_SIZE);
    if (n <= 0) { return 0; }
    var col = 0;
    if (want_color == 1) {
        var st[144];
        if (d_stat(path_cstr, &st) < 0) { col = TTY_FG_RED; }
        else { col = color_for_mode(load32(&st + STAT_MODE)); }
    }
    d_write(STDOUT_FD, " -> ", 4);
    emit_decorated(str_from_buf(_link_buf, n), col, 0, 0, 0, 0, 0, 0);
    return 0;
    #endif
}

# Render the long-format listing for the entries inside `dir_str`.
# `want_human` controls size formatting (decimal vs IEC X.YK/M/G/T).
# `colors` (M4) / `icons` (M5) / `gitchrs` (M7): parallel vecs
# (or 0) for color, icon, and git-status decoration of the name
# column.
# Both passes over the entries: pass 1 collects per-row state +
# tracks the max size-string width; pass 2 emits aligned rows.
#
# Per CLAUDE.md: lstat (not stat) is used so symlinks render as
# `l...` with their own length rather than the target's. Since v1.7.0
# a terminal also gets ` -> target` (emit_link_target, above).
# `dir_str` is a Str; render_args passes an empty one, whose entries are
# paths as given (path_join then returns the name unchanged).
# v1.3.3: `stats` is the parallel vec of stat buffers compute_decor
# already produced (0 per entry when its lstat failed), or 0 when no
# decoration pass ran at all — `-l` on a pipe with no --git/--mime,
# or `-l --no-color --no-icons`. When present we reuse them; when
# absent we lstat here exactly as before. That halves the syscall
# count on the primary `-l` path without changing a rendered byte.
fn render_long(entries, dir_str, want_human, colors, icons, gitchrs, mimes, classifies, stats): i64 {
    var n = vec_len(entries);
    var rows = vec_new();
    var max_size_w = 0;
    # Pre-compute max mime width for left-aligned padding when
    # the column is present. cheap O(N) scan.
    var max_mime_w = 0;
    if (mimes != 0) {
        var mi = 0;
        while (mi < n) {
            var m = vec_get(mimes, mi);
            if (m != 0) {
                var ml = strlen(m);
                if (ml > max_mime_w) { max_mime_w = ml; }
            }
            mi = mi + 1;
        }
    }
    var i = 0;
    while (i < n) {
        var name = vec_get(entries, i);
        var stat_buf = 0;
        var rc = 0;
        if (stats != 0) {
            stat_buf = vec_get(stats, i);
            if (stat_buf == 0) { rc = 0 - 1; }
        } else {
            var full = path_join(dir_str, name);
            stat_buf = alloc(144);
            rc = lstat_path(str_data(full), stat_buf);
            # v1.7.0: with no decor pass, this is the only lstat, so the
            # failure is reported here (otherwise compute_decor did it).
            if (rc < 0) { emit_stat_error(str_data(full), rc); }
        }
        var size_buf = alloc(32);
        var size_len = 0;
        if (rc < 0) {
            # Stat failed mid-listing (race or broken symlink with
            # path-resolution quirk). Mark the row with a `?` and
            # zero the stat-buf pointer so the emit pass knows to
            # substitute placeholders for perms and mtime too.
            store8(size_buf, 63);              # '?'
            size_len = 1;
            stat_buf = 0;
        } else {
            var size = load64(stat_buf + STAT_SIZE);
            if (want_human == 1) {
                size_len = format_size_human(size, size_buf);
            } else {
                size_len = format_size_decimal(size, size_buf);
            }
        }
        if (size_len > max_size_w) { max_size_w = size_len; }
        vec_push(rows, _long_row_new(stat_buf, size_buf, size_len));
        i = i + 1;
    }
    # Emit pass.
    var perm_buf = alloc(10);
    var mtime_buf = alloc(16);
    i = 0;
    while (i < n) {
        var row = vec_get(rows, i);
        var sb = _long_row_stat(row);
        # perms (or `??????????` if stat failed)
        if (sb == 0) {
            var k = 0;
            while (k < 10) {
                store8(perm_buf + k, 63);
                k = k + 1;
            }
        } else {
            format_perms(load32(sb + STAT_MODE), perm_buf);
        }
        d_write(STDOUT_FD, perm_buf, 10);
        d_write(STDOUT_FD, " ", 1);
        # size — right-aligned within max_size_w
        _emit_spaces(max_size_w - _long_row_size_len(row));
        d_write(STDOUT_FD, _long_row_size_data(row), _long_row_size_len(row));
        d_write(STDOUT_FD, " ", 1);
        # mtime (or `????-??-?? ??:??` if stat failed)
        if (sb == 0) {
            var k2 = 0;
            while (k2 < 16) {
                var ch = 63;
                if (k2 == 4) { ch = 45; }     # '-'
                if (k2 == 7) { ch = 45; }
                if (k2 == 10) { ch = 32; }    # ' '
                if (k2 == 13) { ch = 58; }    # ':'
                store8(mtime_buf + k2, ch);
                k2 = k2 + 1;
            }
        } else {
            format_mtime(load64(sb + STAT_MTIME), mtime_buf);
        }
        d_write(STDOUT_FD, mtime_buf, 16);
        d_write(STDOUT_FD, " ", 1);
        # M8 mime column — left-aligned to max width across listing.
        if (mimes != 0) {
            var m = vec_get(mimes, i);
            var ml = 0;
            if (m != 0) {
                ml = strlen(m);
                d_write(STDOUT_FD, m, ml);
            }
            var mpad = max_mime_w - ml;
            var mp = 0;
            while (mp < mpad) {
                d_write(STDOUT_FD, " ", 1);
                mp = mp + 1;
            }
            d_write(STDOUT_FD, " ", 1);
        }
        # name + ADR 0001 color + ADR 0002 icon + M7 git status + v1.1 -F
        var name = vec_get(entries, i);
        var col_code = 0;
        if (colors != 0)     { col_code = vec_get(colors, i); }
        var ic = 0;
        if (icons != 0)      { ic = vec_get(icons, i); }
        var gc = 0;
        if (gitchrs != 0)    { gc = vec_get(gitchrs, i); }
        var cl = 0;
        if (classifies != 0) { cl = vec_get(classifies, i); }
        var icon_pad = 0;
        if (icons != 0)      { icon_pad = icon_display_width(); }
        var git_pad = 0;
        if (gitchrs != 0)    { git_pad = git_display_width(); }
        # No `-F` cell padding: the name ends the row (v1.4.1).
        emit_decorated(name, col_code, ic, icon_pad, gc, git_pad, cl, 0);
        if (link_targets_on() == 1) { if (sb != 0) {
                if ((load32(sb + STAT_MODE) & S_IFMT) == S_IFLNK) {
                    var want_col = 0;
                    if (colors != 0) { want_col = 1; }
                    emit_link_target(str_data(path_join(dir_str, name)), want_col);
                }
            } }
        d_write(STDOUT_FD, "\n", 1);
        i = i + 1;
    }
    return 0;
}
