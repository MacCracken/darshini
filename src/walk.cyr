# darshini — filesystem walking.
#
# Stats a user-supplied path, discriminates dir / non-dir / error,
# and (for directories) reads entries via lib/fs.cyr's
# dir_list_checked (getdents64; agnos getdents #29). Returns explicit negative-errno on
# stat failure so the caller can render the right message
# (ENOENT vs EACCES vs other).
#
# Pure walk — no sorting, no rendering. Composes with render.cyr
# and long.cyr.
#
# Also hosts `d_write` — the checked, buffered stdout/stderr writer
# every other module writes through. It lives here because walk.cyr is
# the first include, and the one every harness (tests, fuzz, bench)
# includes too.

# v1.3.3: checked write.
#
# Through v1.3.2 all 66 `sys_write` call sites discarded their return
# value. Consequences, none of them theoretical:
#   * `darshini src > out.txt` on a full filesystem wrote nothing,
#     ignored -ENOSPC at every site, and exited **0** — so a calling
#     script saw success and an empty listing.
#   * `darshini src >&-` (closed stdout, -EBADF) likewise exited 0.
#   * A filesystem filling MID-listing produces a short write; the
#     unchecked code treated it as complete and silently truncated a
#     row, corrupting the alignment of everything after it.
#
# The write loop (`_d_write_raw`) retries short writes and -EINTR
# (interrupted before transferring anything), and on any other negative
# return sets a sticky module flag and stops trying. `main()` reads the
# flag and exits non-zero, which is what a pipeline actually needs.
#
# Returns the number of bytes accepted, which callers are free to keep
# ignoring — the flag is the contract, not the return.
var _d_write_failed = 0;

fn d_write_failed(): i64 { return _d_write_failed; }

# The checked write itself: every byte darshini puts on fd 1 or fd 2
# ends up here (through d_write / d_flush below).
fn _d_write_raw(fd, buf, n): i64 {
    if (n <= 0) { return 0; }
    var off = 0;
    var going = 1;
    while (going == 1) {
        var w = sys_write(fd, buf + off, n - off);
        if (w > 0) {
            off = off + w;
            if (off >= n) { going = 0; }
        } else {
            # -EINTR: nothing transferred, safe to reissue. Any other
            # negative — and a 0 return for n > 0, which would
            # otherwise spin forever — is terminal.
            if (w == 0 - 4) {
                going = 1;
            } else {
                _d_write_failed = 1;
                going = 0;
            }
        }
    }
    return off;
}

# v1.4.1: buffered stdout.
#
# Through v1.4.0 every d_write was its own write(2), and a row is built
# from many small pieces — perms, a space, one call PER padding space,
# size, mtime, prefix, name, suffix, newline. Measured: `-l` on 5,000
# entries made 40,000 write(2) calls; `-T` paid one more per ancestor
# level per line. Stdout now goes through one 64 KB buffer: the same
# `-l` listing is 4 calls and ~2x faster, `-T /usr/share` (80k entries)
# ~1.6x. Not one output byte changes — A/B-verified on a pipe and under
# a PTY.
#
# Three rules keep it invisible:
#   * Anything for stderr flushes stdout first, so the relative order of
#     listing lines and diagnostics on a shared terminal is exactly what
#     the unbuffered code produced (run_all interleaves them).
#   * When stdout is a terminal (main sets it from tty_isatty, like the
#     name sanitizer), a chunk ending in a newline flushes — the stdio
#     line-buffering rule, so a long `-T` still streams line by line.
#   * main() calls d_flush before it reads d_write_failed, so a failed
#     write still becomes exit 1 (the v1.3.3 contract above).
# A chunk at least as large as the buffer bypasses it after a flush.
var D_OUT_CAP = 65536;
var _d_out = 0;
var _d_out_len = 0;
var _d_out_line = 0;

fn d_set_line_buffered(v): i64 {
    _d_out_line = v;
    return 0;
}

fn d_flush(): i64 {
    if (_d_out_len > 0) {
        var k = _d_out_len;
        _d_out_len = 0;
        _d_write_raw(STDOUT_FD, _d_out, k);
    }
    return 0;
}

fn d_write(fd, buf, n): i64 {
    if (n <= 0) { return 0; }
    if (fd != STDOUT_FD) {
        d_flush();
        return _d_write_raw(fd, buf, n);
    }
    if (_d_out == 0) { _d_out = alloc(D_OUT_CAP); }
    if (_d_out_len + n > D_OUT_CAP) {
        d_flush();
        if (n >= D_OUT_CAP) { return _d_write_raw(fd, buf, n); }
    }
    memcpy(_d_out + _d_out_len, buf, n);
    _d_out_len = _d_out_len + n;
    if (_d_out_line == 1) {
        if (load8(buf + n - 1) == 10) { d_flush(); }
    }
    return n;
}

# POSIX mode bits. Cyrius stdlib doesn't define these (yet) — we
# carry them locally rather than guess at the right shared home.
# When stdlib grows a stat.cyr these can be folded out.
enum ModeBit {
    S_IFMT  = 0xF000;
    S_IFREG = 0x8000;
    S_IFDIR = 0x4000;
    S_IFLNK = 0xA000;
    S_IFIFO = 0x1000;
    S_IFSOCK = 0xC000;
    S_IFBLK = 0x6000;
    S_IFCHR = 0x2000;
    S_ISUID = 0x0800;
    S_ISGID = 0x0400;
    S_ISVTX = 0x0200;
    S_IRUSR = 0x0100;
    S_IWUSR = 0x0080;
    S_IXUSR = 0x0040;
    S_IRGRP = 0x0020;
    S_IWGRP = 0x0010;
    S_IXGRP = 0x0008;
    S_IROTH = 0x0004;
    S_IWOTH = 0x0002;
    S_IXOTH = 0x0001;
}

# errno values the caller discriminates on (main.cyr's per-path
# error messages). On Linux these come from the stdlib syscalls
# enum. agnos's frozen syscall floor reports a flat -1 on failure
# (NOT -errno) and doesn't define them, so provide them here for the
# agnos build. The values match Linux, but since an agnos stat
# failure returns -1 these equality checks never match there — every
# failure flows to the generic "cannot stat" branch, which is the
# correct graceful degradation.
#ifdef CYRIUS_TARGET_AGNOS
var ENOENT = 2;
var EACCES = 13;
#endif

# ----------------------------------------------------------------
# Portable stat/open (agnos support).
# ----------------------------------------------------------------
# Linux and agnos disagree on the low-level FS syscall ABI:
#   - Linux:  sys_stat(path, statbuf)          — NUL-terminated path
#             sys_open(path, flags, mode)
#   - agnos:  sys_stat(path, pathlen, statbuf) — explicit length, no NUL
#             sys_open(name, namelen, flags)
# The stat struct-field offsets (STAT_MODE/SIZE/MTIME) are already
# per-target constants in the stdlib, so callers read fields uniformly;
# only the *call shape* differs. These wrappers hide it so the rest of
# darshini stays a single Linux-shaped code path. On Linux each is a
# transparent forward; on agnos each supplies the explicit length.
fn d_stat(cpath, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_stat(cpath, strlen(cpath), buf);
    #else
    return sys_stat(cpath, buf);
    #endif
}

# v1.4.1: opens that cannot hang. Everything darshini opens was first
# classified by a stat, but the file can be swapped between that stat and
# the open — a regular file for a FIFO, which blocks open(2) forever with
# no writer. Measured: `--mime` over a directory where another process
# swaps a file and a FIFO in turn hung 3 times in 88 runs. On Linux these
# open non-blocking and close-on-exec; the caller then checks with fstat
# that it got what the stat promised (`d_fd_regular_size`). agnos has no
# such flags and a stub fstat, so there the calls are as before.
#
# d_open_probe: a file's content (mime magic, a `.git` file). Also
# O_NOFOLLOW — the entry was lstat'd as a regular file, so a symlink in
# its place is the race, not the entry.
fn d_open_probe(cpath): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_open(cpath, strlen(cpath), O_RDONLY);
    #else
    return sys_open(cpath, O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC, 0);
    #endif
}

# d_open_data: a file read whole (`.git/index`, `.gitignore`). Follows a
# symlink — git does — but cannot block.
fn d_open_data(cpath): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_open(cpath, strlen(cpath), O_RDONLY);
    #else
    return sys_open(cpath, O_RDONLY | O_NONBLOCK | O_CLOEXEC, 0);
    #endif
}

# d_open_dir: a directory (follows a symlink, like the stat before it).
fn d_open_dir(cpath): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_open(cpath, strlen(cpath), AO_DIRECTORY);
    #else
    return sys_open(cpath, O_RDONLY | O_DIRECTORY | O_NONBLOCK | O_CLOEXEC, 0);
    #endif
}

# 1 when `fd` is a regular file, storing its size at `out_size`; else 0.
# agnos: its fstat is a stub, so this answers 1 with a size of -1
# ("unknown") and callers keep their pre-v1.4.1 behavior there.
fn d_fd_regular_size(fd, out_size): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    store64(out_size, 0 - 1);
    return 1;
    #else
    var st[144];
    if (sys_fstat(fd, &st) < 0) { return 0; }
    if ((load32(&st + STAT_MODE) & S_IFMT) != S_IFREG) { return 0; }
    store64(out_size, load64(&st + STAT_SIZE));
    return 1;
    #endif
}

# lstat `cpath` into `buf` — no-symlink-follow, so `-l` shows a link
# as `l...` with its own size rather than its target's. Returns 0 /
# negative on failure, same as d_stat.
#
# Linux: the stdlib's arch-aware `sys_lstat` (v1.4.0). Through v1.3.4
# this was `syscall(6, ...)` — x86_64's lstat number, written bare.
# Built with cyrius 6.6.2 the aarch64 binary issued syscall 6 as-is,
# which is lsetxattr there, so every stat-derived column on aarch64
# rendered `?` (measured under qemu-aarch64 -strace); built with 6.7.9
# the backend happens to translate it to newfstatat(AT_SYMLINK_NOFOLLOW).
# `sys_lstat` is the same call on x86_64 and the documented at-family
# call on aarch64, so the build no longer depends on the backend
# translating a foreign number.
#
# agnos: its single stat — symlinks resolve to their target's metadata
# there. The agnos stdlib now carries `sys_lstat` (lstat#102, agnos
# 1.56.53); adopting it is an agnos behavior change tracked in the
# roadmap, not part of this fix.
fn d_lstat(cpath, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_stat(cpath, strlen(cpath), buf);
    #else
    return sys_lstat(cpath, buf);
    #endif
}

# Stat a null-terminated path and classify the result:
#   1                — path exists, is a directory
#   0                — path exists, is not a directory (regular,
#                      symlink, fifo, socket, blockdev, chardev)
#   negative errno   — stat failed (0 - ENOENT, 0 - EACCES, etc.)
#
# Buf is stack-local — sized in **bytes** (Cyrius 6.0.1 `var
# buf[N]` is N bytes, not N i64 slots — the language guide is
# wrong; see feedback memory). 144 is the stdlib's STAT_BUFSZ — the
# x86_64 struct stat size, and the max over every target (aarch64's
# is 128). Field offsets come from the stdlib's per-target Stat enum
# (STAT_MODE etc.), so the same reads are correct on each arch.
fn classify_path(cpath): i64 {
    var buf[144];
    var rc = d_stat(cpath, &buf);
    # v1.3.2 (P(-1)): d_stat FOLLOWS symlinks, so a dangling link
    # named on the command line classified as -ENOENT and run()
    # aborted the whole invocation with "no such file or directory"
    # and exit 1 — while the very same link listed as a MEMBER of its
    # parent directory rendered fine as `lrwxrwxrwx ... broken`.
    # `ls -l broken` shows the link and exits 0; darshini refused to.
    # In run_all a single dangling link among several arguments also
    # forced a non-zero exit for every other path.
    #
    # Retry with lstat: if the link itself exists, treat it as a
    # non-directory (0) and let the caller render it — render_long_one
    # already lstats, so `-l` produces the correct `l...` row. Only
    # paths that currently ERROR change behavior; a live symlink still
    # stats successfully on the first call and keeps following to its
    # target, so symlink-to-directory arguments still list contents.
    if (rc < 0) {
        var lbuf[144];
        if (d_lstat(cpath, &lbuf) >= 0) { return 0; }
        return rc;
    }
    var mode = load32(&buf + STAT_MODE);
    var fmt = mode & S_IFMT;
    if (fmt == S_IFDIR) { return 1; }
    return 0;
}

# Probe whether a directory can be opened for reading. Returns 0
# on success, negative errno on failure (typically -EACCES). The
# fd is closed immediately — this is a discriminator, not a
# resource handle. Pairs with classify_path: classify confirms
# the path exists + is a dir, then this confirms readability
# before list_dir runs. dir_list itself swallows open failures
# (silently returns an empty vec), so without this check
# permission-denied is indistinguishable from empty-dir.
fn check_dir_readable(cpath): i64 {
    var fd = d_open_dir(cpath);
    if (fd < 0) { return fd; }
    sys_close(fd);
    return 0;
}

# Read a directory's entries into `entries` (a vec<Str>; `.` and `..`
# skipped). Returns 0 when the whole directory was read, or a negative
# error when it could not be opened or its entry stream failed part-way
# (-errno on Linux, -1 on agnos); `entries` then holds whatever was read
# before the failure.
#
# v1.4.1: the stdlib's `dir_list_checked`, on every target. Through
# v1.4.0 this was `dir_list`, which (until cyrius 6.6.10 added the
# checked form) folds both failures into "an empty directory": `-T`
# drew an unreadable subdirectory exactly like an empty one and exited
# 0, and a getdents error mid-listing truncated it silently. Callers
# now report the error and fail the run.
#
# The same release retires darshini's own agnos enumerator
# (`_d_dir_list_agnos`, v1.3.0): the stdlib's agnos arm issues the same
# getdents(#29), parses the same AgnosDirent layout, and keeps the
# getdents scratch on the stack as v1.3.3's fix did. (It is still NOT
# `sys_readdir` (#81), whose fixed 64-byte records cap names at 63
# bytes.)
fn list_dir_checked(path: Str, entries): i64 {
    return dir_list_checked(path, entries);
}

# Unchecked form, for callers with nothing useful to do on an error.
fn list_dir(path: Str): i64 {
    var entries = vec_new();
    list_dir_checked(path, entries);
    return entries;
}

# Classify-indicator (POSIX `-F`) for a stat mode. Returns the
# trailing-byte indicator or 0 (no indicator). Suffix
# semantics:
#   /  S_IFDIR
#   *  S_IFREG with any execute bit
#   @  S_IFLNK
#   |  S_IFIFO
#   =  S_IFSOCK
# Block / char devices have no POSIX indicator; we return 0.
fn classify_indicator(mode): i64 {
    var fmt = mode & S_IFMT;
    if (fmt == S_IFDIR)  { return 47; }    # '/'
    if (fmt == S_IFLNK)  { return 64; }    # '@'
    if (fmt == S_IFIFO)  { return 124; }   # '|'
    if (fmt == S_IFSOCK) { return 61; }    # '='
    if (fmt == S_IFREG) {
        var x_bits = S_IXUSR | S_IXGRP | S_IXOTH;
        if ((mode & x_bits) != 0) { return 42; }   # '*'
    }
    return 0;
}

# Fixed display-width budget per entry when `-F` is on (1 char
# trailing indicator; 0 cost when entry's mode has no
# indicator but the column reserves the slot for alignment).
fn classify_display_width(): i64 {
    return 1;
}

# The last component of path cstr `p` as a fresh Str, ignoring trailing
# '/' ("a/b/" -> "b"); "/" stays "/". Icon, mime and ignore rules match
# a NAME, so a path argument (`darshini -l docs/README.md`) must be cut
# down to one before they see it (v1.4.1 — render_long_one passed the
# whole path, so `README*` and `Makefile` rules never fired for an
# argument with a directory in it, and `./a.b/file` took "b/file" as
# its extension).
fn d_basename(p): i64 {
    var e = strlen(p);
    var trimming = 1;
    while (trimming == 1) {
        if (e > 1) {
            if (load8(p + e - 1) == 47) { e = e - 1; }
            else { trimming = 0; }
        } else { trimming = 0; }
    }
    var b = e;
    var scanning = 1;
    while (scanning == 1) {
        if (b <= 0) { scanning = 0; }
        else {
            if (load8(p + b - 1) == 47) { scanning = 0; }
            else { b = b - 1; }
        }
    }
    if (b >= e) { return str_from_buf(p, e); }
    return str_from_buf(p + b, e - b);
}

# lstat a path into a caller-provided 144-byte buffer (heap or
# stack). Returns 0 on success, negative errno on failure. Used
# by long.cyr's per-entry stat collection; lstat (not stat) so
# symlinks render as `l...` with their own length rather than
# their target's metadata.
fn lstat_path(cpath, buf): i64 {
    return d_lstat(cpath, buf);
}
